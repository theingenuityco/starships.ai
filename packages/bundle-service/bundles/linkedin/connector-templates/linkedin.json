            },
            "start": {
              "type": "number",
              "default": 0,
              "description": "Starting index for pagination"
            },
            "author": {
              "type": "string",
              "description": "Author URN (person or organization, e.g., urn:li:person:12345)"
            },
            "sortBy": {
              "enum": [
                "LAST_MODIFIED",
                "CREATED"
              ],
              "type": "string",
              "default": "LAST_MODIFIED",
              "description": "Sort order"
            },
            "viewContext": {
              "enum": [
                "READER",
                "AUTHOR"
              ],
              "type": "string",
              "default": "READER",
              "description": "View context (READER for published version, AUTHOR for latest)"
            }
