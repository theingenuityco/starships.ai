{
  "name": "starships.ai",
  "private": true,
  "version": "3.14.3",
  "packageManager": "pnpm@10.12.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm run dev:proxy\" \"turbo run dev --filter='!@starships/reverse-proxy'\"",
    "dev:proxy": "pnpm --filter @starships/reverse-proxy dev",
    "dev:without-proxy": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "build": "turbo run build",
    "start": "turbo run start",
    "deploy:staging": "cd deploy && npm run deploy:staging",
    "deploy:production": "cd deploy && npm run deploy:production",
    "deploy:staging:dry-run": "cd deploy && npm run deploy:staging:dry-run",
    "deploy:production:dry-run": "cd deploy && npm run deploy:production:dry-run",
    "deployment:validate-pre": "cd deploy && npm run validate:pre",
    "deployment:validate-post": "cd deploy && npm run validate:post",
    "deployment:health-check": "cd deploy && npm run health:check",
    "deployment:load-test": "cd deploy && npm run load:test",
    "deployment:monitoring-setup": "cd deploy && npm run monitoring:setup",
    "migration:run": "cd deploy && npm run migration:run",
    "migration:rollback": "cd deploy && npm run migration:rollback",
    "migration:validate": "cd deploy && npm run migration:validate",
    "migration:test": "cd deploy && npm run migration:test",
    "backup:create": "cd deploy && npm run backup:create",
    "backup:restore": "cd deploy && npm run backup:restore",
    "backup:list": "cd deploy && npm run backup:list",
    "neo4j:install": "docker run -d --name starships-neo4j -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:latest || echo 'Container may already exist. Use neo4j:reset to recreate.'",
    "neo4j:reset": "docker stop starships-neo4j 2>/dev/null || true && docker rm starships-neo4j 2>/dev/null || true && echo 'Neo4j container cleaned up. Use neo4j:install to recreate.'",
    "neo4j:shell": "docker exec -it starships-neo4j cypher-shell -u neo4j -p starships2024! || echo 'Container not running. Use neo4j:start first.'",
    "neo4j:backup": "docker exec starships-neo4j neo4j-admin database dump --database=neo4j --to-path=/backups --verbose || echo 'Backup failed. Ensure container is running.'"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "concurrently": "^8.2.2",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.4",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/node": "^24.0.10",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.7",
    "ts-node": "^10.9.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "prismjs": ">=1.30.0",
      "form-data": ">=4.0.4",
      "@eslint/plugin-kit@<0.3.4": ">=0.3.4"
    },
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "bcrypt",
      "cpu-features",
      "esbuild",
      "protobufjs",
      "sharp",
      "ssh2",
      "unrs-resolver"
    ]
  }
}
