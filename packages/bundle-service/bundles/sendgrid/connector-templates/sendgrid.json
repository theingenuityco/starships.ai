{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "sendgrid",
    "fromSlug": "sendgrid",
    "fromId": "j31SsR0Ht4X3l0RRYlt8g"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "j31SsR0Ht4X3l0RRYlt8g",
      "slug": "sendgrid",
      "provider": "sendgrid",
      "name": "Twilio SendGrid",
      "description": "Send transactional and marketing emails via Twilio SendGrid API v3. Supports simple emails, dynamic templates, attachmen",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "connector",
      "baseUrl": "https://api.sendgrid.com",
      "auth": {
        "type": "api_key",
        "apiKeyRef": {
          "key": "SENDGRID_API_KEY",
          "type": "connector_secret"
        },
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        }
      }
    },
    "actions": [
      {
        "name": "send-simple-email",
        "description": "Send a simple email with basic fields - easiest way to send transactional emails",
        "method": "POST",
        "path": "/v3/mail/send",
        "parameters": {
          "type": "object",
          "required": [
            "fromEmail",
            "to",
            "subject",
            "body"
          ],
          "properties": {
            "cc": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              },
              "description": "CC recipients"
            },
            "to": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              },
              "maxItems": 1000,
              "minItems": 1,
              "description": "Recipient email addresses"
            },
            "bcc": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              },
              "description": "BCC recipients"
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "description": "Email body content (HTML or plain text)"
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "description": "Email subject line"
            },
            "fromName": {
              "type": "string",
              "description": "Sender display name"
            },
            "fromEmail": {
              "type": "string",
              "format": "email",
              "description": "Sender email address (must be verified in SendGrid)"
            },
            "contentType": {
              "enum": [
                "text/plain",
                "text/html"
              ],
              "type": "string",
              "default": "text/html",
              "description": "Content type of the email body"
            },
            "replyToName": {
              "type": "string",
              "description": "Reply-to display name"
            },
            "replyToEmail": {
              "type": "string",
              "format": "email",
              "description": "Reply-to email address"
            }
          }
        },
        "mapping": {
          "body": {
            "from": {
              "name": "{{ String(args.fromName || '') }}",
              "email": "{{ String(args.fromEmail) }}"
            },
            "content": [
              {
                "type": "{{ String(args.contentType || 'text/html') }}",
                "value": "{{ String(args.body) }}"
              }
            ],
            "reply_to": {
              "name": "{{ String(args.replyToName || args.fromName || '') }}",
              "email": "{{ String(args.replyToEmail || args.fromEmail) }}"
            },
            "personalizations": [
              {
                "cc": "{{ args.cc }}",
                "to": "{{ args.to }}",
                "bcc": "{{ args.bcc }}",
                "subject": "{{ String(args.subject) }}"
              }
            ]
          },
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "timeoutMs": 30000
      },
      {
        "name": "send-template-email",
        "description": "Send an email using a SendGrid dynamic template with variable substitution",
        "method": "POST",
        "path": "/v3/mail/send",
        "parameters": {
          "type": "object",
          "required": [
            "fromEmail",
            "to",
            "templateId"
          ],
          "properties": {
            "to": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              },
              "maxItems": 1000,
              "minItems": 1,
              "description": "Recipient email addresses"
            },
            "fromName": {
              "type": "string",
              "description": "Sender display name"
            },
            "fromEmail": {
              "type": "string",
              "format": "email",
              "description": "Sender email address (must be verified in SendGrid)"
            },
            "templateId": {
              "type": "string",
              "pattern": "^d-[a-f0-9]+$",
              "description": "SendGrid dynamic template ID (starts with 'd-')"
            },
            "replyToName": {
              "type": "string",
              "description": "Reply-to display name"
            },
            "replyToEmail": {
              "type": "string",
              "format": "email",
              "description": "Reply-to email address"
            },
            "templateData": {
              "type": "object",
              "description": "Dynamic template data (key-value pairs for template variables)",
              "additionalProperties": true
            }
          }
        },
        "mapping": {
          "body": {
            "from": {
              "name": "{{ String(args.fromName || '') }}",
              "email": "{{ String(args.fromEmail) }}"
            },
            "reply_to": {
              "name": "{{ String(args.replyToName || args.fromName || '') }}",
              "email": "{{ String(args.replyToEmail || args.fromEmail) }}"
            },
            "template_id": "{{ String(args.templateId) }}",
            "personalizations": [
              {
                "to": "{{ args.to }}",
                "dynamic_template_data": "{{ args.templateData || {} }}"
              }
            ]
          },
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "timeoutMs": 30000
      },
      {
        "name": "send-email-with-attachment",
        "description": "Send an email with file attachments (max 30MB total size)",
        "method": "POST",
        "path": "/v3/mail/send",
        "parameters": {
          "type": "object",
          "required": [
            "fromEmail",
            "to",
            "subject",
            "body",
            "attachments"
          ],
          "properties": {
            "to": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              },
              "maxItems": 1000,
              "minItems": 1,
              "description": "Recipient email addresses"
            },
            "body": {
              "type": "string",
              "description": "Email body content"
            },
            "subject": {
              "type": "string",
              "description": "Email subject line"
            },
            "fromName": {
              "type": "string",
              "description": "Sender display name"
            },
            "fromEmail": {
              "type": "string",
              "format": "email",
              "description": "Sender email address"
            },
            "attachments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "content",
                  "filename"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "default": "application/octet-stream",
                    "description": "MIME type (e.g., 'application/pdf')"
                  },
                  "content": {
                    "type": "string",
                    "description": "Base64 encoded file content"
                  },
                  "filename": {
                    "type": "string",
                    "description": "Filename with extension"
                  },
                  "content_id": {
                    "type": "string",
                    "description": "Content ID for inline images (use cid:content_id in HTML)"
                  },
                  "disposition": {
                    "enum": [
                      "attachment",
                      "inline"
                    ],
                    "type": "string",
                    "default": "attachment"
                  }
                }
              },
              "description": "File attachments (base64 encoded, total size must be < 30MB)"
            },
            "contentType": {
              "enum": [
                "text/plain",
                "text/html"
              ],
              "type": "string",
              "default": "text/html"
            }
          }
        },
        "mapping": {
          "body": {
            "from": {
              "name": "{{ String(args.fromName || '') }}",
              "email": "{{ String(args.fromEmail) }}"
            },
            "content": [
              {
                "type": "{{ String(args.contentType || 'text/html') }}",
                "value": "{{ String(args.body) }}"
              }
            ],
            "attachments": "{{ args.attachments }}",
            "personalizations": [
              {
                "to": "{{ args.to }}",
                "subject": "{{ String(args.subject) }}"
              }
            ]
          },
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "timeoutMs": 30000
      },
      {
        "name": "send-email",
        "description": "Send an email with full control over all SendGrid Mail Send API features",
        "method": "POST",
        "path": "/v3/mail/send",
        "parameters": {
          "type": "object",
          "required": [
            "personalizations",
            "from",
            "content"
          ],
          "properties": {
            "asm": {
              "type": "object",
              "description": "Advanced suppression manager settings"
            },
            "from": {
              "type": "object",
              "required": [
                "email"
              ],
              "description": "Sender information"
            },
            "sendAt": {
              "type": "integer",
              "description": "Unix timestamp to schedule send (max 72 hours in advance)"
            },
            "batchId": {
              "type": "string",
              "description": "Batch ID for grouping emails"
            },
            "content": {
              "type": "array",
              "minItems": 1,
              "description": "Email content parts"
            },
            "replyTo": {
              "type": "object",
              "description": "Reply-to address"
            },
            "subject": {
              "type": "string",
              "description": "Email subject (can also be set per-personalization)"
            },
            "categories": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 10,
              "description": "Categories for organizing emails (max 10)"
            },
            "ipPoolName": {
              "type": "string",
              "maxLength": 64,
              "minLength": 2,
              "description": "IP pool name for dedicated IPs"
            },
            "templateId": {
              "type": "string",
              "description": "Template ID for dynamic templates"
            },
            "attachments": {
              "type": "array",
              "description": "File attachments (base64 encoded, total < 30MB)"
            },
            "replyToList": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              },
              "maxItems": 1000,
              "description": "Multiple reply-to addresses (max 1000)"
            },
            "mailSettings": {
              "type": "object",
              "description": "Mail settings (BCC, bypass list management, footer, sandbox mode)"
            },
            "personalizations": {
              "type": "array",
              "minItems": 1,
              "description": "Personalization settings for recipients (max 1000 recipients total)"
            },
            "trackingSettings": {
              "type": "object",
              "description": "Tracking settings (click tracking, open tracking, subscription tracking, Google Analytics)"
            }
          }
        },
        "mapping": {
          "body": {
            "asm": "{{ args.asm }}",
            "from": "{{ args.from }}",
            "content": "{{ args.content }}",
            "send_at": "{{ args.sendAt }}",
            "subject": "{{ args.subject }}",
            "batch_id": "{{ args.batchId }}",
            "reply_to": "{{ args.replyTo }}",
            "categories": "{{ args.categories }}",
            "attachments": "{{ args.attachments }}",
            "template_id": "{{ args.templateId }}",
            "ip_pool_name": "{{ args.ipPoolName }}",
            "mail_settings": "{{ args.mailSettings }}",
            "reply_to_list": "{{ args.replyToList }}",
            "personalizations": "{{ args.personalizations }}",
            "tracking_settings": "{{ args.trackingSettings }}"
          },
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "timeoutMs": 30000
      }
    ]
  }
}
