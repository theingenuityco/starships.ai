{
  "name": "@starships/env",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -f tsconfig.tsbuildinfo && tsc && tsc-alias -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "test": "echo 'No tests yet' && exit 0"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "dotenv-expand": "^12.0.3"
  }
}
