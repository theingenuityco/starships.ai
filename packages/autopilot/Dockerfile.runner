FROM node:20-slim AS build
WORKDIR /app
# Bring in workspace context so pnpm can resolve properly
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./
# Also bring in root tsconfigs so package tsconfig extends can resolve during build
COPY tsconfig.json tsconfig.nodejs.json tsconfig.nextjs.json ./
RUN npm i -g pnpm && pnpm fetch
COPY ./packages/autopilot/ ./packages/autopilot/
# Install with network (no --offline) to avoid missing offline metadata
RUN pnpm -C packages/autopilot install && pnpm -C packages/autopilot build

FROM node:20-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/packages/autopilot/dist ./dist
COPY --from=build /app/packages/autopilot/node_modules ./node_modules
COPY packages/autopilot/scripts/runner-cli.js ./scripts/runner-cli.js
USER 1000:1000
ENTRYPOINT ["node", "scripts/runner-cli.js"]

