  "payload": {
    "tool": {
      "name": "Stop Cursor Agent",
      "description": "Pause a running Cursor cloud agent without deleting it. The agent can be resumed later with a followup.",
      "parameters": {
        "type": "object",
        "required": [
          "agentId"
        ],
        "properties": {
          "agentId": {
            "type": "string",
            "description": "Unique identifier for the cloud agent to stop (e.g., bc_abc123)"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "stop_agent",
            "ref": "start_to_stop",
            "from": "start"
          },
          {
            "to": "end",
            "ref": "stop_to_end",
            "from": "stop_agent"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start",
            "parameters": {}
          },
          {
            "ref": "stop_agent",
            "name": "Stop Agent",
            "type": "connector_action",
            "parameters": {
              "args": "{{ ({ id: (input.agentId || '') }) }}",
              "action": "stop-agent",
              "timeout": 15000,
              "connector": "cursor",
              "failOnNon2xx": true
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end",
            "parameters": {
              "output": "{{ ((lastOutputOf('stop_agent') || {}).body ?? lastOutputOf('stop_agent')) }}"
            }
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
