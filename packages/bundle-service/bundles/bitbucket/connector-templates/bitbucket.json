  "payload": {
    "connectorTemplate": {
      "id": "-JkQZTTr-9mr3hV4qy6jX",
      "slug": "bitbucket",
      "provider": "bitbucket",
      "name": "Bitbucket Cloud",
      "description": "Bitbucket Cloud REST API connector for managing repositories, pull requests, issues, commits, and deployments.",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "version_control",
      "baseUrl": "https://api.bitbucket.org/2.0",
      "auth": {
        "type": "oauth2",
        "scopes": [
          "repository",
          "pullrequest",
          "issue"
        ],
        "tokenUrl": "https://bitbucket.org/site/oauth2/access_token",
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        },
        "clientIdRef": {
          "key": "BITBUCKET_OAUTH_CLIENT_ID",
          "type": "platform_secret"
        },
        "tokenResponse": {
          "scopeField": "scope",
          "expiresInField": "expires_in",
          "tokenTypeField": "token_type",
          "accessTokenField": "access_token",
          "refreshTokenField": "refresh_token"
        },
        "accessTokenRef": {
          "key": "BITBUCKET_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "scopeDelimiter": " ",
        "clientSecretRef": {
          "key": "BITBUCKET_OAUTH_CLIENT_SECRET",
          "type": "platform_secret"
        },
        "refreshTokenRef": {
          "key": "BITBUCKET_REFRESH_TOKEN",
          "type": "connector_secret"
        },
        "authorizationUrl": "https://bitbucket.org/site/oauth2/authorize"
      },
      "rateLimit": {
        "burstLimit": 10,
        "requestsPerMinute": 60
      },
      "metadataSchema": {
        "type": "object",
        "required": [],
        "properties": {
