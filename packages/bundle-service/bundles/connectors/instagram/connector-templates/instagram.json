    "actions": [
      {
        "name": "get-stories",
        "description": "Get all active stories for the Instagram account. Stories expire after 24 hours.",
        "method": "GET",
        "path": "/{instagram_account_id}/stories",
        "parameters": {
          "type": "object",
          "required": [],
          "properties": {
            "fields": {
              "type": "string",
              "description": "Comma-separated list of fields to retrieve"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "path": {
            "instagram_account_id": "{{ String(metadata.user_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "me-media",
        "description": "List media for the currently authenticated Instagram user.",
        "method": "GET",
        "path": "/me/media",
        "parameters": {
          "type": "object",
          "required": [],
          "properties": {
            "after": {
              "type": "string",
              "description": "Cursor"
            },
            "limit": {
              "type": "number",
              "description": "Max items"
            },
            "fields": {
              "type": "string",
              "description": "Comma-separated fields"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "query": {
            "after": "{{ args.after ? String(args.after) : '' }}",
            "limit": "{{ String(args.limit || 25) }}",
            "fields": "{{ String(args.fields || 'id,caption,media_type,media_url,permalink,timestamp') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-me",
        "description": "Get the connected Instagram user (via Instagram Graph host).",
        "method": "GET",
        "path": "/me",
        "baseUrlOverride": "https://graph.instagram.com",
        "mapping": {
          "query": {
            "fields": "id,name"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create-media-container",
        "description": "Create a media container for photo, video, or carousel. This is step 1 of publishing - creates a container that can be published later.",
        "method": "POST",
        "path": "/{instagram_account_id}/media",
        "parameters": {
          "type": "object",
          "required": [
            "mediaType"
          ],
          "properties": {
            "caption": {
              "type": "string",
              "description": "Caption for the post (max 2200 characters)"
            },
            "children": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Array of media container IDs for carousel"
            },
            "imageUrl": {
              "type": "string",
              "description": "URL of image to publish (for IMAGE or CAROUSEL_ITEM)"
            },
            "videoUrl": {
              "type": "string",
              "description": "URL of video to publish (for VIDEO)"
            },
            "mediaType": {
              "enum": [
                "IMAGE",
                "VIDEO",
                "CAROUSEL"
              ],
              "type": "string",
              "default": "IMAGE",
              "description": "Type of media"
            },
            "locationId": {
              "type": "string",
              "description": "Location Page ID to tag"
            },
            "thumbOffset": {
              "type": "number",
              "description": "Video thumbnail offset in milliseconds (VIDEO only)"
            },
            "isCarouselItem": {
              "type": "boolean",
              "description": "Set true when creating carousel children"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "caption": "{{ String(args.caption) }}",
            "image_url": "{{ String(args.imageUrl) }}",
            "video_url": "{{ String(args.videoUrl) }}",
            "media_type": "{{ String(args.mediaType) }}"
          },
          "path": {
            "instagram_account_id": "{{ String(metadata.user_id) }}"
          }
        },
        "timeoutMs": 30000
      },
      {
        "name": "search-hashtag",
        "description": "Search for a hashtag ID by name. Returns the hashtag ID which can be used to get recent media.",
        "method": "GET",
        "path": "/ig_hashtag_search",
        "parameters": {
          "type": "object",
          "required": [
            "hashtag"
          ],
          "properties": {
            "hashtag": {
              "type": "string",
              "description": "Hashtag name to search (without # symbol)"
            },
            "user_id": {
              "type": "string",
              "description": "Optional: Instagram Business Account ID for context"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "query": {
            "q": "{{ String(args.hashtag) }}",
            "user_id": "{{ String(metadata.user_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-account-insights",
        "description": "Get insights (analytics) for the Instagram account. Supports metrics like impressions, reach, profile views, and follower demographics.",
        "method": "GET",
        "path": "/{instagram_account_id}/insights",
        "parameters": {
          "type": "object",
          "required": [],
          "properties": {
            "since": {
              "type": "string",
              "description": "Start date (Unix timestamp)"
            },
            "until": {
              "type": "string",
              "description": "End date (Unix timestamp)"
            },
            "period": {
              "enum": [
                "day",
                "week",
                "days_28",
                "lifetime"
              ],
              "type": "string",
              "default": "day",
              "description": "Time period for metrics"
            },
            "metrics": {
              "type": "string",
              "description": "Comma-separated list of metrics"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "path": {
            "instagram_account_id": "{{ String(metadata.user_id) }}"
          },
          "query": {
            "metric": "{{ String(args.metrics || 'reach,follower_count,profile_views,follower_demographics') }}",
            "period": "{{ String(args.period || 'day') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-hashtag-top-media",
        "description": "Get top/trending media objects for a specific hashtag. Returns the most engaged media tagged with the hashtag.",
        "method": "GET",
        "path": "/{hashtag_id}/top_media",
        "parameters": {
          "type": "object",
          "required": [
            "hashtagId"
          ],
          "properties": {
            "fields": {
              "type": "string",
              "default": "id,caption,media_type,media_url,permalink,timestamp,like_count,comments_count",
              "description": "Comma-separated list of fields to return"
            },
            "hashtagId": {
              "type": "string",
              "description": "Hashtag ID from search-hashtag endpoint"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "path": {
            "hashtag_id": "{{ String(args.hashtagId) }}"
          },
          "query": {
            "fields": "{{ String(args.fields || 'id,caption,media_type,media_url,permalink,timestamp,like_count,comments_count') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list-media",
