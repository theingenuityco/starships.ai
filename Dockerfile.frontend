FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies for building
RUN apk add --no-cache python3 make g++ git bash

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.12.4 --activate

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/client/package.json ./packages/client/
COPY packages/env-config/package.json ./packages/env-config/
COPY packages/protocol/package.json ./packages/protocol/

# Install dependencies
RUN pnpm install --frozen-lockfile --ignore-scripts

# Copy source code and configs
COPY packages/client ./packages/client
COPY packages/env-config ./packages/env-config
COPY packages/protocol ./packages/protocol
COPY tsconfig.json ./
COPY .env.example ./.env

# Build env-config and protocol first
RUN pnpm --filter @starships/env-config run build && \
    pnpm --filter @starships/protocol run build

# Build frontend with production optimizations
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Add dummy environment variables for build
ENV NEXT_PUBLIC_API_URL=http://localhost:4000
ENV KINDE_CLIENT_ID=placeholder
ENV KINDE_CLIENT_SECRET=placeholder
ENV KINDE_ISSUER_URL=https://placeholder.kinde.com
ENV KINDE_SITE_URL=http://localhost:3000

RUN pnpm --filter @starships/client run build

# Production stage
FROM node:20-alpine

WORKDIR /app

# Copy built application
COPY --from=builder /app/packages/client/.next ./packages/client/.next
COPY --from=builder /app/packages/client/public ./packages/client/public
COPY --from=builder /app/packages/client/package.json ./packages/client/
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/client/node_modules ./packages/client/node_modules

WORKDIR /app/packages/client

EXPOSE 3000

CMD ["npx", "next", "start"]