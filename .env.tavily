# Tavily API Configuration for POC
# Get your free API key at: https://tavily.com

# Global Tavily key (for testing)
# TAVILY_API_KEY=tvly_your_api_key_here

# Per-starship API keys (for multi-user testing)
# Replace starship-id with actual starship IDs
# TAVILY_API_KEY_starship-123=tvly_user1_key_here
# TAVILY_API_KEY_starship-456=tvly_user2_key_here