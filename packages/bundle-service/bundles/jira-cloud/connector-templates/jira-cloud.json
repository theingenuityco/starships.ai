{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "jira-cloud",
    "fromSlug": "jira-cloud",
    "fromId": "83SfwGmucYA3DudcUCrF4"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "83SfwGmucYA3DudcUCrF4",
      "slug": "jira-cloud",
      "provider": "jira-cloud",
      "name": "Jira Cloud",
      "description": "Jira Cloud connector for project management and issue tracking",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "project-management",
      "baseUrl": "https://api.atlassian.com/ex/jira/{{ String(metadata.cloudId) }}/rest/api/3",
      "auth": {
        "type": "oauth2",
        "scopes": [
          "read:jira-work",
          "write:jira-work",
          "read:jira-user"
        ],
        "tokenUrl": "https://auth.atlassian.com/oauth/token",
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        },
        "clientIdRef": {
          "key": "JIRA_OAUTH_CLIENT_ID",
          "type": "platform_secret"
        },
        "tokenResponse": {
          "scopeField": "scope",
          "expiresInField": "expires_in",
          "tokenTypeField": "token_type",
          "accessTokenField": "access_token",
          "refreshTokenField": "refresh_token"
        },
        "accessTokenRef": {
          "key": "JIRA_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "scopeDelimiter": " ",
        "clientSecretRef": {
          "key": "JIRA_OAUTH_CLIENT_SECRET",
          "type": "platform_secret"
        },
        "refreshTokenRef": {
          "key": "JIRA_REFRESH_TOKEN",
          "type": "connector_secret"
        },
        "authorizationUrl": "https://auth.atlassian.com/authorize",
        "extraAuthorizeParams": {
          "prompt": "consent",
          "audience": "api.atlassian.com"
        }
      },
      "metadataSchema": {
        "type": "object",
        "required": [],
        "properties": {
          "cloudId": {
            "type": "string",
            "description": "Jira Cloud ID (auto-populated after OAuth authentication)"
          }
        }
      }
    },
    "actions": [
      {
        "name": "update-issue",
        "description": "Update an existing issue in Jira Cloud",
        "method": "PUT",
        "path": "/issue/{{ String(args.issueKey) }}",
        "parameters": {
          "type": "object",
          "required": [
            "issueKey"
          ],
          "properties": {
            "labels": {
              "type": "string",
              "description": "Comma-separated labels (optional)"
            },
            "status": {
              "type": "string",
              "description": "The new status (optional)"
            },
            "summary": {
              "type": "string",
              "description": "The new summary (optional)"
            },
            "issueKey": {
              "type": "string",
              "description": "The key of the issue to update"
            },
            "assigneeId": {
              "type": "string",
              "description": "The account ID of the new assignee (optional)"
            },
            "priorityId": {
              "type": "string",
              "description": "The ID of the new priority (optional)"
            },
            "description": {
              "type": "string",
              "description": "The new description (optional)"
            }
          }
        },
        "mapping": {
          "body": {
            "fields": {
              "labels": "{{ args.labels ? args.labels.split(',').map(l => l.trim()) : undefined }}",
              "status": "{{ args.status ? String(args.status) : undefined }}",
              "summary": "{{ args.summary ? String(args.summary) : undefined }}",
              "assignee": "{{ args.assigneeId ? {id: String(args.assigneeId)} : undefined }}",
              "priority": "{{ args.priorityId ? {id: String(args.priorityId)} : undefined }}",
              "description": "{{ args.description ? {content: [{content: [{text: String(args.description), type: 'text'}], type: 'paragraph'}], type: 'doc', version: 1} : undefined }}"
            }
          }
        }
      },
      {
        "name": "delete-issue",
        "description": "Delete an issue from Jira Cloud",
        "method": "DELETE",
        "path": "/issue/{{ String(args.issueKey) }}",
        "parameters": {
          "type": "object",
          "required": [
            "issueKey"
          ],
          "properties": {
            "issueKey": {
              "type": "string",
              "description": "The key of the issue to delete"
            }
          }
        }
      },
      {
        "name": "get-issue-editmeta",
        "description": "Get editable fields metadata for an issue",
        "method": "GET",
        "path": "/issue/{{ String(args.issueKey) }}/editmeta",
        "parameters": {
          "type": "object",
          "required": [
            "issueKey"
          ],
          "properties": {
            "issueKey": {
              "type": "string",
              "description": "The key of the issue"
            }
          }
        }
      },
      {
        "name": "get-issue",
        "description": "Get issue",
        "method": "GET",
        "path": "/issues/{{ String(args.issueKey) }}"
      },
      {
        "name": "transition-issue",
        "description": "Transition an issue to a new status",
        "method": "POST",
        "path": "/issue/{{ String(args.issueKey) }}/transitions",
        "parameters": {
          "type": "object",
          "required": [
            "issueKey",
            "transitionId"
          ],
          "properties": {
            "fields": {
              "type": "object",
              "description": "Additional fields to update during transition (optional)"
            },
            "issueKey": {
              "type": "string",
              "description": "The key of the issue"
            },
            "transitionId": {
              "type": "string",
              "description": "The ID of the transition"
            }
          }
        },
        "mapping": {
          "body": {
            "fields": "{{ args.fields ? args.fields : {} }}",
            "transition": {
              "id": "{{ String(args.transitionId) }}"
            }
          }
        }
      },
      {
        "name": "add-comment",
        "description": "Add a comment to an issue",
        "method": "POST",
        "path": "/issue/{{ String(args.issueKey) }}/comments",
        "parameters": {
          "type": "object",
          "required": [
            "issueKey",
            "comment"
          ],
          "properties": {
            "comment": {
              "type": "string",
              "description": "The comment text"
            },
            "issueKey": {
              "type": "string",
              "description": "The key of the issue"
            }
          }
        },
        "mapping": {
          "body": {
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "{{ String(args.comment) }}",
                      "type": "text"
                    }
                  ]
                }
              ],
              "version": 1
            }
          }
        }
      },
      {
        "name": "list-projects",
        "description": "List all accessible projects",
        "method": "GET",
        "path": "/project",
        "parameters": {
          "type": "object",
          "properties": {
            "orderBy": {
              "type": "string",
              "description": "Order by key, name, or category (default: key)"
            },
            "startAt": {
              "type": "integer",
              "description": "The index of the first project to return (default: 0)"
            },
            "maxResults": {
              "type": "integer",
              "description": "The maximum number of projects to return (default: 50)"
            }
          }
        },
        "mapping": {
          "query": {
            "orderBy": "{{ args.orderBy || 'key' }}",
            "startAt": "{{ String(args.startAt || 0) }}",
            "maxResults": "{{ String(args.maxResults || 50) }}"
          }
        }
      },
      {
        "name": "get-project",
        "description": "Get details of a specific project",
        "method": "GET",
        "path": "/project/{{ String(args.projectKey) }}",
        "parameters": {
          "type": "object",
          "required": [
            "projectKey"
          ],
          "properties": {
            "projectKey": {
              "type": "string",
              "description": "The key or ID of the project"
            }
          }
        }
      },
      {
        "name": "get-accessible-resources",
        "description": "Get list of accessible Jira instances and auto-populate cloudId (OAuth 2.0 3LO)",
        "method": "GET",
        "path": "/oauth/token/accessible-resources",
        "baseUrlOverride": "https://api.atlassian.com",
        "mapping": {}
      },
      {
        "name": "create-issue",
        "description": "Create a new issue or subtask in Jira Cloud",
        "method": "POST",
        "path": "/issue",
        "parameters": {
          "type": "object",
          "required": [
            "projectId",
            "summary",
            "issueTypeId"
          ],
          "properties": {
            "labels": {
              "type": "string",
              "description": "Comma-separated labels (optional)"
            },
            "summary": {
              "type": "string",
              "description": "The summary of the issue"
            },
            "projectId": {
              "type": "string",
              "description": "The ID of the project"
            },
            "assigneeId": {
              "type": "string",
              "description": "The account ID of the assignee (optional)"
            },
            "priorityId": {
              "type": "string",
              "description": "The ID of the priority (optional)"
            },
            "description": {
              "type": "string",
              "description": "The description of the issue (optional)"
            },
            "issueTypeId": {
              "type": "string",
              "description": "The ID of the issue type"
            }
          }
        },
        "mapping": {
          "body": {
            "fields": {
              "labels": "{{ args.labels ? args.labels.split(',').map(l => l.trim()) : undefined }}",
              "project": {
                "id": "{{ String(args.projectId) }}"
              },
              "summary": "{{ String(args.summary) }}",
              "assignee": "{{ args.assigneeId ? {id: String(args.assigneeId)} : undefined }}",
              "priority": "{{ args.priorityId ? {id: String(args.priorityId)} : undefined }}",
              "issuetype": {
                "id": "{{ String(args.issueTypeId) }}"
              },
              "description": "{{ args.description ? {content: [{content: [{text: String(args.description), type: 'text'}], type: 'paragraph'}], type: 'doc', version: 1} : undefined }}"
            }
          }
        }
      },
      {
        "name": "search-issues",
        "description": "Search for issues using JQL query (enhanced search)",
        "method": "GET",
        "path": "/search/jql",
        "parameters": {
          "type": "object",
          "required": [
            "jql"
          ],
          "properties": {
            "jql": {
              "type": "string",
              "description": "The JQL query string"
            },
            "expand": {
              "type": "string",
              "description": "Comma-separated list of fields to expand (e.g., renderedFields, changelog)"
            },
            "fields": {
              "type": "string",
              "description": "Comma-separated list of fields to retrieve"
            },
            "startAt": {
              "type": "integer",
              "description": "The index of the first issue to return (0-based, default: 0)"
            },
            "validate": {
              "type": "string",
              "description": "JQL validation mode: strict, warn, or none (default: warn)"
            },
            "maxResults": {
              "type": "integer",
              "description": "The maximum number of issues to return (default: 50)"
            }
          }
        },
        "mapping": {
          "query": {
            "jql": "{{ String(args.jql) }}",
            "expand": "{{ args.expand ? String(args.expand) : undefined }}",
            "fields": "{{ args.fields ? String(args.fields) : undefined }}",
            "startAt": "{{ String(args.startAt || 0) }}",
            "validate": "{{ args.validate || 'warn' }}",
            "maxResults": "{{ String(args.maxResults || 50) }}"
          }
        }
      }
    ]
  }
}
