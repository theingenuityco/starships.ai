    "connectorTemplate": {
      "id": "68R-nDn9bHjB9VfwIrU27",
      "slug": "microsoft-365-outlook",
      "provider": "microsoft-365-outlook",
      "name": "Microsoft 365 / Outlook",
      "description": "Unified Microsoft 365 connector for email, calendar, contacts, tasks, files, and Teams",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "enterprise-productivity",
      "baseUrl": "https://graph.microsoft.com/v1.0",
