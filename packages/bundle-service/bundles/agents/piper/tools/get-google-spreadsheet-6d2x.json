  "payload": {
    "tool": {
      "name": "Get Google Spreadsheet",
      "description": "Get spreadsheet metadata including all sheets, properties, and structure using the Google Sheets API",
      "parameters": {
        "type": "object",
        "required": [
          "spreadsheetId"
        ],
        "properties": {
          "spreadsheetId": {
            "type": "string",
            "description": "The ID of the spreadsheet (found in the URL)"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "get_spreadsheet",
            "ref": "e1",
            "from": "start"
          },
          {
            "to": "format_response",
            "ref": "e2",
            "from": "get_spreadsheet"
          },
          {
            "to": "end",
            "ref": "e3",
            "from": "format_response"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start",
            "parameters": {}
          },
          {
            "ref": "get_spreadsheet",
            "name": "Get Spreadsheet",
            "type": "connector_action",
            "parameters": {
              "args": {
                "spreadsheetId": "{{ String(input.spreadsheetId) }}"
              },
              "action": "get-spreadsheet",
              "timeout": 15000,
              "connector": "google-sheets",
              "failOnNon2xx": true
            }
          },
          {
            "ref": "format_response",
            "name": "Format Response",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const resp = ctx.lastOutputOf('get_spreadsheet') || {};\n  \n  if (!resp.body) {\n    throw new Error('No response body from Google Sheets API');\n  }\n  \n  return {\n    success: true,\n    spreadsheetId: resp.body.spreadsheetId,\n    spreadsheetUrl: resp.body.spreadsheetUrl,\n    properties: resp.body.properties,\n    sheets: resp.body.sheets?.map(s => ({\n      sheetId: s.properties.sheetId,\n      title: s.properties.title,\n      index: s.properties.index,\n      gridProperties: s.properties.gridProperties\n    })) || []\n  };\n}"
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end",
            "parameters": {}
          }
        ]
      },
