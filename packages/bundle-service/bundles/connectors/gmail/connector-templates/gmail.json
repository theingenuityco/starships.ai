        "name": "list-messages",
        "description": "List messages in the user's mailbox. Supports filtering by query string, labels, and pagination. Returns message IDs and thread IDs only - use get-message for full details.",
        "method": "GET",
        "path": "/gmail/v1/users/me/messages",
        "parameters": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string",
              "description": "Query string to filter messages (e.g., 'from:user@example.com is:unread')"
            },
            "labelIds": {
              "type": "string",
              "description": "Comma-separated label IDs to filter by"
            },
            "pageToken": {
              "type": "string",
              "description": "Token to retrieve a specific page of results"
            },
            "maxResults": {
              "type": "number",
              "maximum": 500,
              "minimum": 1,
              "description": "Maximum number of messages to return (1-500, default 100)"
            },
            "includeSpamTrash": {
              "type": "boolean",
              "description": "Include messages from SPAM and TRASH folders"
            }
          }
        },
        "mapping": {
          "query": {
