# Server and Client Ports
SERVER_PORT=4000
CLIENT_PORT=3000

# URLs
PUBLIC_URL=http://localhost:${CLIENT_PORT}
CLIENT_URL=http://localhost:${CLIENT_PORT}
SERVER_URL=http://localhost:${SERVER_PORT}

# OpenAI Configuration
OPENAI_API_KEY=sk-...

# Anthropic Configuration  
ANTHROPIC_API_KEY=sk-ant-...

# LLM Provider Defaults
DEFAULT_LLM_PROVIDER=openai
DEFAULT_CHAT_MODEL=gpt-4o


# Neo4j Configuration - Works with simple docker run neo4j
# To run Neo4j: docker run -p 7474:7474 -p 7687:7687 neo4j
# Uses default neo4j/neo4j credentials (you'll be prompted to change password on first web login)
NEO4J_URI=bolt://localhost:7687  # Required
NEO4J_USERNAME=neo4j  # Required: e.g., neo4j
NEO4J_PASSWORD=password  # Required
NEO4J_DATABASE=neo4j  # Optional: e.g., neo4j

LOG_LEVEL=info

# JWT Authentication Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-32-characters-long

# Google Analytics Configuration
# Get your Measurement ID from Google Analytics dashboard
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# Stripe Configuration
# ============================================
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Will be set after creating webhook endpoint in Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs - will be populated by setup script
STRIPE_PRICE_CRUISER_MONTHLY=
STRIPE_PRICE_CRUISER_YEARLY=
STRIPE_PRICE_DRAUGHT_MONTHLY=
STRIPE_PRICE_DRAUGHT_YEARLY=