{
  "extends": "../../tsconfig.nextjs.json",
  "compilerOptions": {
    "lib": ["ES2020", "dom", "dom.iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["../client/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "src/**/*"],
