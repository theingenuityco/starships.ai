            "description": "Return template details"
          },
          {
            "ref": "lean_template",
            "name": "Lean Template",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const resp = ctx.lastOutputOf('get_template') || {};\n  const body = resp.body;\n\n  if (!body) {\n    return { success: false, error: 'NO_BODY', status: resp.status };\n  }\n\n  if (body.success !== true) {\n    // Preserve Starships error envelope (already structured)\n    return body;\n  }\n\n  const data = body.data;\n  if (data && typeof data === 'object' && data.connector) return data.connector;\n  return data ?? body;\n}\n",
              "timeout": 5000
            }
          }
        ]
      },
