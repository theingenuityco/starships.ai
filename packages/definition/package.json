{
  "name": "@starships/definition",
  "version": "1.0.0",
  "description": "Pure, DB-free codecs and authored types for the .autopilot definition plane (agents/connectors/tables/rooms/schedules)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "starships",
    "autopilot",
    "definition",
    "codec"
  ],
  "author": "Starships.ai Team",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@starships/protocol": "workspace:*",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist"
  ]
}
