  "payload": {
    "tool": {
      "name": "Remove Gmail Labels",
      "description": "Remove labels from a message. Can remove both system labels and custom user labels. Use gmail_list_labels to discover available label IDs.",
      "parameters": {
        "type": "object",
        "required": [
          "messageId",
          "labelIds"
        ],
        "properties": {
          "labelIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Array of label IDs to remove (e.g., ['INBOX', 'UNREAD'] or custom label IDs)"
          },
          "messageId": {
            "type": "string",
            "description": "The ID of the message to remove labels from"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "read_args",
            "ref": "start_to_read_args",
            "from": "start"
          },
          {
            "to": "remove_labels",
            "ref": "read_args_to_remove_labels",
            "from": "read_args"
          },
          {
            "to": "end",
            "ref": "remove_labels_to_end",
            "from": "remove_labels"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start"
          },
          {
            "ref": "read_args",
            "name": "Read Arguments",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const args = ctx.input || {};\n  return {\n    messageId: args.messageId,\n    labelIds: args.labelIds\n  };\n}"
            }
          },
          {
            "ref": "remove_labels",
            "name": "Remove Labels from Message",
            "type": "connector_action",
            "parameters": {
              "args": {
                "id": "{{ String((lastOutputOf('read_args') || {}).messageId) }}",
                "removeLabelIds": "{{ (lastOutputOf('read_args') || {}).labelIds }}"
              },
              "action": "modify-message",
              "timeout": 15000,
              "connector": "gmail"
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end"
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
  }
