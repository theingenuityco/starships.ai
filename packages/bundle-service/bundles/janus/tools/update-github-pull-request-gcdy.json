  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "tool": {
      "name": "Update GitHub Pull Request",
      "description": "Update an existing GitHub pull request using the GitHub connector. Allows updating title, body, state (open/closed), base branch, and maintainer_can_modify settings.",
      "parameters": {
        "type": "object",
        "required": [
          "owner",
          "repo",
          "pull_number"
        ],
        "properties": {
          "base": {
            "type": "string",
            "description": "The name of the branch you want the changes pulled into"
          },
          "body": {
            "type": "string",
            "description": "The contents of the pull request"
          },
          "repo": {
            "type": "string",
            "description": "The name of the repository without the .git extension. The name is not case sensitive."
          },
          "owner": {
            "type": "string",
            "description": "The account owner of the repository. The name is not case sensitive."
          },
          "state": {
            "enum": [
              "open",
              "closed"
            ],
            "type": "string",
            "description": "The state of the pull request"
          },
          "title": {
            "type": "string",
            "description": "The title of the pull request"
          },
          "pull_number": {
            "type": "number",
            "description": "The number that identifies the pull request"
          },
          "maintainer_can_modify": {
            "type": "boolean",
            "description": "Indicates whether maintainers can modify the pull request"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "update_pr",
            "ref": "start_to_update",
            "from": "start"
          },
          {
            "to": "end",
            "ref": "update_to_end",
            "from": "update_pr"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start"
          },
          {
            "ref": "update_pr",
            "name": "Update Pull Request",
            "type": "connector_action",
            "parameters": {
              "args": "{{ ctx.input }}",
              "action": "update-pull-request",
              "timeout": 15000,
              "connector": "github"
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end"
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
  }
