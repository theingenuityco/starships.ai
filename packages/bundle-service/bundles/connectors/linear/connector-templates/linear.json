            "teamId": {
              "type": "string",
              "description": "The team ID"
            }
          }
        },
        "mapping": {
          "rawBody": "{{ JSON.stringify({ query: \"query GetWorkflowStates($filter: WorkflowStateFilter) { workflowStates(filter: $filter) { nodes { id name type } } }\", variables: { filter: { teamId: args.teamId } } }) }}"
