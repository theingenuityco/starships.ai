{
  "name": "@starships/models",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -f tsconfig.tsbuildinfo && tsc --build && tsc-alias -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "seed:waitlist": "tsx src/scripts/seed-waitlist.ts",
    "backup:create": "tsx src/scripts/backup-cli.ts create",
    "backup:restore": "tsx src/scripts/backup-cli.ts restore",
    "backup:validate": "tsx src/scripts/backup-cli.ts validate",
    "backup:help": "tsx src/scripts/backup-cli.ts help",
    "test:backup": "tsx src/scripts/test-backup-restore.ts",
    "disaster:recovery": "tsx src/scripts/disaster-recovery.ts",
    "validate-schema": "tsx src/scripts/schema-validator.ts",
    "monitor": "tsx src/scripts/performance-monitor.ts",
    "db-cli": "tsx src/scripts/db-cli.ts",
    "pretest": "pnpm --filter @starships/autopilot build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@starships/autopilot": "workspace:*",
    "@starships/env": "workspace:*",
    "@starships/errors": "workspace:*",
    "@starships/protocol": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "fs-extra": "^11.3.0",
    "nanoid": "^5.1.5",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.10",
    "@types/node-fetch": "^2.6.12",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.1.0",
    "jest": "^30.1.1",
    "node-fetch": "^2.7.0",
    "ts-jest": "^29.4.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
