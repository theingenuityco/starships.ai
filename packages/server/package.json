{
  "name": "@starships/server",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "stripe:setup": "tsx scripts/setup-stripe.ts",
    "stripe:setup:dev": "NODE_ENV=development tsx scripts/setup-stripe.ts",
    "stripe:listen": "stripe listen --forward-to localhost:4000/webhooks/stripe",
    "stripe:trigger": "stripe trigger checkout.session.completed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "@langchain/core": "^0.2.0",
    "@notionhq/client": "^4.0.2",
    "@starships/autopilot": "workspace:*",
    "@starships/env": "workspace:*",
    "@starships/errors": "workspace:*",
    "@starships/models": "workspace:*",
    "@starships/protocol": "workspace:*",
    "@types/cookie-parser": "^1.4.9",
    "@types/lodash": "^4.17.20",
    "axios": "^1.7.2",
    "axios-retry": "^4.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.1.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "fast-json-patch": "^3.1.1",
    "jose": "^6.0.11",
    "jsonata": "^2.1.0",
    "lodash": "^4.17.21",
    "openai": "^5.8.4",
    "stripe": "^18.4.0",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^6.0.0",
    "@types/node": "^22.10.6",
    "@types/ws": "^8.18.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3"
  }
}
