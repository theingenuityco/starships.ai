    "actions": [
      {
        "name": "create-pin",
        "description": "Create a new Pin on Pinterest. Supports image and video pins with title, description, link, and board placement.",
        "method": "POST",
        "path": "/pins",
        "parameters": {
          "type": "object",
          "required": [
            "boardId",
            "mediaSource"
          ],
          "properties": {
            "link": {
              "type": "string",
              "description": "URL the Pin will link to when clicked"
            },
            "title": {
              "type": "string",
              "description": "Pin title (max 100 characters)"
            },
            "altText": {
              "type": "string",
              "description": "Alt text for the Pin image for accessibility"
            },
            "boardId": {
              "type": "string",
              "description": "The ID of the board to save the Pin to"
            },
            "description": {
              "type": "string",
              "description": "Pin description (max 800 characters)"
            },
            "mediaSource": {
              "type": "object",
              "description": "Media source object with source_type (image_url, image_base64, video_id) and corresponding fields"
            },
            "boardSectionId": {
              "type": "string",
              "description": "Optional board section ID to save the Pin to a specific section"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "link": "{{ String(args.link) }}",
            "title": "{{ String(args.title) }}",
            "alt_text": "{{ String(args.altText) }}",
            "board_id": "{{ String(args.boardId) }}",
            "description": "{{ String(args.description) }}",
            "media_source": "{{ args.mediaSource }}",
            "board_section_id": "{{ String(args.boardSectionId) }}"
          }
        },
        "timeoutMs": 15000
      },
