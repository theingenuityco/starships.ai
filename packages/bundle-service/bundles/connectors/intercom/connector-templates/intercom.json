{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "intercom",
    "fromSlug": "intercom",
    "fromId": "Go7F-2e9Hci1k9vM6rz0A"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "Go7F-2e9Hci1k9vM6rz0A",
      "slug": "intercom",
      "provider": "intercom",
      "name": "Intercom",
      "description": "Customer communication platform for conversations, contacts, and support management",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "connector",
      "baseUrl": "https://api.intercom.io",
      "auth": {
        "type": "oauth2",
        "scopes": [
          "conversations.read",
          "conversations.write",
          "contacts.read",
          "contacts.write",
          "teams.read"
        ],
        "tokenUrl": "https://api.intercom.io/auth/eagle/token",
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        },
        "clientIdRef": {
          "key": "INTERCOM_OAUTH_CLIENT_ID",
          "type": "platform_secret"
        },
        "tokenResponse": {
          "expiresInField": "expires_in",
          "accessTokenField": "access_token",
          "refreshTokenField": "refresh_token"
        },
        "accessTokenRef": {
          "key": "INTERCOM_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "scopeDelimiter": " ",
        "clientSecretRef": {
          "key": "INTERCOM_OAUTH_CLIENT_SECRET",
          "type": "platform_secret"
        },
        "refreshTokenRef": {
          "key": "INTERCOM_REFRESH_TOKEN",
          "type": "connector_secret"
        },
        "authorizationUrl": "https://app.intercom.com/oauth"
      },
      "rateLimit": {
        "burstLimit": 83,
        "requestsPerMinute": 4980
      },
      "metadataSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "description": "Intercom workspace identifier"
          }
        },
        "additionalProperties": false
      }
    },
    "actions": [
      {
        "name": "get_contact",
        "description": "Get a specific contact by ID or email",
        "method": "GET",
        "path": "/contacts/{id}",
        "parameters": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Contact ID or email"
            }
          }
        },
        "mapping": {
          "path": {
            "id": "{{ String(args.id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list_contacts",
        "description": "List all contacts with pagination and filtering",
        "method": "GET",
        "path": "/contacts",
        "parameters": {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer",
              "description": "Page number"
            },
            "email": {
              "type": "string",
              "description": "Filter by email"
            },
            "per_page": {
              "type": "integer",
              "default": 20,
              "description": "Number of results per page"
            },
            "external_id": {
              "type": "string",
              "description": "Filter by external ID"
            }
          }
        },
        "mapping": {
          "query": {
            "page": "{{ args.page }}",
            "email": "{{ args.email }}",
            "per_page": "{{ args.per_page || 20 }}",
            "external_id": "{{ args.external_id }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create_contact",
        "description": "Create a new contact",
        "method": "POST",
        "path": "/contacts",
        "parameters": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Contact name"
            },
            "email": {
              "type": "string",
              "description": "Contact email"
            },
            "phone": {
              "type": "string",
              "description": "Contact phone"
            },
            "external_id": {
              "type": "string",
              "description": "Your external ID for contact"
            },
            "custom_attributes": {
              "type": "object",
              "description": "Custom attributes object"
            }
          }
        },
        "mapping": {
          "body": {
            "name": "{{ String(args.name) }}",
            "email": "{{ String(args.email) }}",
            "phone": "{{ String(args.phone) }}",
            "external_id": "{{ String(args.external_id) }}",
            "custom_attributes": "{{ args.custom_attributes }}"
          },
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list_conversations",
        "description": "List all conversations with pagination support",
        "method": "GET",
        "path": "/conversations",
        "parameters": {
          "type": "object",
          "properties": {
            "per_page": {
              "type": "integer",
              "default": 20,
              "description": "Number of results per page (max 150)"
            },
            "starting_after": {
              "type": "string",
              "description": "Cursor for pagination"
            }
          }
        },
        "mapping": {
          "query": {
            "per_page": "{{ args.per_page || 20 }}",
            "starting_after": "{{ args.starting_after }}"
          },
          "headers": {
            "Intercom-Version": "2.10"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "search_contacts",
        "description": "Search contacts by criteria",
        "method": "POST",
        "path": "/contacts/search",
        "parameters": {
          "type": "object",
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "type": "object",
              "description": "Search query object"
            },
            "per_page": {
              "type": "integer",
              "default": 20,
              "description": "Results per page"
            },
            "pagination": {
              "type": "object",
              "description": "Pagination object"
            }
          }
        },
        "mapping": {
          "body": {
            "query": "{{ args.query }}",
            "per_page": "{{ args.per_page || 20 }}",
            "pagination": "{{ args.pagination }}"
          },
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list_custom_attributes",
        "description": "List all custom data attributes",
        "method": "GET",
        "path": "/data_attributes/customer",
        "parameters": {
          "type": "object",
          "properties": {
            "include_archived": {
              "type": "boolean",
              "default": false,
              "description": "Include archived attributes"
            }
          }
        },
        "mapping": {
          "query": {
            "include_archived": "{{ args.include_archived || false }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "unarchive_contact",
        "description": "Unarchive a contact",
        "method": "POST",
        "path": "/contacts/{id}/unarchive",
        "parameters": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Contact ID"
            }
          }
        },
        "mapping": {
          "path": {
            "id": "{{ String(args.id) }}"
          },
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "update_contact",
        "description": "Update an existing contact",
        "method": "PUT",
        "path": "/contacts/{id}",
        "parameters": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Contact ID or email"
            },
            "name": {
              "type": "string",
              "description": "Updated name"
            },
            "email": {
              "type": "string",
              "description": "Updated email"
            },
            "phone": {
              "type": "string",
              "description": "Updated phone"
            },
            "custom_attributes": {
              "type": "object",
              "description": "Updated custom attributes"
            }
          }
        },
        "mapping": {
          "body": {
            "name": "{{ String(args.name) }}",
            "email": "{{ String(args.email) }}",
            "phone": "{{ String(args.phone) }}",
            "custom_attributes": "{{ args.custom_attributes }}"
          },
          "path": {
            "id": "{{ String(args.id) }}"
          },
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "archive_contact",
        "description": "Archive a contact",
        "method": "POST",
        "path": "/contacts/{id}/archive",
        "parameters": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Contact ID"
            }
          }
        },
        "mapping": {
          "path": {
            "id": "{{ String(args.id) }}"
          },
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_conversation",
        "description": "Get a specific conversation by ID",
        "method": "GET",
        "path": "/conversations/{id}",
        "parameters": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Conversation ID"
            }
          }
        },
        "mapping": {
          "path": {
            "id": "{{ String(args.id) }}"
          },
          "headers": {
            "Intercom-Version": "2.10"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create_conversation",
        "description": "Create a new conversation from a contact",
        "method": "POST",
        "path": "/conversations",
        "parameters": {
          "type": "object",
          "required": [
            "from_type",
            "from_id",
            "body"
          ],
          "properties": {
            "body": {
              "type": "string",
              "description": "Message content"
            },
            "from_id": {
              "type": "string",
              "description": "Contact ID"
            },
            "from_type": {
              "enum": [
                "user",
                "lead",
                "contact"
              ],
              "type": "string",
              "description": "Contact type"
            }
          }
        },
        "mapping": {
          "body": {
            "body": "{{ String(args.body) }}",
            "from": {
              "id": "{{ String(args.from_id) }}",
              "type": "{{ String(args.from_type) }}"
            }
          },
          "headers": {
            "Content-Type": "application/json",
            "Intercom-Version": "2.10"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "add_conversation_reply",
        "description": "Add a reply to an existing conversation",
        "method": "POST",
        "path": "/conversations/{id}/reply",
        "parameters": {
          "type": "object",
          "required": [
            "id",
            "message_type",
            "body"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Conversation ID"
            },
            "body": {
              "type": "string",
              "description": "Reply content"
            },
            "message_type": {
              "enum": [
                "comment",
                "note"
              ],
              "type": "string",
              "description": "Type of reply"
            },
            "from_admin_id": {
              "type": "string",
              "description": "Admin ID (optional, for notes)"
            }
          }
        },
        "mapping": {
          "body": {
            "body": "{{ String(args.body) }}",
            "from": {
              "id": "{{ String(args.from_admin_id) }}",
              "type": "admin"
            },
            "message_type": "{{ String(args.message_type) }}"
          },
          "path": {
            "id": "{{ String(args.id) }}"
          },
          "headers": {
            "Content-Type": "application/json",
            "Intercom-Version": "2.10"
          }
        },
        "timeoutMs": 15000
      }
    ]
  }
}
