{
  "compilerOptions": {
    /* Base compilation target and module system for Node.js/libraries */
    "target": "es2015",
    "module": "commonjs",
    "lib": ["es2015"],

    /* Module resolution */
    "moduleResolution": "node10",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Type checking */
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* JSON and compatibility */
    "resolveJsonModule": true,
    "downlevelIteration": true,

    /* Output options for libraries */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,

    /* Node.js types by default */
    "types": ["node"],

    /* Path mappings for cross-package imports */
    "baseUrl": ".",
    "paths": {
      "@starships/protocol/*": ["./packages/protocol/src/*"],
      "@starships/protocol": ["./packages/protocol/src/index.ts"],
      "@starships/env/*": ["./packages/env/src/*"],
      "@starships/env": ["./packages/env/src/index.ts"],
      "@starships/models/*": ["./packages/models/src/*"],
      "@starships/models": ["./packages/models/src/index.ts"],
      "@starships/autopilot/*": ["./packages/autopilot/src/*"],
      "@starships/autopilot": ["./packages/autopilot/src/index.ts"],
      "@starships/errors/*": ["./packages/errors/src/*"],
      "@starships/errors": ["./packages/errors/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next"]
}
