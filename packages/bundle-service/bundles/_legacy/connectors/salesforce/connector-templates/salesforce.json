{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "salesforce",
    "fromSlug": "salesforce",
    "fromId": "T97LJ7AmctCqsus3RwU9h"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "T97LJ7AmctCqsus3RwU9h",
      "slug": "salesforce",
      "provider": "salesforce",
      "name": "Salesforce",
      "description": "Salesforce CRM connector for managing leads, accounts, opportunities, contacts, and other business objects via the Sales",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "crm",
      "baseUrl": "https://{instance}.salesforce.com/services/data/v60.0",
      "auth": {
        "type": "oauth2",
        "scopes": [
          "api",
          "refresh_token",
          "offline_access"
        ],
        "tokenUrl": "https://{instance}.salesforce.com/services/oauth2/token",
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        },
        "clientIdRef": {
          "key": "SALESFORCE_OAUTH_CLIENT_ID",
          "type": "platform_secret"
        },
        "tokenResponse": {
          "scopeField": "scope",
          "expiresInField": "expires_in",
          "tokenTypeField": "token_type",
          "accessTokenField": "access_token",
          "refreshTokenField": "refresh_token"
        },
        "accessTokenRef": {
          "key": "SALESFORCE_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "scopeDelimiter": " ",
        "clientSecretRef": {
          "key": "SALESFORCE_OAUTH_CLIENT_SECRET",
          "type": "platform_secret"
        },
        "refreshTokenRef": {
          "key": "SALESFORCE_REFRESH_TOKEN",
          "type": "connector_secret"
        },
        "authorizationUrl": "https://{instance}.salesforce.com/services/oauth2/authorize"
      },
      "rateLimit": {
        "burstLimit": 1000,
        "requestsPerMinute": 15000
      },
      "metadataSchema": {
        "type": "object",
        "required": [],
        "properties": {
          "instance": {
            "type": "string",
            "description": "Salesforce instance name (e.g., 'na1', 'na2', 'eu1', 'cs1'). Defaults to 'login' if not specified."
          }
        },
        "additionalProperties": false
      }
    },
    "actions": [
      {
        "name": "soql-query",
        "description": "Execute a SOQL (Salesforce Object Query Language) query",
        "method": "GET",
        "path": "/query",
        "parameters": {
          "type": "object",
          "required": [
            "q"
          ],
          "properties": {
            "q": {
              "type": "string",
              "description": "SOQL query string (e.g., 'SELECT Id, Name FROM Account WHERE Industry = \\'Technology\\')"
            }
          }
        },
        "mapping": {
          "query": {
            "q": "{{ args.q }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-accounts",
        "description": "Query and retrieve accounts from Salesforce",
        "method": "GET",
        "path": "/sobjects/Account",
        "parameters": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "number",
              "description": "Maximum number of accounts to return"
            },
            "fields": {
              "type": "string",
              "description": "Comma-separated list of fields to retrieve"
            }
          }
        },
        "mapping": {
          "query": {
            "limit": "{{ args.limit || 100 }}",
            "fields": "{{ args.fields || 'Id,Name,Industry,AnnualRevenue,Phone,Website,BillingCity,BillingState' }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create-account",
        "description": "Create a new account in Salesforce",
        "method": "POST",
        "path": "/sobjects/Account",
        "parameters": {
          "type": "object",
          "required": [
            "Name"
          ],
          "properties": {
            "Name": {
              "type": "string"
            },
            "Phone": {
              "type": "string"
            },
            "Website": {
              "type": "string"
            },
            "Industry": {
              "type": "string"
            },
            "BillingCity": {
              "type": "string"
            },
            "BillingState": {
              "type": "string"
            },
            "AnnualRevenue": {
              "type": "number"
            }
          }
        },
        "mapping": {
          "body": {
            "Name": "{{ args.Name }}",
            "Phone": "{{ args.Phone }}",
            "Website": "{{ args.Website }}",
            "Industry": "{{ args.Industry }}",
            "BillingCity": "{{ args.BillingCity }}",
            "BillingState": "{{ args.BillingState }}",
            "AnnualRevenue": "{{ args.AnnualRevenue }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create-opportunity",
        "description": "Create a new opportunity in Salesforce",
        "method": "POST",
        "path": "/sobjects/Opportunity",
        "parameters": {
          "type": "object",
          "required": [
            "Name",
            "AccountId",
            "StageName",
            "CloseDate"
          ],
          "properties": {
            "Name": {
              "type": "string"
            },
            "Amount": {
              "type": "number"
            },
            "AccountId": {
              "type": "string"
            },
            "CloseDate": {
              "type": "string",
              "format": "date"
            },
            "StageName": {
              "enum": [
                "Prospecting",
                "Qualification",
                "Needs Analysis",
                "Value Proposition",
                "Id. Decision Makers",
                "Perception Analysis",
                "Proposal/Price Quote",
                "Negotiation/Review",
                "Closed Won",
                "Closed Lost"
              ],
              "type": "string"
            },
            "Probability": {
              "type": "number",
              "maximum": 100,
              "minimum": 0
            }
          }
        },
        "mapping": {
          "body": {
            "Name": "{{ args.Name }}",
            "Amount": "{{ args.Amount }}",
            "AccountId": "{{ args.AccountId }}",
            "CloseDate": "{{ args.CloseDate }}",
            "StageName": "{{ args.StageName }}",
            "Probability": "{{ args.Probability }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-contacts",
        "description": "Query and retrieve contacts from Salesforce",
        "method": "GET",
        "path": "/sobjects/Contact",
        "parameters": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "number",
              "description": "Maximum number of contacts to return"
            },
            "fields": {
              "type": "string",
              "description": "Comma-separated list of fields to retrieve"
            }
          }
        },
        "mapping": {
          "query": {
            "limit": "{{ args.limit || 100 }}",
            "fields": "{{ args.fields || 'Id,FirstName,LastName,Email,Phone,AccountId,Title' }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create-lead",
        "description": "Create a new lead in Salesforce",
        "method": "POST",
        "path": "/sobjects/Lead",
        "parameters": {
          "type": "object",
          "required": [
            "LastName",
            "Company"
          ],
          "properties": {
            "Email": {
              "type": "string"
            },
            "Phone": {
              "type": "string"
            },
            "Status": {
              "enum": [
                "Open - Not Contacted",
                "Open - Contacted",
                "Qualified to Buy",
                "Not Qualified",
                "Closed - Converted",
                "Closed - Not Converted"
              ],
              "type": "string"
            },
            "Company": {
              "type": "string"
            },
            "LastName": {
              "type": "string"
            },
            "FirstName": {
              "type": "string"
            },
            "LeadSource": {
              "type": "string"
            }
          }
        },
        "mapping": {
          "body": {
            "Email": "{{ args.Email }}",
            "Phone": "{{ args.Phone }}",
            "Status": "{{ args.Status }}",
            "Company": "{{ args.Company }}",
            "LastName": "{{ args.LastName }}",
            "FirstName": "{{ args.FirstName }}",
            "LeadSource": "{{ args.LeadSource }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create-contact",
        "description": "Create a new contact in Salesforce",
        "method": "POST",
        "path": "/sobjects/Contact",
        "parameters": {
          "type": "object",
          "required": [
            "LastName",
            "AccountId"
          ],
          "properties": {
            "Email": {
              "type": "string"
            },
            "Phone": {
              "type": "string"
            },
            "Title": {
              "type": "string"
            },
            "LastName": {
              "type": "string"
            },
            "AccountId": {
              "type": "string"
            },
            "FirstName": {
              "type": "string"
            },
            "Department": {
              "type": "string"
            }
          }
        },
        "mapping": {
          "body": {
            "Email": "{{ args.Email }}",
            "Phone": "{{ args.Phone }}",
            "Title": "{{ args.Title }}",
            "LastName": "{{ args.LastName }}",
            "AccountId": "{{ args.AccountId }}",
            "FirstName": "{{ args.FirstName }}",
            "Department": "{{ args.Department }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-leads",
        "description": "Query and retrieve leads from Salesforce",
        "method": "GET",
        "path": "/sobjects/Lead",
        "parameters": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "number",
              "description": "Maximum number of leads to return (default: 100, max: 10000)"
            },
            "fields": {
              "type": "string",
              "description": "Comma-separated list of fields to retrieve"
            }
          }
        },
        "mapping": {
          "query": {
            "limit": "{{ args.limit || 100 }}",
            "fields": "{{ args.fields || 'Id,FirstName,LastName,Email,Phone,Company,Status' }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "update-lead",
        "description": "Update an existing lead in Salesforce",
        "method": "PATCH",
        "path": "/sobjects/Lead/{id}",
        "parameters": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Lead ID"
            },
            "Email": {
              "type": "string"
            },
            "Phone": {
              "type": "string"
            },
            "Status": {
              "type": "string"
            },
            "LastName": {
              "type": "string"
            },
            "FirstName": {
              "type": "string"
            },
            "LeadSource": {
              "type": "string"
            }
          }
        },
        "mapping": {
          "body": {
            "Email": "{{ args.Email }}",
            "Phone": "{{ args.Phone }}",
            "Status": "{{ args.Status }}",
            "LastName": "{{ args.LastName }}",
            "FirstName": "{{ args.FirstName }}",
            "LeadSource": "{{ args.LeadSource }}"
          },
          "path": {
            "id": "{{ args.id }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-opportunities",
        "description": "Query and retrieve opportunities from Salesforce",
        "method": "GET",
        "path": "/sobjects/Opportunity",
        "parameters": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "number",
              "description": "Maximum number of opportunities to return"
            },
            "fields": {
              "type": "string",
              "description": "Comma-separated list of fields to retrieve"
            }
          }
        },
        "mapping": {
          "query": {
            "limit": "{{ args.limit || 100 }}",
            "fields": "{{ args.fields || 'Id,Name,StageName,Amount,Probability,CloseDate,AccountId' }}"
          }
        },
        "timeoutMs": 15000
      }
    ]
  }
}
