# Copy this file to .env and fill values
DISCORD_BOT_TOKEN=
OPEN_WEBUI_BASE_URL=
PORT=4000

# --- Deployment ----
# Bearer token that GitHub Actions will send with /redeploy webhook
REDEPLOY_SECRET=changeme

# OpenAI Configuration
OPENAI_API_KEY=sk-...

# Anthropic Configuration  
ANTHROPIC_API_KEY=sk-ant-...

# LLM Provider Defaults
DEFAULT_LLM_PROVIDER=openai
DEFAULT_CHAT_MODEL=gpt-4
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# FAISS Vector Store
FAISS_INDEX_PATH=./data/faiss_index

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

LOG_LEVEL=info

# Kinde Authentication Configuration (used by both server and client)
# Get these values from your Kinde dashboard: https://app.kinde.com
KINDE_CLIENT_ID=your_kinde_client_id
KINDE_CLIENT_SECRET=your_kinde_client_secret
KINDE_ISSUER_URL=https://your_subdomain.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_DEBUG_MODE=true

# Auth Testing Backdoor (for testing without OAuth setup)
# WARNING: Only enable for testing purposes, never in production!
ENABLE_AUTH_TESTING_BACKDOOR=false

# Client-specific Environment Variables
NEXT_PUBLIC_API_URL=

# MCP Configuration
MCP_SERVER_PORT=3002
MCP_CONTAINER_REGISTRY=docker.io
MCP_DEFAULT_MEMORY_LIMIT=512m
MCP_DEFAULT_CPU_LIMIT=0.5
MCP_DEFAULT_TIMEOUT=30000
MCP_DOCKER_SOCKET=/var/run/docker.sock
MCP_NETWORK_MODE=none
MCP_LOG_LEVEL=info
MCP_ENCRYPTION_KEY=your-encryption-key-here

# MCP Security Settings
MCP_MAX_MEMORY_LIMIT=2g
MCP_MAX_CPU_LIMIT=2.0
MCP_MAX_TIMEOUT=300000
MCP_MAX_TOOLS_PER_AGENT=50
MCP_MAX_CONTAINERS_PER_USER=1
MCP_CONTAINER_CLEANUP_INTERVAL=3600000
MCP_AUDIT_LOG_LEVEL=info
MCP_RATE_LIMIT_WINDOW=900000
MCP_RATE_LIMIT_MAX_REQUESTS=100
MCP_TOOL_EXECUTION_RATE_LIMIT=20

NEXT_PUBLIC_ENABLE_AUTH_TESTING_BACKDOOR=false
