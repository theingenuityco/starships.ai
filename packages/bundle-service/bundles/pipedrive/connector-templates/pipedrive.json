        "method": "POST",
        "path": "/deals",
        "parameters": {
          "type": "object",
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "description": "The title of the deal"
            },
            "value": {
              "type": "number",
              "description": "The value of the deal"
            },
            "org_id": {
              "type": "integer",
              "description": "The ID of the associated organization"
            },
            "currency": {
              "type": "string",
              "description": "The currency (e.g., USD, EUR)"
            },
            "owner_id": {
              "type": "integer",
              "description": "The ID of the deal owner"
            },
            "stage_id": {
              "type": "integer",
              "description": "The ID of the stage"
            },
            "person_id": {
              "type": "integer",
              "description": "The ID of the associated person"
            },
            "pipeline_id": {
              "type": "integer",
              "description": "The ID of the pipeline"
            }
          }
