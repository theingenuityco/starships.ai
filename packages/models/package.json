{
  "name": "@starships/models",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts --config ../../.eslintrc.cjs",
    "migrate": "tsx src/scripts/migration-runner.ts",
    "seed:waitlist": "tsx src/scripts/seed-waitlist.ts",
    "backup:create": "tsx src/scripts/backup-cli.ts create",
    "backup:restore": "tsx src/scripts/backup-cli.ts restore",
    "backup:validate": "tsx src/scripts/backup-cli.ts validate",
    "backup:help": "tsx src/scripts/backup-cli.ts help",
    "test:backup": "tsx src/scripts/test-backup-restore.ts",
    "disaster:recovery": "tsx src/scripts/disaster-recovery.ts",
    "cleanup:abandoned-starships": "tsx src/scripts/cleanup-abandoned-starships.ts",
    "cleanup:abandoned-starships:dry": "tsx src/scripts/cleanup-abandoned-starships.ts --dry-run",
    "validate-schema": "tsx src/scripts/schema-validator.ts",
    "monitor": "tsx src/scripts/performance-monitor.ts",
    "db-cli": "tsx src/scripts/db-cli.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@starships/autopilot": "workspace:*",
    "@starships/protocol": "workspace:*",
    "fs-extra": "^11.3.0",
    "neo4j-driver": "^5.28.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.10",
    "@types/node-fetch": "^2.6.12",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.1.0",
    "jest": "^30.1.1",
    "node-fetch": "^2.7.0",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
