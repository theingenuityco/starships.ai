  "payload": {
    "tool": {
      "name": "List GitHub Repositories",
      "description": "List repositories for the authenticated GitHub user with support for pagination, sorting, filtering by type, visibility, and affiliation",
      "parameters": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "minimum": 1,
            "description": "The page number of the results to fetch"
          },
          "sort": {
            "enum": [
              "created",
              "updated",
              "pushed",
              "full_name"
            ],
            "type": "string",
            "description": "The property to sort the results by"
          },
          "type": {
            "enum": [
              "all",
              "owner",
              "public",
              "private",
              "member"
            ],
            "type": "string",
            "description": "Limit results to repositories of the specified type"
          },
          "per_page": {
            "type": "number",
            "maximum": 100,
            "minimum": 1,
            "description": "The number of results per page (max 100)"
          },
          "direction": {
            "enum": [
              "asc",
              "desc"
            ],
            "type": "string",
            "description": "The order to sort by"
          },
          "visibility": {
            "enum": [
              "all",
              "public",
              "private"
            ],
            "type": "string",
            "description": "Limit results to repositories with the specified visibility"
          },
          "affiliation": {
            "type": "string",
            "description": "Comma-separated list of values. Can include: owner, collaborator, organization_member"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "filter_args",
            "ref": "start_to_filter",
            "from": "start"
          },
          {
            "to": "list_repos",
            "ref": "filter_to_list",
            "from": "filter_args"
          },
          {
            "to": "end",
            "ref": "list_to_end",
            "from": "list_repos"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start"
          },
          {
            "ref": "filter_args",
            "name": "Filter Args",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const input = ctx.input || {};\n  const filtered = {};\n  if (input.page) filtered.page = input.page;\n  if (input.sort) filtered.sort = input.sort;\n  if (input.type) filtered.type = input.type;\n  if (input.per_page) filtered.per_page = input.per_page;\n  if (input.direction) filtered.direction = input.direction;\n  if (input.visibility) filtered.visibility = input.visibility;\n  if (input.affiliation) filtered.affiliation = input.affiliation;\n  return filtered;\n}"
            }
          },
          {
            "ref": "list_repos",
            "name": "List User Repositories",
            "type": "connector_action",
            "parameters": {
              "args": "{{ ctx.lastOutputOf('filter_args') }}",
              "action": "list-user-repos",
              "timeout": 15000,
              "connector": "github"
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end"
          }
        ]
      },
      "transforms": null,
      "mutations": null,
