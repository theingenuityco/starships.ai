{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "shopify",
    "fromSlug": "shopify",
    "fromId": "VCPkmVF9eA-CHJlI1i8AX"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "VCPkmVF9eA-CHJlI1i8AX",
      "slug": "shopify",
      "provider": "shopify",
      "name": "Shopify",
      "description": "Connect a Shopify store to enable tools that manage products, orders, customers, and inventory via the Shopify Admin API",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "connector",
      "baseUrl": "https://{{metadata.shop}}/admin/api/2025-10",
      "auth": {
        "type": "oauth2",
        "launch": {
          "type": "hmac_sha256_hex",
          "secretRef": {
            "key": "SHOPIFY_CLIENT_SECRET",
            "type": "platform_secret"
          },
          "requiredKeys": [
            "shop",
            "host",
            "timestamp",
            "hmac"
          ],
          "maxAgeSeconds": 300
        },
        "scopes": [
          "read_products",
          "write_products",
          "read_orders",
          "write_orders",
          "read_customers",
          "write_customers",
          "read_inventory",
          "write_inventory",
          "read_content",
          "write_content"
        ],
        "tokenUrl": "https://{{shop}}/admin/oauth/access_token",
        "injection": {
          "style": "header",
          "headerName": "X-Shopify-Access-Token",
          "tokenPrefix": ""
        },
        "clientIdRef": {
          "key": "SHOPIFY_CLIENT_ID",
          "type": "platform_secret"
        },
        "accessTokenRef": {
          "key": "SHOPIFY_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "scopeDelimiter": ",",
        "clientSecretRef": {
          "key": "SHOPIFY_CLIENT_SECRET",
          "type": "platform_secret"
        },
        "refreshTokenRef": {
          "key": "SHOPIFY_REFRESH_TOKEN",
          "type": "connector_secret"
        },
        "authorizationUrl": "https://{{shop}}/admin/oauth/authorize"
      },
      "variables": [],
      "rateLimit": {
        "burstLimit": 40,
        "requestsPerSecond": 2
      },
      "metadataSchema": {
        "type": "object",
        "required": [
          "shop"
        ],
        "properties": {
          "shop": {
            "type": "string",
            "pattern": "^([a-zA-Z0-9][a-zA-Z0-9-]*\\.myshopify\\.com|[a-zA-Z0-9][a-zA-Z0-9-]*)$",
            "description": "Your Shopify store URL (e.g., 'my-store.myshopify.com')"
          }
        }
      }
    },
    "actions": [
      {
        "name": "list_products",
        "description": "List all products in the store",
        "method": "GET",
        "path": "/products.json",
        "mapping": {
          "query": {
            "limit": "{{args.limit}}",
            "status": "{{args.status}}",
            "since_id": "{{args.since_id}}"
          }
        }
      },
      {
        "name": "get_product",
        "description": "Get a single product by ID",
        "method": "GET",
        "path": "/products/{id}.json",
        "mapping": {
          "path": {
            "id": "{{args.id}}"
          }
        }
      },
      {
        "name": "create_product",
        "description": "Create a new product",
        "method": "POST",
        "path": "/products.json",
        "mapping": {
          "body": {
            "product": "{{args.product}}"
          }
        }
      },
      {
        "name": "update_product",
        "description": "Update an existing product",
        "method": "PUT",
        "path": "/products/{id}.json",
        "mapping": {
          "body": {
            "product": "{{args.product}}"
          },
          "path": {
            "id": "{{args.id}}"
          }
        }
      },
      {
        "name": "delete_product",
        "description": "Delete a product",
        "method": "DELETE",
        "path": "/products/{id}.json",
        "mapping": {
          "path": {
            "id": "{{args.id}}"
          }
        }
      },
      {
        "name": "list_orders",
        "description": "List all orders",
        "method": "GET",
        "path": "/orders.json",
        "mapping": {
          "query": {
            "limit": "{{args.limit}}",
            "status": "{{args.status}}",
            "financial_status": "{{args.financial_status}}"
          }
        }
      },
      {
        "name": "get_order",
        "description": "Get a single order by ID",
        "method": "GET",
        "path": "/orders/{id}.json",
        "mapping": {
          "path": {
            "id": "{{args.id}}"
          }
        }
      },
      {
        "name": "list_customers",
        "description": "List all customers",
        "method": "GET",
        "path": "/customers.json",
        "mapping": {
          "query": {
            "limit": "{{args.limit}}",
            "since_id": "{{args.since_id}}"
          }
        }
      },
      {
        "name": "get_customer",
        "description": "Get a single customer by ID",
        "method": "GET",
        "path": "/customers/{id}.json",
        "mapping": {
          "path": {
            "id": "{{args.id}}"
          }
        }
      },
      {
        "name": "create_customer",
        "description": "Create a new customer",
        "method": "POST",
        "path": "/customers.json",
        "mapping": {
          "body": {
            "customer": "{{args.customer}}"
          }
        }
      },
      {
        "name": "get_inventory_levels",
        "description": "Get inventory levels for a location",
        "method": "GET",
        "path": "/inventory_levels.json",
        "mapping": {
          "query": {
            "location_ids": "{{args.location_ids}}",
            "inventory_item_ids": "{{args.inventory_item_ids}}"
          }
        }
      },
      {
        "name": "list_pages",
        "description": "List all pages in the online store",
        "method": "GET",
        "path": "/pages.json",
        "mapping": {
          "query": {
            "limit": "{{args.limit}}",
            "title": "{{args.title}}",
            "since_id": "{{args.since_id}}",
            "created_at_max": "{{args.created_at_max}}",
            "created_at_min": "{{args.created_at_min}}",
            "updated_at_max": "{{args.updated_at_max}}",
            "updated_at_min": "{{args.updated_at_min}}",
            "published_status": "{{args.published_status}}"
          }
        }
      },
      {
        "name": "get_page",
        "description": "Get a single page by ID",
        "method": "GET",
        "path": "/pages/{id}.json",
        "mapping": {
          "path": {
            "id": "{{args.id}}"
          }
        }
      },
      {
        "name": "create_page",
        "description": "Create a new page in the online store",
        "method": "POST",
        "path": "/pages.json",
        "mapping": {
          "body": {
            "page": "{{args.page}}"
          }
        }
      },
      {
        "name": "update_page",
        "description": "Update an existing page",
        "method": "PUT",
        "path": "/pages/{id}.json",
        "mapping": {
          "body": {
            "page": "{{args.page}}"
          },
          "path": {
            "id": "{{args.id}}"
          }
        }
      },
      {
        "name": "delete_page",
        "description": "Delete a page from the online store",
        "method": "DELETE",
        "path": "/pages/{id}.json",
        "mapping": {
          "path": {
            "id": "{{args.id}}"
          }
        }
      },
      {
        "name": "get_shop_info",
        "description": "Get shop configuration and general information including name, currency, timezone, and other store settings",
        "method": "GET",
        "path": "/shop.json",
        "parameters": {
          "type": "object",
          "required": [],
          "properties": {}
        },
        "response": {
          "select": "{{ body.shop }}"
        }
      },
      {
        "name": "list_product_images",
        "description": "List all images for a product",
        "method": "GET",
        "path": "/products/{product_id}/images.json",
        "mapping": {
          "path": {
            "product_id": "{{args.product_id}}"
          }
        }
      },
      {
        "name": "get_product_image",
        "description": "Get a single product image by ID",
        "method": "GET",
        "path": "/products/{product_id}/images/{image_id}.json",
        "mapping": {
          "path": {
            "image_id": "{{args.image_id}}",
            "product_id": "{{args.product_id}}"
          }
        }
      },
      {
        "name": "create_product_image",
        "description": "Upload a new image to a product. Supports both URL-based images and base64-encoded data.",
        "method": "POST",
        "path": "/products/{product_id}/images.json",
        "mapping": {
          "body": {
            "image": "{{args.image}}"
          },
          "path": {
            "product_id": "{{args.product_id}}"
          }
        }
      },
      {
        "name": "update_product_image",
        "description": "Update an existing product image (alt text, position, etc.)",
        "method": "PUT",
        "path": "/products/{product_id}/images/{image_id}.json",
        "mapping": {
          "body": {
            "image": "{{args.image}}"
          },
          "path": {
            "image_id": "{{args.image_id}}",
            "product_id": "{{args.product_id}}"
          }
        }
      },
      {
        "name": "delete_product_image",
        "description": "Delete an image from a product",
        "method": "DELETE",
        "path": "/products/{product_id}/images/{image_id}.json",
        "mapping": {
          "path": {
            "image_id": "{{args.image_id}}",
            "product_id": "{{args.product_id}}"
          }
        }
      }
    ]
  }
}
