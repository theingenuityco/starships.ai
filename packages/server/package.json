    "express-rate-limit": "^7.5.1",
    "fast-json-patch": "^3.1.1",
    "googleapis": "^161.0.0",
    "jose": "^6.0.11",
    "lodash": "^4.17.21",
    "multer": "^2.0.2",
    "openai": "^5.8.4",
    "partial-json": "^0.1.7",
    "partial-json-parser": "^1.2.2",
