{
  "name": "@starships/server",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest --runInBand --coverage",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:unit": "jest --testPathIgnorePatterns=integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts --config ../../.eslintrc.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "@langchain/core": "^0.3.66",
    "@langchain/langgraph": "^0.3.11",
    "@starships/agent-engine": "workspace:*",
    "@starships/core": "workspace:*",
    "@starships/env-config": "workspace:*",
    "@starships/models": "workspace:*",
    "@starships/protocol": "workspace:*",
    "@types/socket.io": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.1.0",
    "express": "^5.1.0",
    "jose": "^6.0.11",
    "openai": "^5.8.4",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@testcontainers/neo4j": "^11.2.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.6",
    "@types/socket.io-client": "^3.0.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "jest": "^30.0.4",
    "jest-environment-node": "^30.0.4",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.3",
    "testcontainers": "^11.2.1",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.3"
  }
}