{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "NODE_ENV",
    "NODE_OPTIONS",
    "POSTGRES_HOST",
    "POSTGRES_PORT",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DATABASE",
    "POSTGRES_SSL",
    "STRIPE_SECRET_KEY",
    "STRIPE_PUBLISHABLE_KEY",
    "AUTOPILOT_ISOLATE_MEM_MB",
    "AUTOPILOT_ISOLATE_TIMEOUT_MS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "@starships/autopilot#build": {
      "inputs": ["$TURBO_DEFAULT$", "scripts/**", ".env", ".env.local"],
      "outputs": ["dist/**"]
    },
    "@starships/protocol#build": {
      "dependsOn": ["@starships/autopilot#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**"]
    },
    "@starships/errors#build": {
      "dependsOn": ["@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**"]
    },
    "@starships/models#build": {
      "dependsOn": ["@starships/env#build", "@starships/errors#build", "@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**"]
    },
    "@starships/server#build": {
      "dependsOn": ["@starships/errors#build", "@starships/models#build", "@starships/protocol#build", "@starships/autopilot#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**"]
    },
    "@starships/env#build": {
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**"]
    },
    "@starships/reverse-proxy#build": {
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@starships/reverse-proxy#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc.*", "eslint.config.*"],
      "outputs": []
    },
    "@starships/client#lint": {
      "dependsOn": ["@starships/autopilot#build", "@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc.*", "eslint.config.*"],
      "outputs": []
    },
    "@starships/server#lint": {
      "dependsOn": ["@starships/errors#build", "@starships/models#build", "@starships/protocol#build", "@starships/autopilot#build"],
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc.*", "eslint.config.*"],
      "outputs": []
    },
    "@starships/errors#lint": {
      "dependsOn": ["@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc.*", "eslint.config.*"],
      "outputs": []
    },
    "@starships/models#lint": {
      "dependsOn": ["@starships/env#build", "@starships/errors#build", "@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc.*", "eslint.config.*"],
      "outputs": []
    },
    "@starships/protocol#type-check": {
      "dependsOn": ["@starships/autopilot#build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "../../packages/autopilot/dist/**"],
      "outputs": []
    },
    "@starships/models#type-check": {
      "dependsOn": ["@starships/env#build", "@starships/errors#build", "@starships/protocol#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "../../packages/env/dist/**",
        "../../packages/errors/dist/**",
        "../../packages/protocol/dist/**"
      ],
      "outputs": []
    },
    "@starships/server#type-check": {
      "dependsOn": ["@starships/errors#build", "@starships/models#build", "@starships/protocol#build", "@starships/autopilot#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "../../packages/errors/dist/**",
        "../../packages/models/dist/**",
        "../../packages/protocol/dist/**",
        "../../packages/autopilot/dist/**"
      ],
      "outputs": []
    },
    "@starships/client#type-check": {
      "dependsOn": ["@starships/autopilot#build", "@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "../../packages/autopilot/dist/**", "../../packages/protocol/dist/**"],
      "outputs": []
    },
    "@starships/errors#type-check": {
      "dependsOn": ["@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "../../packages/protocol/dist/**"],
      "outputs": []
    },
    "@starships/reverse-proxy#type-check": {
      "dependsOn": ["@starships/env#build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "../../packages/env/dist/**"],
      "outputs": []
    },
    "type-check": {
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "@starships/models#test": {
      "dependsOn": ["@starships/env#build", "@starships/autopilot#build", "@starships/errors#build", "@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "**/*.test.*", "**/__tests__/**"],
      "outputs": []
    },
    "@starships/errors#test": {
      "dependsOn": ["@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "**/*.test.*", "**/__tests__/**"],
      "outputs": []
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "**/*.test.*", "**/__tests__/**"],
      "outputs": []
    },
    "clean": {
      "cache": false,
      "outputs": []
    }
  }
}
