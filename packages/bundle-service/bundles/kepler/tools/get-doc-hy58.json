  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "tool": {
      "name": "Get Doc",
      "description": "Fetch the raw markdown content for a Starships documentation page by slug (nested slugs supported, no extension). Returns { slug, title, content }.",
      "parameters": {
        "type": "object",
        "required": [
          "slug"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "description": "Documentation slug to fetch (no .md/.mdx extension)"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "validate",
            "ref": "e1",
            "from": "start_1"
          },
          {
            "to": "http_get_doc",
            "ref": "e2",
            "from": "validate"
          },
          {
            "to": "extract",
            "ref": "e3",
            "from": "http_get_doc"
          },
          {
            "to": "end_1",
            "ref": "e4",
            "from": "extract"
          }
        ],
        "nodes": [
          {
            "ref": "start_1",
            "name": "Start",
            "type": "start",
            "parameters": {},
            "description": ""
          },
          {
            "ref": "validate",
            "name": "Validate Input",
            "type": "code",
            "parameters": {
              "code": "\n            async function main(ctx) {\n              const input = ctx.input || {};\n              const slug = typeof input.slug === 'string' ? input.slug.trim() : '';\n              if (!slug) throw new Error('slug is required');\n              return { slug };\n            }\n          ",
              "timeout": 2000
            },
            "description": "Ensure slug is provided and correctly typed"
          },
          {
            "ref": "http_get_doc",
            "name": "Get Doc (Starships)",
            "type": "connector_action",
            "parameters": {
              "args": {
                "slug": "{{ (lastOutputOf(\"validate\") || {}).slug }}"
              },
              "action": "get-doc",
              "timeout": 5000,
              "connector": "starships",
              "failOnNon2xx": true
            },
            "description": "Fetch documentation page via Starships docs HTTP API"
          },
          {
            "ref": "extract",
            "name": "Extract Payload",
            "type": "code",
            "parameters": {
              "code": "\n            async function main(ctx) {\n              const raw = ctx.input;\n              const hasBody = raw && typeof raw === 'object' && Object.prototype.hasOwnProperty.call(raw, 'body');\n              const payload = hasBody ? raw.body : raw;\n              if (payload && typeof payload === 'object' && Object.prototype.hasOwnProperty.call(payload, 'data')) {\n                return payload.data;\n              }\n              return payload;\n            }\n          ",
              "timeout": 2000
            },
            "description": "Return the connector payload"
          },
          {
            "ref": "end_1",
            "name": "End",
            "type": "end",
            "parameters": {
              "output": "{{ lastOutputOf(\"extract\") }}"
            },
            "description": ""
          }
        ],
        "metadata": {}
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
  }
