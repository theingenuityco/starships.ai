{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "wordpress",
    "fromSlug": "wordpress",
    "fromId": "nCehYyplF3IugpxGMo83O"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "nCehYyplF3IugpxGMo83O",
      "slug": "wordpress",
      "provider": "wordpress",
      "name": "WordPress",
      "description": "Connect a WordPress.com site or Jetpack-connected WordPress site to create, read, update, and manage posts, pages, media",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "connector",
      "baseUrl": "https://public-api.wordpress.com/rest/v1.1",
      "auth": {
        "type": "oauth2",
        "scopes": [
          "global"
        ],
        "tokenUrl": "https://public-api.wordpress.com/oauth2/token",
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        },
        "clientIdRef": {
          "key": "WORDPRESS_CLIENT_ID",
          "type": "platform_secret"
        },
        "accessTokenRef": {
          "key": "WORDPRESS_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "scopeDelimiter": ",",
        "clientSecretRef": {
          "key": "WORDPRESS_CLIENT_SECRET",
          "type": "platform_secret"
        },
        "refreshTokenRef": {
          "key": "WORDPRESS_REFRESH_TOKEN",
          "type": "connector_secret"
        },
        "authorizationUrl": "https://public-api.wordpress.com/oauth2/authorize"
      }
    },
    "actions": [
      {
        "name": "list-sites",
        "description": "List all sites the authenticated user has access to",
        "method": "GET",
        "path": "/me/sites"
      },
      {
        "name": "get-site",
        "description": "Get information about a specific site",
        "method": "GET",
        "path": "/sites/{siteId}",
        "mapping": {
          "path": {
            "siteId": "{{args.siteId}}"
          }
        }
      },
      {
        "name": "list-posts",
        "description": "List posts from a WordPress site",
        "method": "GET",
        "path": "/sites/{siteId}/posts",
        "mapping": {
          "path": {
            "siteId": "{{args.siteId}}"
          },
          "query": {
            "page": "{{args.page}}",
            "order": "{{args.order}}",
            "number": "{{args.number}}",
            "offset": "{{args.offset}}",
            "search": "{{args.search}}",
            "status": "{{args.status}}",
            "order_by": "{{args.orderBy}}"
          }
        }
      },
      {
        "name": "get-post",
        "description": "Get a single post by ID",
        "method": "GET",
        "path": "/sites/{siteId}/posts/{postId}",
        "mapping": {
          "path": {
            "postId": "{{args.postId}}",
            "siteId": "{{args.siteId}}"
          }
        }
      },
      {
        "name": "create-post",
        "description": "Create a new WordPress post",
        "method": "POST",
        "path": "/sites/{siteId}/posts/new",
        "mapping": {
          "body": {
            "date": "{{args.date}}",
            "tags": "{{args.tags}}",
            "title": "{{args.title}}",
            "author": "{{args.author}}",
            "format": "{{args.format}}",
            "status": "{{args.status}}",
            "content": "{{args.content}}",
            "excerpt": "{{args.excerpt}}",
            "categories": "{{args.categories}}",
            "featured_image": "{{args.featuredImage}}"
          },
          "path": {
            "siteId": "{{args.siteId}}"
          }
        }
      },
      {
        "name": "update-post",
        "description": "Update an existing post",
        "method": "POST",
        "path": "/sites/{siteId}/posts/{postId}",
        "mapping": {
          "body": {
            "tags": "{{args.tags}}",
            "title": "{{args.title}}",
            "status": "{{args.status}}",
            "content": "{{args.content}}",
            "excerpt": "{{args.excerpt}}",
            "categories": "{{args.categories}}"
          },
          "path": {
            "postId": "{{args.postId}}",
            "siteId": "{{args.siteId}}"
          }
        }
      },
      {
        "name": "delete-post",
        "description": "Delete a post",
        "method": "POST",
        "path": "/sites/{siteId}/posts/{postId}/delete",
        "mapping": {
          "path": {
            "postId": "{{args.postId}}",
            "siteId": "{{args.siteId}}"
          }
        }
      },
      {
        "name": "list-pages",
        "description": "List pages from a WordPress site",
        "method": "GET",
        "path": "/sites/{siteId}/posts",
        "mapping": {
          "path": {
            "siteId": "{{args.siteId}}"
          },
          "query": {
            "type": "page",
            "number": "{{args.number}}",
            "status": "{{args.status}}"
          }
        }
      },
      {
        "name": "create-page",
        "description": "Create a new WordPress page",
        "method": "POST",
        "path": "/sites/{siteId}/posts/new",
        "mapping": {
          "body": {
            "type": "page",
            "title": "{{args.title}}",
            "parent": "{{args.parent}}",
            "status": "{{args.status}}",
            "content": "{{args.content}}"
          },
          "path": {
            "siteId": "{{args.siteId}}"
          }
        }
      },
      {
        "name": "list-categories",
        "description": "List all categories for a site",
        "method": "GET",
        "path": "/sites/{siteId}/categories",
        "mapping": {
          "path": {
            "siteId": "{{args.siteId}}"
          }
        }
      },
      {
        "name": "list-tags",
        "description": "List all tags for a site",
        "method": "GET",
        "path": "/sites/{siteId}/tags",
        "mapping": {
          "path": {
            "siteId": "{{args.siteId}}"
          }
        }
      },
      {
        "name": "list-media",
        "description": "List media library items",
        "method": "GET",
        "path": "/sites/{siteId}/media",
        "mapping": {
          "path": {
            "siteId": "{{args.siteId}}"
          },
          "query": {
            "number": "{{args.number}}",
            "mime_type": "{{args.mimeType}}"
          }
        }
      },
      {
        "name": "upload-media",
        "description": "Upload a media file to the WordPress media library",
        "method": "POST",
        "path": "/sites/{siteId}/media/new",
        "mapping": {
          "body": {
            "media_urls": "{{args.mediaUrls}}"
          },
          "path": {
            "siteId": "{{args.siteId}}"
          }
        }
      },
      {
        "name": "list-comments",
        "description": "List comments on a site",
        "method": "GET",
        "path": "/sites/{siteId}/comments",
        "mapping": {
          "path": {
            "siteId": "{{args.siteId}}"
          },
          "query": {
            "post": "{{args.postId}}",
            "number": "{{args.number}}",
            "status": "{{args.status}}"
          }
        }
      },
      {
        "name": "create-comment",
        "description": "Create a new comment on a post",
        "method": "POST",
        "path": "/sites/{siteId}/posts/{postId}/replies/new",
        "mapping": {
          "body": {
            "content": "{{args.content}}"
          },
          "path": {
            "postId": "{{args.postId}}",
            "siteId": "{{args.siteId}}"
          }
        }
      },
      {
        "name": "get-user-info",
        "description": "Get information about the authenticated user",
        "method": "GET",
        "path": "/me"
      }
    ]
  }
}
