  "payload": {
    "tool": {
      "name": "Add Gmail Labels",
      "description": "Add labels to a message. Can add both system labels (INBOX, STARRED, IMPORTANT) and custom user labels. Use gmail_list_labels to discover available label IDs.",
      "parameters": {
        "type": "object",
        "required": [
          "messageId",
          "labelIds"
        ],
        "properties": {
          "labelIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Array of label IDs to add (e.g., ['STARRED', 'IMPORTANT'] or custom label IDs)"
          },
          "messageId": {
            "type": "string",
            "description": "The ID of the message to add labels to"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "read_args",
            "ref": "start_to_read_args",
            "from": "start"
          },
          {
            "to": "modify_message",
            "ref": "read_args_to_modify",
            "from": "read_args"
          },
          {
            "to": "end",
            "ref": "modify_to_end",
            "from": "modify_message"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start"
          },
          {
            "ref": "read_args",
            "name": "Read Arguments",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const args = ctx.input;\n  return {\n    id: String(args.messageId),\n    addLabelIds: args.labelIds\n  };\n}"
            }
          },
          {
            "ref": "modify_message",
            "name": "Modify Message Labels",
            "type": "connector_action",
            "parameters": {
              "args": "{{ lastOutputOf('read_args') }}",
              "action": "modify-message",
              "timeout": 15000,
              "connector": "gmail"
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end"
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
