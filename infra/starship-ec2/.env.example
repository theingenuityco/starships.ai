# Per-starship box configuration. Copy to /opt/starships/.env and fill in.

# Images (push these to your registry; pin tags per release).
APP_IMAGE=starships-app:latest
RUNNER_IMAGE=starships-runner:latest
RUNNER_SANDBOX_IMAGE=starships-sandbox:latest

# Domain + URLs
STARSHIP_DOMAIN=acme.starships.ai
SERVER_URL=https://acme.starships.ai

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=starships

# Secrets (JWT_SECRET 32+ chars, ENCRYPTION_KEY 32+ hex chars)
JWT_SECRET=
ENCRYPTION_KEY=

# LLM
OPENROUTER_API_KEY=

# Runner
RUNNER_AUTH_TOKEN=

# GitHub is connected per-starship via the connectors UI (OAuth); the connector's
# resolved token is reused for git in the sandbox. No GitHub creds are set here.

# Sandbox limits
RUNNER_SANDBOX_NETWORK=bridge
RUNNER_SANDBOX_MEMORY=2g
RUNNER_SANDBOX_CPUS=2

# Backups
BACKUP_S3_BUCKET=
STARSHIP_SLUG=acme
