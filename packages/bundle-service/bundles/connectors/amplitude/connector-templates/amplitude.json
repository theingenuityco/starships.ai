        "mapping": {
          "path": {
            "project_id": "{{ String(args.project_id) }}"
          },
          "query": {
            "limit": "{{ String(args.limit || 100) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_project",
        "description": "Get project details by ID",
        "method": "GET",
