{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "sentry",
    "fromSlug": "sentry",
    "fromId": "2AazKKZI7F4lkUoGJCaXo"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "2AazKKZI7F4lkUoGJCaXo",
      "slug": "sentry",
      "provider": "sentry",
      "name": "Sentry",
      "description": "Error tracking and performance monitoring platform for identifying and fixing issues.",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "connector",
      "baseUrl": "https://sentry.io/api/0",
      "auth": {
        "type": "api_key",
        "apiKeyRef": {
          "key": "SENTRY_AUTH_TOKEN",
          "type": "connector_secret"
        },
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        }
      },
      "rateLimit": {
        "requestsPerMinute": 200
      }
    },
    "actions": [
      {
        "name": "list_releases",
        "description": "List all releases for a project",
        "method": "GET",
        "path": "/projects/{org_slug}/{project_slug}/releases/",
        "mapping": {
          "path": {
            "org_slug": "{{ String(args.org_slug) }}",
            "project_slug": "{{ String(args.project_slug) }}"
          },
          "query": {
            "cursor": "{{ String(args.cursor || '') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_project",
        "description": "Get details for a specific project",
        "method": "GET",
        "path": "/projects/{org_slug}/{project_slug}/",
        "mapping": {
          "path": {
            "org_slug": "{{ String(args.org_slug) }}",
            "project_slug": "{{ String(args.project_slug) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list_projects",
        "description": "List all projects in your organization",
        "method": "GET",
        "path": "/organizations/{org_slug}/projects/",
        "mapping": {
          "path": {
            "org_slug": "{{ String(args.org_slug) }}"
          },
          "query": {
            "query": "{{ String(args.query || '') }}",
            "cursor": "{{ String(args.cursor || '') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list_issues",
        "description": "List all issues in a project",
        "method": "GET",
        "path": "/projects/{org_slug}/{project_slug}/issues/",
        "mapping": {
          "path": {
            "org_slug": "{{ String(args.org_slug) }}",
            "project_slug": "{{ String(args.project_slug) }}"
          },
          "query": {
            "sort": "{{ String(args.sort || 'date') }}",
            "query": "{{ String(args.query || '') }}",
            "statsPeriod": "{{ String(args.statsPeriod || '24h') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list_events",
        "description": "List all events for an issue",
        "method": "GET",
        "path": "/projects/{org_slug}/{project_slug}/issues/{issue_id}/events/",
        "mapping": {
          "path": {
            "issue_id": "{{ String(args.issue_id) }}",
            "org_slug": "{{ String(args.org_slug) }}",
            "project_slug": "{{ String(args.project_slug) }}"
          },
          "query": {
            "cursor": "{{ String(args.cursor || '') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_event",
        "description": "Get details for a specific event",
        "method": "GET",
        "path": "/projects/{org_slug}/{project_slug}/events/{event_id}/",
        "mapping": {
          "path": {
            "event_id": "{{ String(args.event_id) }}",
            "org_slug": "{{ String(args.org_slug) }}",
            "project_slug": "{{ String(args.project_slug) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_issue",
        "description": "Get details for a specific issue",
        "method": "GET",
        "path": "/projects/{org_slug}/{project_slug}/issues/{issue_id}/",
        "mapping": {
          "path": {
            "issue_id": "{{ String(args.issue_id) }}",
            "org_slug": "{{ String(args.org_slug) }}",
            "project_slug": "{{ String(args.project_slug) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create_release",
        "description": "Create a new release for a project",
        "method": "POST",
        "path": "/projects/{org_slug}/{project_slug}/releases/",
        "mapping": {
          "body": {
            "ref": "{{ String(args.ref || '') }}",
            "url": "{{ String(args.url || '') }}",
            "version": "{{ String(args.version) }}",
            "dateReleased": "{{ String(args.dateReleased || '') }}"
          },
          "path": {
            "org_slug": "{{ String(args.org_slug) }}",
            "project_slug": "{{ String(args.project_slug) }}"
          }
        },
        "timeoutMs": 15000
      }
    ]
  }
}
