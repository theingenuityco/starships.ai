# ===== Landing form: Resend =====
# Required to send emails. Get your key at https://resend.com/api-keys
LANDING_RESEND_API_KEY=

# The verified domain/identity in your Resend account.
LANDING_EMAIL_FROM_ADDRESS=stella@mail.starships.ai
LANDING_EMAIL_FROM_NAME=Stella from Starships

# Inbox that receives new lead notifications.
LANDING_NOTIFICATION_TO=hello@starships.ai

# Booking URL included in the auto-reply sent to the lead.
LANDING_BOOKING_URL=https://cal.com

# Set to false to suppress outbound emails in dev/staging.
LANDING_ENABLE_EMAILS=true

# ===== Landing form: Cloudflare Turnstile (optional) =====
# If either key is absent, CAPTCHA verification is skipped entirely.
# Get these at https://dash.cloudflare.com -> Turnstile -> Add site.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
LANDING_TURNSTILE_SECRET_KEY=

# ===== Landing form: Notion (optional) =====
# Both vars must be set together. If either is absent, Notion writes are silently skipped.
# API key: notion.so/my-integrations -> New integration -> copy "Internal Integration Secret"
# Database ID: open the database as a full page, copy the ID from the URL (32-char hex string)
# The database must be shared with the integration (Share -> Invite -> select your integration)
LANDING_NOTION_API_KEY=
LANDING_NOTION_DATABASE_ID=

# ===== PostHog analytics + session recording (optional) =====
# If NEXT_PUBLIC_POSTHOG_KEY is absent, PostHog is silently skipped.
# Get your key at https://app.posthog.com -> Project settings -> Project API key.
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com — override for EU region or self-hosted.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
