# ===== Landing form: AWS SES =====
# Region where the SES identity is verified (defaults to the monorepo's standard region)
LANDING_AWS_SES_REGION=ap-south-1

# Optional explicit credentials. If omitted, the AWS SDK default credential chain is used
# (env vars, shared credentials file, EC2/ECS task role, etc.). On Vercel set these as env vars.
LANDING_AWS_ACCESS_KEY_ID=
LANDING_AWS_SECRET_ACCESS_KEY=

# The "From" identity for outbound mails. Must be a verified SES identity / domain.
LANDING_EMAIL_FROM_ADDRESS=hello@starships.ai
LANDING_EMAIL_FROM_NAME=Starships

# Inbox that receives new lead notifications.
LANDING_NOTIFICATION_TO=hello@starships.ai

# Cal.com (or any) booking URL included in the auto-reply.
LANDING_BOOKING_URL=https://cal.com/your-handle/intro

# Toggle to disable outbound mails in dev/staging without removing env vars.
LANDING_ENABLE_EMAILS=true
