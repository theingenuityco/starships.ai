{
  "name": "starships.ai",
  "private": true,
  "version": "3.14.3",
  "packageManager": "pnpm@10.12.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS=--no-node-snapshot turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "build": "turbo run build",
    "start": "NODE_OPTIONS=--no-node-snapshot turbo run start",
    "deploy:staging": "cd deploy && npm run deploy:staging",
    "deploy:production": "cd deploy && npm run deploy:production",
    "deploy:staging:dry-run": "cd deploy && npm run deploy:staging:dry-run",
    "deploy:production:dry-run": "cd deploy && npm run deploy:production:dry-run",
    "deployment:validate-pre": "cd deploy && npm run validate:pre",
    "deployment:validate-post": "cd deploy && npm run validate:post",
    "deployment:health-check": "cd deploy && npm run health:check",
    "deployment:load-test": "cd deploy && npm run load:test",
    "deployment:monitoring-setup": "cd deploy && npm run monitoring:setup",
    "migration:run": "cd deploy && npm run migration:run",
    "migration:rollback": "cd deploy && npm run migration:rollback",
    "migration:validate": "cd deploy && npm run migration:validate",
    "migration:test": "cd deploy && npm run migration:test",
    "backup:create": "cd deploy && npm run backup:create",
    "backup:restore": "cd deploy && npm run backup:restore",
    "backup:list": "cd deploy && npm run backup:list",
    "postgres:install": "docker run -d --name starships-postgres -p 5432:5432 -e POSTGRES_PASSWORD=password -e POSTGRES_DB=starships postgres:18 || echo 'Container may already exist. Use postgres:reset to recreate.'",
    "postgres:reset": "docker stop starships-postgres 2>/dev/null || true && docker rm starships-postgres 2>/dev/null || true && echo 'PostgreSQL container cleaned up. Use postgres:install to recreate.'",
    "postgres:shell": "docker exec -it starships-postgres psql -U postgres -d starships || echo 'Container not running. Use postgres:start first.'",
    "postgres:backup": "docker exec starships-postgres pg_dump -U postgres starships > backup_$(date +%Y%m%d_%H%M%S).sql || echo 'Backup failed. Ensure container is running.'"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.4",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/node": "^24.0.10",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.7",
    "ts-node": "^10.9.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "prismjs": ">=1.30.0",
      "form-data": ">=4.0.4",
      "@eslint/plugin-kit@<0.3.4": ">=0.3.4"
    },
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "bcrypt",
      "cpu-features",
      "esbuild",
      "protobufjs",
      "sharp",
      "ssh2",
      "unrs-resolver"
    ]
  }
}
