  "payload": {
    "tool": {
      "name": "Copy Google Spreadsheet",
      "description": "Create a complete copy of a Google Spreadsheet with all its sheets and data using the Google Sheets API",
      "parameters": {
        "type": "object",
        "required": [
          "spreadsheetId",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The name for the copied spreadsheet"
          },
          "spreadsheetId": {
            "type": "string",
            "description": "The ID of the spreadsheet to copy (found in the URL)"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "copy_spreadsheet",
            "ref": "e1",
            "from": "start"
          },
          {
            "to": "format_response",
            "ref": "e2",
            "from": "copy_spreadsheet"
          },
          {
            "to": "end",
            "ref": "e3",
            "from": "format_response"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start",
            "parameters": {}
          },
          {
            "ref": "copy_spreadsheet",
            "name": "Copy Spreadsheet",
            "type": "connector_action",
            "parameters": {
              "args": {
                "name": "{{ String(input.name) }}",
                "spreadsheetId": "{{ String(input.spreadsheetId) }}"
              },
              "action": "copy-spreadsheet",
              "timeout": 20000,
              "connector": "google-sheets",
              "failOnNon2xx": true
            }
          },
          {
            "ref": "format_response",
            "name": "Format Response",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const resp = ctx.lastOutputOf('copy_spreadsheet') || {};\n  \n  if (!resp.body) {\n    throw new Error('No response body from Google Drive API');\n  }\n  \n  return {\n    success: true,\n    id: resp.body.id,\n    name: resp.body.name,\n    mimeType: resp.body.mimeType,\n    url: `https://docs.google.com/spreadsheets/d/${resp.body.id}`\n  };\n}"
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end",
            "parameters": {}
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
