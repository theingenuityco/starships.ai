      {
        "name": "get-organization-follower-statistics",
        "description": "Retrieve daily follower growth statistics for an organization. Track organic vs paid follower gains over time. Provides both lifetime and time-bound follower statistics.\n\n**What You Get:**\n- Daily follower gains (organic and paid breakdown)\n- Time-bound follower growth trends\n- Historical follower data\n\n**Requirements:**\n- Required OAuth scope: rw_organization_admin (included in this connector)\n- Authenticated member must have ADMINISTRATOR role for the organization\n- Data available within specified time range\n\n**Use Cases:**\n- Track follower growth campaigns\n- Measure organic vs paid acquisition\n- Analyze follower trends over time\n- Generate growth reports",
        "method": "GET",
        "path": "/rest/organizationalEntityFollowerStatistics",
        "parameters": {
          "type": "object",
          "required": [
            "organizationalEntity",
            "timeGranularityType",
            "timeRangeStart",
            "timeRangeEnd"
          ],
          "properties": {
            "timeRangeEnd": {
              "type": "number",
              "description": "End timestamp in milliseconds (e.g., 1536796800000)"
            },
            "timeRangeStart": {
              "type": "number",
              "description": "Start timestamp in milliseconds (e.g., 1536364800000)"
            },
            "timeGranularityType": {
              "enum": [
                "DAY"
              ],
              "type": "string",
              "default": "DAY",
              "description": "Time granularity for statistics (currently only DAY is supported)"
            },
            "organizationalEntity": {
              "type": "string",
              "description": "Organization URN (e.g., 'urn:li:organization:2414183')"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "query": {
            "q": "organizationalEntity",
            "timeIntervals": {
              "value": "{{ '(timeRange:(start:' + args.timeRangeStart + ',end:' + args.timeRangeEnd + '),timeGranularityType:' + (args.timeGranularityType || 'DAY') + ')' }}",
              "encoding": "none"
            },
            "organizationalEntity": "{{ args.organizationalEntity }}"
          },
          "headers": {
            "LinkedIn-Version": "202511",
            "X-Restli-Protocol-Version": "2.0.0"
          }
        },
        "response": {
          "select": "{{ body }}"
        }
      },
      {
        "name": "get-organization-share-statistics",
        "description": "Retrieve lifetime performance statistics for organization posts (company page posts). Get detailed metrics including clicks, comments, likes, shares, impressions, and engagement rates.\n\n**What You Get (per post):**\n- Click count - Number of clicks on the post\n- Comment count - Number of comments\n- Like count - Number of likes\n- Share count - Number of reshares\n- Impression count - Number of times post was viewed\n- Engagement rate - Overall engagement percentage\n\n**Important Notes:**\n- ✅ Works for ORGANIZATION posts only (company pages)\n- ✅ Lifetime statistics (not time-bound)\n- ⚠️ Rolling 12-month window - data older than 12 months unavailable\n- ⚠️ Posts with zero actions/impressions are excluded from results\n- ⚠️ Can query multiple posts in one request (up to 100)\n\n**Requirements:**\n- Required OAuth scope: rw_organization_admin (included in this connector)\n- Authenticated member must have ADMINISTRATOR role for the organization\n- Must use UGC Post URNs (urn:li:ugcPost:*)\n\n**For Member Posts:**\n- Use get-post-analytics endpoint instead (requires r_member_postAnalytics scope)",
        "method": "GET",
        "path": "/rest/organizationalEntityShareStatistics",
        "parameters": {
          "type": "object",
          "required": [
            "organizationalEntity",
            "ugcPosts"
          ],
          "properties": {
            "ugcPosts": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "minItems": 1,
              "description": "Array of UGC Post URNs to retrieve statistics for (e.g., ['urn:li:ugcPost:1000000', 'urn:li:ugcPost:1000001']). Maximum 100 posts per request."
            },
            "organizationalEntity": {
              "type": "string",
              "description": "Organization URN (e.g., 'urn:li:organization:2414183')"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "query": {
            "q": "organizationalEntity",
            "ugcPosts": "{{ args.ugcPosts }}",
            "organizationalEntity": "{{ args.organizationalEntity }}"
          },
          "headers": {
            "LinkedIn-Version": "202511",
            "X-Restli-Protocol-Version": "2.0.0"
          }
        },
        "response": {
          "select": "{{ body }}"
        }
      },
      {
        "name": "get-profile",
        "description": "Get the authenticated member's basic profile information (Lite Profile). Returns ID, first name, last name, and profile picture. This is the REST equivalent of the deprecated v2/me endpoint. Requires r_liteprofile or openid+profile scope.",
        "method": "GET",
        "path": "/v2/me",
        "parameters": {
          "type": "object",
          "properties": {
            "projection": {
              "type": "string",
              "description": "Optional field projection to specify which fields to retrieve. Example: '(id,firstName,lastName,profilePicture(displayImage~:playableStreams))'"
            }
          }
        },
        "response": {
          "select": "$"
        }
      },
      {
        "name": "get-connections-count",
        "description": "Get the number of 1st-degree connections for the authenticated member. Returns the firstDegreeSize count. This replaces the deprecated v2/connections/{memberUrn} endpoint. Requires r_1st_connections_size scope. Note: Only works for the currently authenticated member, not other members.",
        "method": "GET",
        "path": "/v2/connections/{memberUrn}",
        "parameters": {
          "type": "object",
          "required": [
            "memberUrn"
          ],
          "properties": {
            "memberUrn": {
              "type": "string",
              "description": "The Person URN of the authenticated member (format: urn:li:person:{personId}). You can get the personId by calling get-profile with projection=(id) first."
            }
          }
        },
        "mapping": {
          "path": {
            "memberUrn": "{{args.memberUrn}}"
          }
        },
        "response": {
          "select": "$"
        }
      }
    ]
  }
