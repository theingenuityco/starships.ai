{
  "schemaVersion": "1",
  "kind": "tool",
  "exportedAt": "2026-05-11T21:17:34.347Z",
  "metadata": {
    "fromSlug": "read-google-drive-file-1p02"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "tool": {
      "name": "Read Google Drive File",
      "description": "Reads the content of a file from Google Drive by file ID",
      "parameters": {
        "type": "object",
        "required": [
          "fileId"
        ],
        "properties": {
          "fileId": {
            "type": "string",
            "description": "The Google Drive file ID to read"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "download_file",
            "ref": "edge_start_download",
            "from": "start"
          },
          {
            "to": "extract_content",
            "ref": "edge_download_extract",
            "from": "download_file"
          },
          {
            "to": "end",
            "ref": "edge_extract_end",
            "from": "extract_content"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start"
          },
          {
            "ref": "download_file",
            "name": "Download File Content",
            "type": "connector_action",
            "parameters": {
              "args": "{{ { fileId: ctx.input.fileId } }}",
              "action": "download-file",
              "timeout": 30000,
              "connector": "google_drive"
            }
          },
          {
            "ref": "extract_content",
            "name": "Extract File Content",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const response = ctx.lastOutputOf('download_file');\n  return response.body;\n}",
              "timeout": 3000
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end"
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
  }
}
