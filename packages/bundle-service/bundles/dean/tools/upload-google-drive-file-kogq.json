{
  "schemaVersion": "1",
  "kind": "tool",
  "exportedAt": "2026-05-11T21:17:34.347Z",
  "metadata": {
    "fromSlug": "upload-google-drive-file-kogq"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "tool": {
      "name": "Upload Google Drive File",
      "description": "Uploads a new file to Google Drive with optional metadata (name, description, folder)",
      "parameters": {
        "type": "object",
        "required": [
          "content",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "File name"
          },
          "content": {
            "type": "string",
            "description": "File content (text or base64-encoded binary)"
          },
          "folderId": {
            "type": "string",
            "description": "Optional Google Drive folder ID to upload the file to"
          },
          "contentType": {
            "type": "string",
            "default": "text/plain",
            "description": "MIME type of the file (e.g., text/plain, application/json, image/png)"
          },
          "description": {
            "type": "string",
            "description": "Optional file description"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "prepare_file",
            "ref": "edge_start_prepare",
            "from": "start"
          },
          {
            "to": "upload_file",
            "ref": "edge_prepare_upload",
            "from": "prepare_file"
          },
          {
            "to": "format_response",
            "ref": "edge_upload_format",
            "from": "upload_file"
          },
          {
            "to": "end",
            "ref": "edge_format_end",
            "from": "format_response"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start"
          },
          {
            "ref": "prepare_file",
            "name": "Prepare File Object",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const input = ctx.input || {};\n  const content = input.content || '';\n  const contentType = input.contentType || 'text/plain';\n  const name = input.name || 'Untitled';\n  const description = input.description || '';\n  const parents = input.folderId ? [input.folderId] : undefined;\n  \n  // Create file object for connector action\n  const fileObj = {\n    base64: Buffer.from(content).toString('base64'),\n    filename: name,\n    contentType: contentType\n  };\n  \n  return {\n    file: fileObj,\n    name: name,\n    mimeType: contentType,\n    parents: parents,\n    description: description\n  };\n}",
              "timeout": 5000
            }
          },
          {
            "ref": "upload_file",
            "name": "Upload to Drive",
            "type": "connector_action",
            "parameters": {
              "args": "{{ lastOutputOf('prepare_file') }}",
              "action": "upload-file",
              "timeout": 60000,
              "connector": "google_drive"
            }
          },
          {
            "ref": "format_response",
            "name": "Format Response",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const response = ctx.lastOutputOf('upload_file');\n  const body = response.body;\n  return {\n    id: body.id,\n    name: body.name,\n    mimeType: body.mimeType,\n    webViewLink: body.webViewLink\n  };\n}",
              "timeout": 3000
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end"
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
  }
}
