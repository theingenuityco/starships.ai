  },
  "payload": {
    "connectorTemplate": {
      "id": "uDSTKaYxKFfORA_P9hJiJ",
      "slug": "tiktok",
      "provider": "tiktok",
      "name": "TikTok",
      "description": "TikTok API connector for social media management. Create and publish videos, manage user profiles, track engagement metr",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "social",
      "baseUrl": "https://open.tiktokapis.com",
      "auth": {
        "type": "oauth2",
        "scopes": [
          "user.info.basic",
          "user.info.profile",
          "user.info.stats",
          "video.list",
          "video.publish",
          "video.upload"
        ],
        "tokenUrl": "https://open.tiktokapis.com/v2/oauth/token/",
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        },
        "clientIdRef": {
          "key": "TIKTOK_CLIENT_ID",
          "type": "platform_secret"
        },
        "tokenResponse": {
          "expiresInField": "expires_in",
          "tokenTypeField": "token_type",
          "accessTokenField": "access_token",
          "refreshTokenField": "refresh_token"
        },
        "accessTokenRef": {
          "key": "TIKTOK_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "scopeDelimiter": ",",
        "clientSecretRef": {
          "key": "TIKTOK_CLIENT_SECRET",
          "type": "platform_secret"
        },
        "refreshTokenRef": {
          "key": "TIKTOK_REFRESH_TOKEN",
          "type": "connector_secret"
        },
        "authorizationUrl": "https://www.tiktok.com/v2/auth/authorize/",
        "extraAuthorizeParams": {
          "response_type": "code"
        }
      },
      "rateLimit": {
        "tier": "standard",
        "burstLimit": 30,
        "requestsPerMinute": 600
      },
      "metadataSchema": {
        "type": "object",
        "required": [],
        "properties": {
          "app_name": {
            "type": "string",
            "description": "Optional name for the TikTok app being used (for tracking purposes)"
          },
          "environment": {
            "enum": [
              "production",
              "development",
              "testing"
            ],
            "type": "string",
            "description": "Environment context for this connector instance"
          }
        },
        "additionalProperties": false
      }
    },
    "actions": [
      {
        "name": "get-user-info",
        "description": "Get authenticated user's profile information including open_id, username, avatar, display name, bio, and verification status",
        "method": "POST",
        "path": "/v2/user/info/",
        "parameters": {
          "type": "object",
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Array of fields to retrieve (open_id, union_id, avatar_url, display_name, bio_description, profile_deep_link, is_verified, username, follower_count, following_count, likes_count, video_count)"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "fields": "{{ args.fields || ['open_id', 'union_id', 'avatar_url', 'display_name', 'bio_description', 'profile_deep_link', 'is_verified', 'username', 'follower_count', 'following_count', 'likes_count', 'video_count'] }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list-videos",
        "description": "List authenticated user's public TikTok videos with pagination support. Returns video metadata including ID, title, description, cover image, and engagement metrics",
        "method": "POST",
        "path": "/v2/video/list/",
        "parameters": {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "number",
              "description": "Pagination cursor from previous response"
            },
            "fields": {
              "type": "string",
              "description": "Comma-separated list of fields to retrieve"
            },
            "maxCount": {
              "type": "number",
              "default": 20,
              "description": "Maximum number of videos to return (max 20)"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "cursor": "{{ args.cursor || 0 }}",
            "max_count": "{{ Number(args.maxCount || 20) }}"
          },
          "query": {
            "fields": "{{ String(args.fields || 'id,title,video_description,duration,cover_image_url,share_url,create_time,like_count,comment_count,share_count,view_count') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "query-videos",
        "description": "Query specific videos by ID to get detailed information or refresh cover image URLs. Supports up to 20 video IDs per request",
        "method": "POST",
        "path": "/v2/video/query/",
        "parameters": {
          "type": "object",
          "required": [
            "videoIds"
          ],
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Array of fields to retrieve"
            },
            "videoIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Array of video IDs to query (max 20)"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "fields": "{{ args.fields || ['id', 'title', 'video_description', 'duration', 'cover_image_url', 'share_url', 'create_time', 'like_count', 'comment_count', 'share_count', 'view_count'] }}",
            "filters": {
              "video_ids": "{{ args.videoIds }}"
            }
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "init-video-publish",
        "description": "Initialize video publishing process. Supports FILE_UPLOAD (chunked upload) or PULL_FROM_URL. Returns publish_id and upload_url for tracking",
        "method": "POST",
        "path": "/v2/post/publish/video/init/",
        "parameters": {
          "type": "object",
          "required": [
            "title",
            "sourceInfo"
          ],
          "properties": {
            "title": {
              "type": "string",
              "description": "Video title (max 150 characters, supports hashtags and mentions)"
            },
            "sourceInfo": {
              "type": "object",
              "description": "Source info object with 'source' (FILE_UPLOAD or PULL_FROM_URL), and required fields based on source type"
            },
            "disableDuet": {
              "type": "boolean",
              "default": false,
              "description": "Disable duet feature"
            },
            "privacyLevel": {
              "enum": [
                "PUBLIC_TO_EVERYONE",
                "MUTUAL_FOLLOW_FRIENDS",
                "SELF_ONLY"
              ],
              "type": "string",
              "default": "PUBLIC_TO_EVERYONE",
              "description": "Privacy level for the video"
            },
            "disableStitch": {
              "type": "boolean",
              "default": false,
              "description": "Disable stitch feature"
            },
            "disableComment": {
              "type": "boolean",
              "default": false,
              "description": "Disable comments"
            },
            "videoCoverTimestampMs": {
              "type": "number",
              "description": "Timestamp in milliseconds for video cover"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "post_info": {
              "title": "{{ String(args.title) }}",
              "disable_duet": "{{ Boolean(args.disableDuet || false) }}",
              "privacy_level": "{{ String(args.privacyLevel || 'PUBLIC_TO_EVERYONE') }}",
              "disable_stitch": "{{ Boolean(args.disableStitch || false) }}",
              "disable_comment": "{{ Boolean(args.disableComment || false) }}",
              "video_cover_timestamp_ms": "{{ args.videoCoverTimestampMs || 1000 }}"
            },
            "source_info": "{{ args.sourceInfo }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "init-video-upload",
        "description": "Initialize video upload to inbox (draft). Upload video without immediately posting. Returns publish_id and upload_url for FILE_UPLOAD",
        "method": "POST",
        "path": "/v2/post/publish/inbox/video/init/",
        "parameters": {
          "type": "object",
          "required": [
            "sourceInfo"
          ],
          "properties": {
            "sourceInfo": {
              "type": "object",
              "description": "Source info with 'source' (FILE_UPLOAD or PULL_FROM_URL) and required fields: video_size, chunk_size, total_chunk_count for FILE_UPLOAD, or video_url for PULL_FROM_URL"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "source_info": "{{ args.sourceInfo }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-publish-status",
        "description": "Check the status of a video publish/upload operation. Returns status (PROCESSING_UPLOAD, PROCESSING_DOWNLOAD, SEND_TO_USER_INBOX, PUBLISH_COMPLETE, FAILED) and post ID if complete",
        "method": "POST",
        "path": "/v2/post/publish/status/fetch/",
        "parameters": {
          "type": "object",
          "required": [
            "publishId"
          ],
          "properties": {
            "publishId": {
              "type": "string",
              "description": "The publish_id returned from init-video-publish or init-video-upload"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "publish_id": "{{ String(args.publishId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "cancel-publish",
        "description": "Cancel an ongoing video download for PULL_FROM_URL uploads. Best-effort cancellation for tasks not yet in processing state",
        "method": "POST",
        "path": "/v2/post/publish/cancel/",
        "parameters": {
          "type": "object",
          "required": [
            "publishId"
          ],
          "properties": {
            "publishId": {
              "type": "string",
              "description": "The publish_id of the task to cancel"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "publish_id": "{{ String(args.publishId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "query-video-comments",
        "description": "Query comments for a specific video using Research API. Supports filtering by video_id and retrieving comment details including text, likes, and replies",
        "method": "POST",
        "path": "/v2/research/video/comment/list/",
        "parameters": {
          "type": "object",
          "required": [
            "videoId"
          ],
          "properties": {
            "cursor": {
              "type": "number",
              "default": 0,
              "description": "Pagination cursor"
            },
            "fields": {
              "type": "string",
              "description": "Comma-separated list of fields to retrieve"
            },
            "videoId": {
              "type": "number",
              "description": "TikTok video ID to query comments for"
            },
            "maxCount": {
              "type": "number",
              "default": 100,
              "description": "Maximum number of comments to return"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "cursor": "{{ Number(args.cursor || 0) }}",
            "video_id": "{{ Number(args.videoId) }}",
            "max_count": "{{ Number(args.maxCount || 100) }}"
          },
          "query": {
            "fields": "{{ String(args.fields || 'id,text,like_count,reply_count,create_time,parent_comment_id') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "query-user-info-research",
        "description": "Query detailed user information using Research API. Get display name, bio, follower count, video count, and verification status by username",
        "method": "POST",
        "path": "/v2/research/user/info/",
        "parameters": {
          "type": "object",
          "required": [
            "username"
          ],
          "properties": {
            "fields": {
              "type": "string",
              "description": "Comma-separated list of fields to retrieve"
            },
            "username": {
              "type": "string",
              "description": "TikTok username to query"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "username": "{{ String(args.username) }}"
          },
          "query": {
            "fields": "{{ String(args.fields || 'display_name,bio_description,avatar_url,is_verified,follower_count,following_count,likes_count,video_count,bio_url') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "init-photo-publish",
        "description": "Initialize photo post publishing. Supports single or multiple photos (carousel). Returns publish_id for tracking post status",
        "method": "POST",
        "path": "/v2/post/publish/content/init/",
        "parameters": {
          "type": "object",
          "required": [
            "title",
            "sourceInfo"
          ],
          "properties": {
            "title": {
              "type": "string",
              "description": "Photo post title (max 150 characters, supports hashtags and mentions)"
            },
            "postMode": {
              "enum": [
                "DIRECT_POST",
                "MEDIA_UPLOAD"
              ],
              "type": "string",
              "default": "DIRECT_POST",
              "description": "Post mode: DIRECT_POST (publish immediately) or MEDIA_UPLOAD (save as draft)"
            },
            "sourceInfo": {
              "type": "object",
              "description": "Source info with photo_images array containing photo_cover_index and photo_urls for PULL_FROM_URL"
            },
            "autoAddMusic": {
              "type": "boolean",
              "default": false,
              "description": "Automatically add music to the photo post"
            },
            "privacyLevel": {
              "enum": [
                "PUBLIC_TO_EVERYONE",
                "MUTUAL_FOLLOW_FRIENDS",
                "SELF_ONLY"
              ],
              "type": "string",
              "default": "PUBLIC_TO_EVERYONE",
              "description": "Privacy level for the photo post"
            },
            "disableComment": {
              "type": "boolean",
              "default": false,
              "description": "Disable comments on the photo post"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "post_info": {
              "title": "{{ String(args.title) }}",
              "privacy_level": "{{ String(args.privacyLevel || 'PUBLIC_TO_EVERYONE') }}",
              "auto_add_music": "{{ Boolean(args.autoAddMusic || false) }}",
              "disable_comment": "{{ Boolean(args.disableComment || false) }}"
            },
            "post_mode": "{{ String(args.postMode || 'DIRECT_POST') }}",
            "media_type": "PHOTO",
            "source_info": "{{ args.sourceInfo }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "search-videos",
        "description": "Search for videos using Research API. Query videos by keywords, hashtags, or other criteria with advanced filtering and pagination",
        "method": "POST",
        "path": "/v2/research/video/query/",
        "parameters": {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "number",
              "default": 0,
              "description": "Pagination cursor"
            },
            "fields": {
              "type": "string",
              "description": "Comma-separated list of fields to retrieve"
            },
            "maxCount": {
              "type": "number",
              "default": 100,
              "description": "Maximum number of videos to return"
            },
            "searchId": {
              "type": "string",
              "description": "Search ID for continuing a previous search"
            },
            "orConditions": {
              "type": "array",
              "description": "Array of OR conditions for filtering videos"
            },
            "andConditions": {
              "type": "array",
              "description": "Array of AND conditions for filtering videos"
            },
            "notConditions": {
              "type": "array",
              "description": "Array of NOT conditions for filtering videos"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "query": {
              "or": "{{ args.orConditions || [] }}",
              "and": "{{ args.andConditions || [] }}",
              "not": "{{ args.notConditions || [] }}"
            },
            "cursor": "{{ Number(args.cursor || 0) }}",
            "max_count": "{{ Number(args.maxCount || 100) }}",
            "search_id": "{{ args.searchId }}"
          },
          "query": {
            "fields": "{{ String(args.fields || 'id,video_description,create_time,region_code,share_count,view_count,like_count,comment_count,music_id,hashtag_names,username,effect_ids,playlist_id,voice_to_text') }}"
          }
        },
        "timeoutMs": 15000
      },
