[
  {
    "name": "get-user",
    "description": "Get the authenticated user's GitHub profile. Verifies authentication and returns user information.",
    "method": "GET",
    "path": "/user",
    "parameters": {
      "type": "object",
      "properties": {}
    },
    "mapping": {
      "headers": {
        "Accept": "application/vnd.github+json"
      }
    },
    "timeoutMs": 15000
  },
  {
    "name": "list-user-repos",
    "description": "List repositories for the authenticated user. Returns repos the user owns, collaborates on, or is a member of.",
    "method": "GET",
    "path": "/user/repos",
    "parameters": {
      "type": "object",
      "properties": {
        "page": {
          "type": "number",
          "minimum": 1,
          "description": "The page number of the results to fetch"
        },
        "sort": {
          "enum": [
            "created",
            "updated",
            "pushed",
            "full_name"
          ],
          "type": "string",
          "description": "The property to sort the results by"
        },
        "type": {
          "enum": [
            "all",
            "owner",
            "public",
            "private",
            "member"
          ],
          "type": "string",
          "description": "Limit results to repositories of the specified type"
        },
        "per_page": {
          "type": "number",
          "maximum": 100,
          "minimum": 1,
          "description": "The number of results per page (max 100)"
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ],
          "type": "string",
          "description": "The order to sort by"
        },
        "visibility": {
          "enum": [
            "all",
            "public",
            "private"
          ],
          "type": "string",
          "description": "Limit results to repositories with the specified visibility"
        },
        "affiliation": {
          "type": "string",
          "description": "Comma-separated list of values. Can include: owner, collaborator, organization_member"
        }
      }
    },
    "mapping": {
      "query": {
        "page": "{{ args.page ? String(args.page) : undefined }}",
        "sort": "{{ args.sort ? String(args.sort) : undefined }}",
        "type": "{{ args.type ? String(args.type) : undefined }}",
        "per_page": "{{ args.per_page ? String(args.per_page) : undefined }}",
        "direction": "{{ args.direction ? String(args.direction) : undefined }}",
        "visibility": "{{ args.visibility ? String(args.visibility) : undefined }}",
        "affiliation": "{{ args.affiliation ? String(args.affiliation) : undefined }}"
      },
      "headers": {
        "Accept": "application/vnd.github+json"
      }
    },
    "timeoutMs": 15000
  },
  {
    "name": "get-repo",
    "description": "Get details of a specific repository including description, stars, forks, language, and permissions.",
    "method": "GET",
    "path": "/repos/{owner}/{repo}",
    "parameters": {
      "type": "object",
      "required": [
        "owner",
        "repo"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "description": "The name of the repository without the .git extension. The name is not case sensitive."
        },
        "owner": {
          "type": "string",
          "description": "The account owner of the repository. The name is not case sensitive."
        }
      }
    },
    "mapping": {
      "path": {
        "repo": "{{ String(args.repo) }}",
        "owner": "{{ String(args.owner) }}"
      },
      "headers": {
        "Accept": "application/vnd.github+json"
      }
    },
    "timeoutMs": 15000
  },
  {
    "name": "get-repo-contents",
    "description": "Get contents of a file or directory in a repository. Files are returned with base64-encoded content.",
    "method": "GET",
    "path": "/repos/{owner}/{repo}/contents/{path}",
    "parameters": {
      "type": "object",
      "required": [
        "owner",
        "repo",
        "path"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "description": "The name of the commit/branch/tag. Default: the repository's default branch"
        },
        "path": {
          "type": "string",
          "description": "The file or directory path in the repository"
        },
        "repo": {
          "type": "string",
          "description": "The name of the repository"
        },
        "owner": {
          "type": "string",
          "description": "The account owner of the repository"
        }
      }
    },
    "mapping": {
      "path": {
        "path": "{{ String(args.path) }}",
        "repo": "{{ String(args.repo) }}",
        "owner": "{{ String(args.owner) }}"
      },
      "query": {
        "ref": "{{ args.ref ? String(args.ref) : undefined }}"
      },
      "headers": {
        "Accept": "application/vnd.github+json"
      }
    },
    "timeoutMs": 15000
  },
  {
    "name": "list-repo-issues",
    "description": "List issues in a repository. Note: GitHub's REST API considers every pull request an issue, but not every issue is a pull request.",
    "method": "GET",
    "path": "/repos/{owner}/{repo}/issues",
    "parameters": {
      "type": "object",
      "required": [
        "owner",
        "repo"
      ],
      "properties": {
        "page": {
          "type": "number",
          "minimum": 1,
          "description": "The page number of the results to fetch"
        },
        "repo": {
          "type": "string",
          "description": "The name of the repository"
        },
        "sort": {
          "enum": [
            "created",
            "updated",
            "comments"
          ],
          "type": "string",
          "description": "What to sort results by"
        },
        "owner": {
          "type": "string",
          "description": "The account owner of the repository"
        },
        "since": {
          "type": "string",
          "description": "Only show results updated after the given time (ISO 8601 format: YYYY-MM-DDTHH:MM:SSZ)"
        },
        "state": {
          "enum": [
            "open",
            "closed",
            "all"
          ],
          "type": "string",
          "description": "Indicates the state of the issues to return"
        },
        "labels": {
          "type": "string",
          "description": "A list of comma separated label names. Example: bug,ui,@high"
        },
        "per_page": {
          "type": "number",
          "maximum": 100,
          "minimum": 1,
          "description": "The number of results per page (max 100)"
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ],
          "type": "string",
          "description": "The direction to sort the results by"
        }
      }
    },
    "mapping": {
      "path": {
        "repo": "{{ String(args.repo) }}",
        "owner": "{{ String(args.owner) }}"
      },
      "query": {
        "page": "{{ args.page ? String(args.page) : undefined }}",
        "sort": "{{ args.sort ? String(args.sort) : undefined }}",
        "since": "{{ args.since ? String(args.since) : undefined }}",
        "state": "{{ args.state ? String(args.state) : undefined }}",
        "labels": "{{ args.labels ? String(args.labels) : undefined }}",
        "per_page": "{{ args.per_page ? String(args.per_page) : undefined }}",
        "direction": "{{ args.direction ? String(args.direction) : undefined }}"
      },
      "headers": {
        "Accept": "application/vnd.github+json"
      }
    },
    "timeoutMs": 15000
  },
