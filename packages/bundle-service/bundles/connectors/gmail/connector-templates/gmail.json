        "method": "GET",
        "path": "/gmail/v1/users/me/history",
        "parameters": {
          "type": "object",
          "required": [
            "startHistoryId"
          ],
          "properties": {
            "labelId": {
              "type": "string",
              "description": "Only return messages with a label matching this ID"
            },
            "pageToken": {
              "type": "string",
              "description": "Token to retrieve a specific page of results"
            },
            "maxResults": {
              "type": "number",
              "maximum": 500,
              "minimum": 1,
              "description": "Maximum number of history records to return (1-500)"
            },
            "historyTypes": {
              "type": "string",
              "description": "Comma-separated list of history types to return (messageAdded, messageDeleted, labelAdded, labelRemoved)"
            },
            "startHistoryId": {
              "type": "string",
              "description": "Returns history records after the specified historyId"
            }
          }
        },
        "mapping": {
          "query": {
            "labelId": "{{ args.labelId ? String(args.labelId) : undefined }}",
            "pageToken": "{{ args.pageToken ? String(args.pageToken) : undefined }}",
            "maxResults": "{{ args.maxResults ? String(args.maxResults) : undefined }}",
            "historyTypes": "{{ args.historyTypes ? String(args.historyTypes) : undefined }}",
            "startHistoryId": "{{ String(args.startHistoryId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-attachment",
        "description": "Get a specific attachment from a message. Returns the attachment data in base64url encoded format.",
        "method": "GET",
        "path": "/gmail/v1/users/me/messages/{messageId}/attachments/{id}",
        "parameters": {
          "type": "object",
          "required": [
            "messageId",
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "The ID of the attachment"
            },
            "messageId": {
              "type": "string",
              "description": "The ID of the message containing the attachment"
            }
          }
        },
        "mapping": {
          "path": {
            "id": "{{ String(args.id) }}",
            "messageId": "{{ String(args.messageId) }}"
          }
        },
        "timeoutMs": 30000
      },
      {
        "name": "import-message",
        "description": "Import a message into the mailbox with standard email delivery scanning. Similar to receiving via SMTP.",
        "method": "POST",
        "path": "/gmail/v1/users/me/messages/import",
        "parameters": {
          "type": "object",
          "required": [
            "raw"
          ],
          "properties": {
            "raw": {
              "type": "string",
              "description": "The entire email message in RFC 2822 format, base64url encoded"
            },
            "internalDateSource": {
              "enum": [
                "dateHeader",
                "receivedTime"
              ],
              "type": "string",
              "description": "Source for internal date of the message (default: receivedTime)"
            }
          }
        },
        "mapping": {
          "body": {
            "raw": "{{ String(args.raw) }}",
            "internalDateSource": "{{ args.internalDateSource ? String(args.internalDateSource) : undefined }}"
          }
        },
        "timeoutMs": 30000
      },
      {
        "name": "insert-message",
        "description": "Insert a message directly into the mailbox, similar to IMAP APPEND. Bypasses most scanning and classification.",
        "method": "POST",
        "path": "/gmail/v1/users/me/messages",
        "parameters": {
          "type": "object",
          "required": [
            "raw"
          ],
          "properties": {
            "raw": {
              "type": "string",
              "description": "The entire email message in RFC 2822 format, base64url encoded"
            },
            "internalDateSource": {
              "enum": [
                "dateHeader",
                "receivedTime"
              ],
              "type": "string",
              "description": "Source for internal date of the message (default: receivedTime)"
            }
          }
        },
        "mapping": {
          "body": {
            "raw": "{{ String(args.raw) }}",
            "internalDateSource": "{{ args.internalDateSource ? String(args.internalDateSource) : undefined }}"
          }
        },
        "timeoutMs": 30000
      }
    ]
  }
}
