            },
            "subject": {
              "type": "string",
              "description": "Email subject"
            },
            "cc_recipients": {
              "type": "array",
              "description": "CC recipient addresses"
            },
            "to_recipients": {
              "type": "array",
              "description": "Array of recipient email addresses"
            },
            "bcc_recipients": {
              "type": "array",
              "description": "BCC recipient addresses"
            }
          }
        },
        "mapping": {
          "body": {
            "message": {
              "body": {
                "content": "{{ String(args.body) }}",
                "contentType": "HTML"
              },
              "subject": "{{ String(args.subject) }}",
              "ccRecipients": "{{ args.cc_recipients }}",
              "toRecipients": "{{ args.to_recipients }}",
              "bccRecipients": "{{ args.bcc_recipients }}"
