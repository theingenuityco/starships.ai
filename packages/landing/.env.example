# ===== Landing form: Resend =====
# Required to send emails. Get your key at https://resend.com/api-keys
LANDING_RESEND_API_KEY=

# The verified domain/identity in your Resend account.
LANDING_EMAIL_FROM_ADDRESS=hello@starships.ai
LANDING_EMAIL_FROM_NAME=Starships

# Inbox that receives new lead notifications.
LANDING_NOTIFICATION_TO=hello@starships.ai

# Booking URL included in the auto-reply sent to the lead.
LANDING_BOOKING_URL=https://cal.com

# Set to false to suppress outbound emails in dev/staging.
LANDING_ENABLE_EMAILS=true

# ===== Landing form: Cloudflare Turnstile (optional) =====
# If either key is absent, CAPTCHA verification is skipped entirely.
# Get these at https://dash.cloudflare.com -> Turnstile -> Add site.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
LANDING_TURNSTILE_SECRET_KEY=

# ===== Landing form: Google Sheets (optional) =====
# All three vars must be set together. If any is absent, sheet appends are silently skipped.
# Spreadsheet ID from the sheet URL: /spreadsheets/d/<SPREADSHEET_ID>/edit
# Share the sheet with LANDING_GOOGLE_SERVICE_ACCOUNT_EMAIL (Editor role).
# Column order: Timestamp | Name | Email | Website | Company URL | Room | Message | Source
LANDING_GOOGLE_SHEETS_SPREADSHEET_ID=
LANDING_GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key value from the downloaded service account JSON.
# On Vercel, store as-is — the literal \n characters are unescaped automatically.
LANDING_GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
