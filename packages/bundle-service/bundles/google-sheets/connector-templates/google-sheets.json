  "payload": {
    "connectorTemplate": {
      "id": "tS7nNQHv9m1dO_e90u9aH",
      "slug": "google-sheets-2",
      "provider": "google-sheets",
      "name": "Google Sheets",
      "description": "Append, read, and manage rows in Google Sheets for lead storage and management",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "connector",
      "baseUrl": "https://sheets.googleapis.com/v4/spreadsheets",
