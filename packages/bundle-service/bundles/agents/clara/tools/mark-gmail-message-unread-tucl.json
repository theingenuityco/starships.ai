{
  "schemaVersion": "1",
  "kind": "tool",
  "exportedAt": "2026-05-11T21:17:34.347Z",
  "metadata": {
    "fromSlug": "mark-gmail-message-unread-tucl"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "tool": {
      "name": "Mark Gmail Message Unread",
      "description": "Mark a message as unread. This adds the UNREAD system label to the message.",
      "parameters": {
        "type": "object",
        "required": [
          "messageId"
        ],
        "properties": {
          "messageId": {
            "type": "string",
            "description": "The ID of the message to mark as unread"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "build_args",
            "ref": "start_to_build",
            "from": "start"
          },
          {
            "to": "modify_message",
            "ref": "build_to_modify",
            "from": "build_args"
          },
          {
            "to": "end",
            "ref": "modify_to_end",
            "from": "modify_message"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start"
          },
          {
            "ref": "build_args",
            "name": "Build Connector Args",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const args = ctx.input || {};\n  return {\n    id: String(args.messageId),\n    addLabelIds: ['UNREAD']\n  };\n}",
              "timeout": 3000
            }
          },
          {
            "ref": "modify_message",
            "name": "Mark Message as Unread",
            "type": "connector_action",
            "parameters": {
              "args": "{{ lastOutputOf('build_args') }}",
              "action": "modify-message",
              "timeout": 15000,
              "connector": "gmail"
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end"
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
  }
}
