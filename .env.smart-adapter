# Smart Parameter Adapter Configuration
# Copy these to your .env file to enable the smart adapter

# Enable the smart parameter adapter
# Set to 'true' to use the smart adapter, 'false' to use legacy method
USE_SMART_ADAPTER=true

# Logging level for the smart adapter
# Options: 'debug' for detailed logging, 'info' for normal logging
SMART_ADAPTER_LOG_LEVEL=info

# Path to parameter overrides YAML file
# Default: config/parameter-overrides.yaml
PARAM_OVERRIDES_PATH=config/parameter-overrides.yaml

# Pattern memory settings
# Minimum success count before using a cached pattern
PATTERN_MIN_SUCCESS_COUNT=3

# Pattern TTL in days (patterns unused for this long are cleaned up)
PATTERN_TTL_DAYS=90