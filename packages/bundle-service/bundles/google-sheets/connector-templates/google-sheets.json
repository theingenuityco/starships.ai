        "method": "POST",
        "path": "/{spreadsheetId}:batchUpdate",
        "parameters": {
          "type": "object",
          "required": [
            "spreadsheetId",
            "sheetId",
            "startIndex",
            "endIndex"
          ],
          "properties": {
            "sheetId": {
              "type": "number",
              "description": "The sheet ID where rows will be deleted"
            },
            "endIndex": {
              "type": "number",
              "description": "The end index of rows to delete (exclusive)"
            },
            "startIndex": {
              "type": "number",
              "description": "The start index of rows to delete (0-based)"
            },
            "spreadsheetId": {
              "type": "string",
              "description": "The ID of the spreadsheet"
            }
          }
        },
        "mapping": {
          "body": {
            "requests": [
              {
                "deleteDimension": {
                  "range": {
                    "sheetId": "{{ Number(args.sheetId) }}",
                    "endIndex": "{{ Number(args.endIndex) }}",
