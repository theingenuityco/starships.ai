{
  "schemaVersion": "1",
  "kind": "tool",
  "exportedAt": "2026-05-11T21:17:34.347Z",
  "metadata": {
    "fromSlug": "batch-get-rows-from-google-sheet-i36x"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "tool": {
      "name": "Batch Get Rows from Google Sheet",
      "description": "Read multiple ranges from a Google Spreadsheet in a single request using the Google Sheets API",
      "parameters": {
        "type": "object",
        "required": [
          "spreadsheetId",
          "ranges"
        ],
        "properties": {
          "ranges": {
            "type": "array",
            "description": "Array of ranges to read (e.g., ['Sheet1!A:D', 'Sheet2!A1:B10'])"
          },
          "spreadsheetId": {
            "type": "string",
            "description": "The ID of the spreadsheet (found in the URL)"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "build_url",
            "ref": "e1",
            "from": "start"
          },
          {
            "to": "batch_get",
            "ref": "e2",
            "from": "build_url"
          },
          {
            "to": "format_response",
            "ref": "e3",
            "from": "batch_get"
          },
          {
            "to": "end",
            "ref": "e4",
            "from": "format_response"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start",
            "parameters": {}
          },
          {
            "ref": "build_url",
            "name": "Build URL",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const { spreadsheetId, ranges } = ctx.input || {};\n  const baseUrl = `https://sheets.googleapis.com/v4/spreadsheets/${spreadsheetId}/values:batchGet`;\n  const rangeParams = ranges.map(r => `ranges=${encodeURIComponent(r)}`).join('&');\n  return { url: `${baseUrl}?${rangeParams}` };\n}"
            }
          },
          {
            "ref": "batch_get",
            "name": "Batch Get Rows",
            "type": "http_request",
            "parameters": {
              "url": "{{ (lastOutputOf('build_url') || {}).url }}",
              "method": "GET",
              "headers": {
                "Authorization": "{{ 'Bearer ' + env('GOOGLE_SHEETS_ACCESS_TOKEN') }}"
              },
              "timeout": 15000,
              "failOnNon2xx": true
            }
          },
          {
            "ref": "format_response",
            "name": "Format Response",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const resp = ctx.lastOutputOf('batch_get') || {};\n  \n  if (!resp.body) {\n    throw new Error('No response body from Google Sheets API');\n  }\n  \n  return {\n    success: true,\n    spreadsheetId: resp.body.spreadsheetId,\n    valueRanges: resp.body.valueRanges || []\n  };\n}"
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end",
            "parameters": {}
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
  }
}
