    "actions": [
      {
        "name": "list_files",
        "description": "List OneDrive files in user's root directory",
        "method": "GET",
        "path": "/me/drive/root/children",
        "parameters": {
          "type": "object",
          "properties": {
            "top": {
              "type": "number",
              "description": "Number of files to return"
            },
            "filter": {
              "type": "string",
              "description": "OData filter expression"
            }
          }
        },
        "mapping": {
          "query": {
            "$top": "{{ String(args.top || 10) }}",
            "$filter": "{{ args.filter }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list_teams",
        "description": "List Teams the user is a member of",
        "method": "GET",
        "path": "/me/memberOf/microsoft.graph.team",
        "parameters": {
          "type": "object",
          "properties": {
            "top": {
              "type": "number",
              "description": "Number of teams to return"
            }
          }
        },
        "mapping": {
          "query": {
            "$top": "{{ String(args.top || 10) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_file",
        "description": "Get file details by file ID",
