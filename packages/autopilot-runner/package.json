{
  "name": "@starships/autopilot-runner",
  "version": "0.0.1",
  "private": true,
  "description": "Sandbox entrypoint host for the code-native CLI agent (@starships/autopilot-cli)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -f tsconfig.tsbuildinfo && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "dev": "NODE_OPTIONS=--no-node-snapshot tsx watch src/cliAgent/cliJobAgent.ts",
    "start": "NODE_OPTIONS=--no-node-snapshot node dist/cliAgent/cliJobAgent.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "jest"
  },
  "dependencies": {
    "@starships/autopilot-cli": "workspace:*",
    "@starships/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.6",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
