{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "mailchimp",
    "fromSlug": "mailchimp",
    "fromId": "fgRhDsDv9swZRBtwlM7_B"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "fgRhDsDv9swZRBtwlM7_B",
      "slug": "mailchimp",
      "provider": "mailchimp",
      "name": "Mailchimp",
      "description": "Mailchimp email marketing platform connector for managing contacts, campaigns, lists, and sending transactional emails",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "connector",
      "baseUrl": "https://mandrillapp.com/api/1.0",
      "auth": {
        "type": "api_key",
        "apiKeyRef": {
          "key": "MAILCHIMP_API_KEY",
          "type": "connector_secret"
        },
        "injection": {
          "style": "json",
          "headerName": "Authorization"
        }
      },
      "rateLimit": {
        "tier": "default",
        "burstLimit": 10,
        "requestsPerMinute": 120
      },
      "metadataSchema": {
        "type": "object",
        "required": [],
        "properties": {
          "accountId": {
            "type": "string",
            "description": "Optional Mailchimp account identifier"
          }
        },
        "additionalProperties": false
      }
    },
    "actions": [
      {
        "name": "export-activity",
        "description": "Export activity data (sends, bounces, opens, clicks, etc.)",
        "method": "POST",
        "path": "/exports/activity",
        "mapping": {
          "body": {
            "options": {
              "limit": "{{ args.limit }}",
              "types": "{{ args.types }}",
              "end_date": "{{ args.endDate }}",
              "start_date": "{{ args.startDate }}"
            },
            "notify_email": "{{ args.notifyEmail }}"
          }
        },
        "timeoutMs": 30000
      },
      {
        "name": "get-account-info",
        "description": "Get authenticated user account information, quotas, and statistics",
        "method": "GET",
        "path": "/users/info",
        "timeoutMs": 15000
      },
      {
        "name": "add-domain",
        "description": "Add a sender domain for verification",
        "method": "POST",
        "path": "/senders/add-domain",
        "mapping": {
          "body": {
            "domain": "{{ String(args.domain) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "send-message",
        "description": "Send a single email message",
        "method": "POST",
        "path": "/messages/send",
        "mapping": {
          "body": {
            "message": {
              "to": "{{ args.to }}",
              "html": "{{ args.html }}",
              "tags": "{{ args.tags }}",
              "text": "{{ args.text }}",
              "subject": "{{ String(args.subject) }}",
              "metadata": "{{ args.metadata }}",
              "from_email": "{{ String(args.fromEmail) }}"
            }
          }
        },
        "timeoutMs": 30000
      },
      {
        "name": "get-message-info",
        "description": "Get information about a specific message",
        "method": "POST",
        "path": "/messages/info",
        "mapping": {
          "body": {
            "id": "{{ String(args.messageId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list-domains",
        "description": "List all verified sender domains",
        "method": "GET",
        "path": "/senders/domains",
        "timeoutMs": 15000
      },
      {
        "name": "list-senders",
        "description": "Get list of senders associated with the account",
        "method": "GET",
        "path": "/users/senders",
        "timeoutMs": 15000
      },
      {
        "name": "search-messages",
        "description": "Search for messages based on criteria",
        "method": "POST",
        "path": "/messages/search",
        "mapping": {
          "body": {
            "limit": "{{ args.limit || 10 }}",
            "query": "{{ String(args.query) }}",
            "offset": "{{ args.offset || 0 }}"
          }
        },
        "timeoutMs": 30000
      },
      {
        "name": "verify-domain",
        "description": "Send verification email for a domain",
        "method": "POST",
        "path": "/senders/verify-domain",
        "mapping": {
          "body": {
            "domain": "{{ String(args.domain) }}",
            "mailbox": "{{ String(args.mailbox) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "ping",
        "description": "Verify API connection is working",
        "method": "POST",
        "path": "/users/ping",
        "timeoutMs": 10000
      }
    ]
  }
}
