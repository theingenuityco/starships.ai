{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "x-twitter",
    "fromSlug": "x-twitter",
    "fromId": "Pjn3PGHAsQ_mJ6uObXGxx"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "Pjn3PGHAsQ_mJ6uObXGxx",
      "slug": "x-twitter",
      "provider": "x-twitter",
      "name": "X (Twitter)",
      "description": "X (Twitter) API v2 connector with OAuth 2.0 authentication. Supports tweet management, user operations, and search funct",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "social",
      "baseUrl": "https://api.twitter.com/2",
      "auth": {
        "type": "oauth2",
        "scopes": [
          "tweet.read",
          "tweet.write",
          "users.read",
          "follows.read",
          "follows.write",
          "offline.access",
          "like.read",
          "like.write"
        ],
        "tokenUrl": "https://api.twitter.com/2/oauth2/token",
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        },
        "clientIdRef": {
          "key": "X_OAUTH_CLIENT_ID",
          "type": "platform_secret"
        },
        "tokenResponse": {
          "scopeField": "scope",
          "expiresInField": "expires_in",
          "tokenTypeField": "token_type",
          "accessTokenField": "access_token",
          "refreshTokenField": "refresh_token"
        },
        "accessTokenRef": {
          "key": "X_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "scopeDelimiter": " ",
        "clientSecretRef": {
          "key": "X_OAUTH_CLIENT_SECRET",
          "type": "platform_secret"
        },
        "refreshTokenRef": {
          "key": "X_REFRESH_TOKEN",
          "type": "connector_secret"
        },
        "authorizationUrl": "https://twitter.com/i/oauth2/authorize"
      },
      "rateLimit": {
        "tier": "free",
        "burstLimit": 15,
        "requestsPerMinute": 15
      },
      "metadataSchema": {
        "type": "object",
        "required": [],
        "properties": {
          "app_name": {
            "type": "string",
            "description": "Optional name for the X app being used (for tracking purposes)"
          },
          "environment": {
            "enum": [
              "production",
              "development",
              "testing"
            ],
            "type": "string",
            "description": "Environment context for this connector instance"
          }
        },
        "additionalProperties": false
      }
    },
    "actions": [
      {
        "name": "get-me",
        "description": "Get information about the authenticated user",
        "method": "GET",
        "path": "/users/me",
        "mapping": {
          "query": {
            "user.fields": "{{ String(args.userFields || 'id,name,username,created_at,description,profile_image_url') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-user-by-username",
        "description": "Get information about a user by their username",
        "method": "GET",
        "path": "/users/by/username/{username}",
        "mapping": {
          "path": {
            "username": "{{ String(args.username) }}"
          },
          "query": {
            "user.fields": "{{ String(args.userFields || 'id,name,username,created_at,description,profile_image_url,public_metrics') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-user-by-id",
        "description": "Get information about a user by their ID",
        "method": "GET",
        "path": "/users/{id}",
        "mapping": {
          "path": {
            "id": "{{ String(args.id) }}"
          },
          "query": {
            "user.fields": "{{ String(args.userFields || 'id,name,username,created_at,description,profile_image_url,public_metrics') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "post-tweet",
        "description": "Create a new tweet. Supports text, reply settings, and quote tweets.",
        "method": "POST",
        "path": "/tweets",
        "mapping": {
          "body": {
            "text": "{{ String(args.text) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "delete-tweet",
        "description": "Delete a tweet by ID. Must be owned by the authenticated user.",
        "method": "DELETE",
        "path": "/tweets/{id}",
        "mapping": {
          "path": {
            "id": "{{ String(args.id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-tweet",
        "description": "Get a single tweet by ID with optional expansions and fields",
        "method": "GET",
        "path": "/tweets/{id}",
        "mapping": {
          "path": {
            "id": "{{ String(args.id) }}"
          },
          "query": {
            "expansions": "{{ String(args.expansions || 'author_id') }}",
            "user.fields": "{{ String(args.userFields || 'id,name,username,profile_image_url') }}",
            "tweet.fields": "{{ String(args.tweetFields || 'id,text,author_id,created_at,public_metrics') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-user-tweets",
        "description": "Get tweets posted by a specific user",
        "method": "GET",
        "path": "/users/{id}/tweets",
        "mapping": {
          "path": {
            "id": "{{ String(args.id) }}"
          },
          "query": {
            "exclude": "{{ String(args.exclude || 'retweets,replies') }}",
            "max_results": "{{ String(args.maxResults || '10') }}",
            "tweet.fields": "{{ String(args.tweetFields || 'id,text,created_at,public_metrics') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "search-recent-tweets",
        "description": "Search for tweets from the last 7 days using a query string",
        "method": "GET",
        "path": "/tweets/search/recent",
        "mapping": {
          "query": {
            "query": "{{ String(args.query) }}",
            "expansions": "{{ String(args.expansions || 'author_id') }}",
            "max_results": "{{ String(args.maxResults || '10') }}",
            "user.fields": "{{ String(args.userFields || 'id,name,username') }}",
            "tweet.fields": "{{ String(args.tweetFields || 'id,text,author_id,created_at,public_metrics') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "like-tweet",
        "description": "Like a tweet. Authenticated user will like the specified tweet.",
        "method": "POST",
        "path": "/users/{id}/likes",
        "mapping": {
          "body": {
            "tweet_id": "{{ String(args.tweetId) }}"
          },
          "path": {
            "id": "{{ String(args.userId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "unlike-tweet",
        "description": "Unlike a tweet. Authenticated user will unlike the specified tweet.",
        "method": "DELETE",
        "path": "/users/{id}/likes/{tweet_id}",
        "mapping": {
          "path": {
            "id": "{{ String(args.userId) }}",
            "tweet_id": "{{ String(args.tweetId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "retweet",
        "description": "Retweet a tweet. Authenticated user will retweet the specified tweet.",
        "method": "POST",
        "path": "/users/{id}/retweets",
        "mapping": {
          "body": {
            "tweet_id": "{{ String(args.tweetId) }}"
          },
          "path": {
            "id": "{{ String(args.userId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "unretweet",
        "description": "Remove a retweet. Authenticated user will undo their retweet.",
        "method": "DELETE",
        "path": "/users/{id}/retweets/{tweet_id}",
        "mapping": {
          "path": {
            "id": "{{ String(args.userId) }}",
            "tweet_id": "{{ String(args.tweetId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "follow-user",
        "description": "Follow a user. Authenticated user will follow the target user.",
        "method": "POST",
        "path": "/users/{id}/following",
        "mapping": {
          "body": {
            "target_user_id": "{{ String(args.targetUserId) }}"
          },
          "path": {
            "id": "{{ String(args.userId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "unfollow-user",
        "description": "Unfollow a user. Authenticated user will unfollow the target user.",
        "method": "DELETE",
        "path": "/users/{source_user_id}/following/{target_user_id}",
        "mapping": {
          "path": {
            "source_user_id": "{{ String(args.userId) }}",
            "target_user_id": "{{ String(args.targetUserId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-followers",
        "description": "Get a list of users who follow the specified user",
        "method": "GET",
        "path": "/users/{id}/followers",
        "mapping": {
          "path": {
            "id": "{{ String(args.id) }}"
          },
          "query": {
            "max_results": "{{ String(args.maxResults || '10') }}",
            "user.fields": "{{ String(args.userFields || 'id,name,username,profile_image_url') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-following",
        "description": "Get a list of users that the specified user is following",
        "method": "GET",
        "path": "/users/{id}/following",
        "mapping": {
          "path": {
            "id": "{{ String(args.id) }}"
          },
          "query": {
            "max_results": "{{ String(args.maxResults || '10') }}",
            "user.fields": "{{ String(args.userFields || 'id,name,username,profile_image_url') }}"
          }
        },
        "timeoutMs": 15000
      }
    ]
  }
}
