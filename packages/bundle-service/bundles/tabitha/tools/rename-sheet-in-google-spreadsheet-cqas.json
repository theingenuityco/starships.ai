    "fromSlug": "rename-sheet-in-google-spreadsheet-cqas"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "tool": {
      "name": "Rename Sheet in Google Spreadsheet",
      "description": "Rename a sheet in a Google Spreadsheet using the Google Sheets API",
      "parameters": {
        "type": "object",
        "required": [
          "spreadsheetId",
          "sheetId",
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "The new title for the sheet"
          },
          "sheetId": {
            "type": "number",
            "description": "The ID of the sheet to rename"
          },
          "spreadsheetId": {
            "type": "string",
            "description": "The ID of the spreadsheet (found in the URL)"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "rename_sheet",
            "ref": "e1",
            "from": "start"
          },
          {
            "to": "format_response",
            "ref": "e2",
            "from": "rename_sheet"
          },
          {
            "to": "end",
            "ref": "e3",
            "from": "format_response"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start",
            "parameters": {}
          },
          {
            "ref": "rename_sheet",
            "name": "Rename Sheet",
            "type": "connector_action",
            "parameters": {
              "args": {
                "title": "{{ String(input.title) }}",
                "sheetId": "{{ Number(input.sheetId) }}",
                "spreadsheetId": "{{ String(input.spreadsheetId) }}"
              },
              "action": "rename-sheet",
              "timeout": 15000,
              "connector": "google-sheets",
              "failOnNon2xx": true
            }
          },
          {
            "ref": "format_response",
            "name": "Format Response",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const resp = ctx.lastOutputOf('rename_sheet') || {};\n  \n  if (!resp.body) {\n    throw new Error('No response body from Google Sheets API');\n  }\n  \n  return {\n    success: true,\n    sheetId: resp.body.sheetId,\n    title: resp.body.properties?.title,\n    index: resp.body.properties?.index\n  };\n}"
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end",
            "parameters": {}
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
