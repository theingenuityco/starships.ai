{
  "name": "@starships/models",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build tsconfig.json",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "clean": "rm -rf dist && find tests -name '*.js' -o -name '*.d.ts' -o -name '*.d.ts.map' -o -name '*.js.map' | xargs rm -f",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts --config ../../.eslintrc.cjs",
    "migrate": "tsx src/scripts/run-migration.ts",
    "migrate:stripe": "tsx src/scripts/run-stripe-migration.ts",
    "migrate:stripe-idempotency": "tsx src/scripts/run-stripe-webhook-idempotency-migrations.ts",
    "migrate:http-bridge": "tsx src/scripts/run-http-bridge-migration.ts",
    "validate-migration": "tsx src/scripts/validate-migration.ts",
    "validate-migration:report": "tsx src/scripts/validate-migration.ts --report",
    "validate-migration:full": "tsx src/scripts/validate-migration.ts --report --save --verbose",
    "seed:mcp": "tsx src/scripts/seed-mcp-servers.ts",
    "seed:llm": "tsx src/scripts/seed-llm-models.ts",
    "query:mcp": "tsx src/scripts/query-mcp-servers.ts",
    "test:migration": "tsx src/scripts/run-migration-tests.ts",
    "test:migration:empty": "tsx src/scripts/run-migration-tests.ts empty",
    "test:migration:single": "tsx src/scripts/run-migration-tests.ts single",
    "test:migration:large": "tsx src/scripts/run-migration-tests.ts large",
    "test:migration:concurrent": "tsx src/scripts/run-migration-tests.ts concurrent",
    "test:migration:rollback": "tsx src/scripts/run-migration-tests.ts rollback",
    "backup:create": "tsx src/scripts/backup-cli.ts create",
    "backup:restore": "tsx src/scripts/backup-cli.ts restore",
    "backup:validate": "tsx src/scripts/backup-cli.ts validate",
    "backup:help": "tsx src/scripts/backup-cli.ts help",
    "disaster:recovery": "tsx src/migrations/disaster-recovery.ts",
    "test:backup": "tsx src/scripts/test-backup-restore.ts",
    "migrate:starship-schema": "tsx src/scripts/migrate-starship-schema.ts",
    "migrate:starship-schema:dry-run": "tsx src/scripts/migrate-starship-schema.ts --dry-run",
    "migrate:starship-schema:rollback": "tsx src/scripts/migrate-starship-schema.ts --rollback",
    "cleanup:abandoned-starships": "tsx src/scripts/cleanup-abandoned-starships.ts",
    "cleanup:abandoned-starships:dry": "tsx src/scripts/cleanup-abandoned-starships.ts --dry-run"
  },
  "dependencies": {
    "@starships/protocol": "workspace:*",
    "fs-extra": "^11.3.0",
    "neo4j-driver": "^5.28.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.0.10",
    "@types/node-fetch": "^2.6.12",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.1.0",
    "node-fetch": "^2.7.0",
    "tsx": "^4.20.3"
  }
}
