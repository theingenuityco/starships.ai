  "payload": {
    "tool": {
      "name": "Get LinkedIn Member Statistics",
      "description": "Retrieve aggregated performance metrics for a LinkedIn member account across a date range. Select from impressions, reach, reactions, comments, or shares. Supports daily or total aggregation. (Personal/member accounts only)",
      "parameters": {
        "type": "object",
        "required": [
          "queryType"
        ],
        "properties": {
          "queryType": {
            "enum": [
              "IMPRESSION",
              "MEMBERS_REACHED",
              "RESHARE",
              "REACTION",
              "COMMENT"
            ],
            "type": "string",
            "description": "Metric type to retrieve"
          },
          "aggregation": {
            "enum": [
              "DAILY",
              "TOTAL"
            ],
            "type": "string",
            "default": "TOTAL",
            "description": "Aggregation type - DAILY for day-by-day breakdown or TOTAL for overall sum"
          },
          "dateRangeEnd": {
            "type": "object",
            "required": [
              "day",
              "month",
              "year"
            ],
            "properties": {
              "day": {
                "type": "number",
                "maximum": 31,
                "minimum": 1,
                "description": "Day of month (1-31)"
              },
              "year": {
                "type": "number",
                "description": "Year (e.g., 2026)"
              },
              "month": {
                "type": "number",
                "maximum": 12,
                "minimum": 1,
                "description": "Month (1-12)"
              }
            },
            "description": "End date for analytics range (defaults to today if not provided)"
          },
          "dateRangeStart": {
            "type": "object",
            "required": [
              "day",
              "month",
              "year"
            ],
            "properties": {
              "day": {
                "type": "number",
                "maximum": 31,
                "minimum": 1,
                "description": "Day of month (1-31)"
              },
              "year": {
                "type": "number",
                "description": "Year (e.g., 2026)"
              },
              "month": {
                "type": "number",
                "maximum": 12,
                "minimum": 1,
                "description": "Month (1-12)"
              }
            },
            "description": "Start date for analytics range (defaults to 30 days ago if not provided)"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "prepare_args",
            "ref": "start_to_prepare",
            "from": "start"
          },
          {
            "to": "get_analytics",
            "ref": "prepare_to_get",
            "from": "prepare_args"
          },
          {
            "to": "format_result",
            "ref": "get_to_end",
            "from": "get_analytics"
          },
          {
            "to": "end",
            "ref": "format_to_end",
            "from": "format_result"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start",
            "parameters": {}
          },
          {
            "ref": "prepare_args",
            "name": "Prepare Arguments",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const input = ctx.input;\n  \n  // Calculate default date ranges if not provided\n  const now = new Date();\n  const thirtyDaysAgo = new Date(now);\n  thirtyDaysAgo.setDate(now.getDate() - 30);\n  \n  const defaultEnd = {\n    day: now.getDate(),\n    month: now.getMonth() + 1,\n    year: now.getFullYear()\n  };\n  \n  const defaultStart = {\n    day: thirtyDaysAgo.getDate(),\n    month: thirtyDaysAgo.getMonth() + 1,\n    year: thirtyDaysAgo.getFullYear()\n  };\n  \n  return {\n    queryType: input.queryType,\n    aggregation: input.aggregation || 'TOTAL',\n    dateRangeStart: input.dateRangeStart || defaultStart,\n    dateRangeEnd: input.dateRangeEnd || defaultEnd\n  };\n}",
              "timeout": 3000
            }
          },
          {
            "ref": "get_analytics",
            "name": "Get LinkedIn Analytics",
            "type": "connector_action",
            "parameters": {
              "args": "{{ ctx.lastOutputOf('prepare_args') }}",
              "action": "get-aggregated-post-analytics",
              "timeout": 30000,
              "connector": "linkedin",
              "failOnNon2xx": true
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end",
            "parameters": {
              "output": "{{ ctx.lastOutputOf('format_result') }}"
            }
          },
          {
            "ref": "format_result",
            "name": "Format Result",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const raw = ctx.lastOutputOf('get_analytics')?.body?.elements?.[0];\n  if (!raw) return null;\n  \n  const metricType = Object.values(raw.metricType || {})[0] || 'UNKNOWN';\n  const start = raw.dateRange?.start;\n  const end = raw.dateRange?.end;\n  \n  return {\n    metricType,\n    count: raw.count,\n    startDate: start ? `${start.year}-${String(start.month).padStart(2, '0')}-${String(start.day).padStart(2, '0')}` : null,\n    endDate: end ? `${end.year}-${String(end.month).padStart(2, '0')}-${String(end.day).padStart(2, '0')}` : null\n  };\n}",
              "timeout": 3000
            }
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
  }
}
