      {
        "name": "delete-like",
        "description": "Unlike a post or comment. Removes a like from the specified LinkedIn social action (share, UGC post, or comment). The actor must be the same entity that created the like.",
        "method": "DELETE",
        "path": "/rest/socialActions/{postUrn}/likes/{actorUrn}",
