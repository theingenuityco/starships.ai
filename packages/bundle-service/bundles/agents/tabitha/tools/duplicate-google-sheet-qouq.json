{
  "schemaVersion": "1",
  "kind": "tool",
  "exportedAt": "2026-05-11T21:17:34.347Z",
  "metadata": {
    "fromSlug": "duplicate-google-sheet-qouq"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "tool": {
      "name": "Duplicate Google Sheet",
      "description": "Duplicate a sheet within a Google Spreadsheet or copy it to another spreadsheet using the Google Sheets API",
      "parameters": {
        "type": "object",
        "required": [
          "spreadsheetId",
          "sheetId"
        ],
        "properties": {
          "sheetId": {
            "type": "number",
            "description": "The ID of the sheet to duplicate"
          },
          "spreadsheetId": {
            "type": "string",
            "description": "The ID of the source spreadsheet (found in the URL)"
          },
          "destinationSpreadsheetId": {
            "type": "string",
            "description": "The ID of the destination spreadsheet (optional - if not provided, duplicates within the same spreadsheet)"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "duplicate_sheet",
            "ref": "e1",
            "from": "start"
          },
          {
            "to": "format_response",
            "ref": "e2",
            "from": "duplicate_sheet"
          },
          {
            "to": "end",
            "ref": "e3",
            "from": "format_response"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start",
            "parameters": {}
          },
          {
            "ref": "duplicate_sheet",
            "name": "Duplicate Sheet",
            "type": "connector_action",
            "parameters": {
              "args": {
                "sheetId": "{{ Number(input.sheetId) }}",
                "spreadsheetId": "{{ String(input.spreadsheetId) }}",
                "destinationSpreadsheetId": "{{ input.destinationSpreadsheetId ? String(input.destinationSpreadsheetId) : undefined }}"
              },
              "action": "duplicate-sheet",
              "timeout": 15000,
              "connector": "google-sheets",
              "failOnNon2xx": true
            }
          },
          {
            "ref": "format_response",
            "name": "Format Response",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const resp = ctx.lastOutputOf('duplicate_sheet') || {};\n  \n  if (!resp.body) {\n    throw new Error('No response body from Google Sheets API');\n  }\n  \n  return {\n    success: true,\n    sheetId: resp.body.sheetId,\n    title: resp.body.title,\n    index: resp.body.index,\n    gridProperties: resp.body.gridProperties\n  };\n}"
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end",
            "parameters": {}
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
  }
}
