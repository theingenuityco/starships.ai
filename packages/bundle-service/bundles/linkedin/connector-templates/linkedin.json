      {
        "name": "register-image-upload",
        "description": "Register an image upload and get upload URL",
        "method": "POST",
        "path": "/rest/assets",
        "parameters": {
          "type": "object",
          "required": [
            "owner"
          ],
          "properties": {
            "owner": {
              "type": "string",
              "description": "Owner URN (person or organization)"
            },
            "serviceRelationshipIdentifier": {
              "type": "string",
              "default": "urn:li:userGeneratedContent",
              "description": "Service relationship identifier"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "registerUploadRequest": "{{ ({ owner: String(args.owner), recipes: ['urn:li:digitalmediaRecipe:feedshare-image'], serviceRelationships: [{ identifier: String(args.serviceRelationshipIdentifier || 'urn:li:userGeneratedContent'), relationshipType: 'OWNER' }], supportedUploadMechanism: ['SYNCHRONOUS_UPLOAD'] }) }}"
          },
          "query": {
            "action": "registerUpload"
          },
          "headers": {
            "LinkedIn-Version": "202511",
            "X-Restli-Protocol-Version": "2.0.0"
          }
        }
      },
      {
        "name": "register-video-upload",
        "description": "Register a video upload and get upload URL",
        "method": "POST",
        "path": "/rest/assets",
        "parameters": {
          "type": "object",
          "required": [
            "owner"
          ],
          "properties": {
            "owner": {
              "type": "string",
              "description": "Owner URN (person or organization)"
            },
            "fileSize": {
              "type": "number",
              "description": "Video file size in bytes"
            },
            "uploadMechanism": {
              "enum": [
                "SINGLE_REQUEST_UPLOAD",
                "MULTIPART_UPLOAD"
              ],
              "type": "string",
              "default": "SINGLE_REQUEST_UPLOAD",
              "description": "Upload mechanism type"
            },
            "serviceRelationshipIdentifier": {
              "type": "string",
              "default": "urn:li:userGeneratedContent",
              "description": "Service relationship identifier"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "registerUploadRequest": {
              "owner": "{{ args.owner }}",
              "recipes": [
                "urn:li:digitalmediaRecipe:feedshare-video"
              ],
              "fileSize": "{{ args.fileSize }}",
              "serviceRelationships": [
                {
                  "identifier": "{{ args.serviceRelationshipIdentifier || 'urn:li:userGeneratedContent' }}",
                  "relationshipType": "OWNER"
                }
              ],
              "supportedUploadMechanism": [
                "{{ args.uploadMechanism || 'SINGLE_REQUEST_UPLOAD' }}"
              ]
            }
          },
          "query": {
            "action": "registerUpload"
          },
          "headers": {
            "LinkedIn-Version": "202511",
            "X-Restli-Protocol-Version": "2.0.0"
          }
        }
      },
      {
        "name": "create-reshare",
        "description": "Reshare an existing post",
        "method": "POST",
        "path": "/rest/posts",
        "parameters": {
          "type": "object",
          "required": [
            "author",
            "parentPostUrn"
          ],
          "properties": {
            "author": {
              "type": "string",
              "description": "Author URN (person or organization)"
            },
            "commentary": {
              "type": "string",
              "description": "Optional commentary for the reshare"
            },
            "visibility": {
              "enum": [
                "PUBLIC",
                "CONNECTIONS"
              ],
              "type": "string",
              "default": "PUBLIC",
              "description": "Post visibility"
            },
            "parentPostUrn": {
              "type": "string",
              "description": "URN of the post to reshare (e.g., urn:li:share:123 or urn:li:ugcPost:456)"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "author": "{{ args.author }}",
            "commentary": "{{ args.commentary }}",
            "visibility": "{{ args.visibility || 'PUBLIC' }}",
            "distribution": {
              "targetEntities": [],
              "feedDistribution": "MAIN_FEED",
              "thirdPartyDistributionChannels": []
            },
            "lifecycleState": "PUBLISHED",
            "reshareContext": {
              "parent": "{{ args.parentPostUrn }}"
            },
            "isReshareDisabledByAuthor": false
          },
          "headers": {
            "LinkedIn-Version": "202511",
            "X-Restli-Protocol-Version": "2.0.0"
          }
        }
      },
      {
        "name": "get-post-by-urn",
        "description": "Get a single post by its URN using the modern Posts API",
