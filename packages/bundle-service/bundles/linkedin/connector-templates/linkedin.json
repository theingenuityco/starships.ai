      {
        "name": "create-comment",
        "description": "Create a comment on a post. The postUrn is placed in the path according to LinkedIn's REST API specification.",
        "method": "POST",
        "path": "/rest/socialActions/{postUrn}/comments",
        "parameters": {
          "type": "object",
          "required": [
            "postUrn",
