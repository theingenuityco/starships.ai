{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "woocommerce",
    "fromSlug": "woocommerce",
    "fromId": "01kQ_h1M0Iwte3cxBMuUj"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "01kQ_h1M0Iwte3cxBMuUj",
      "slug": "woocommerce",
      "provider": "woocommerce",
      "name": "WooCommerce",
      "description": "E-commerce platform for managing products, orders, customers, and categories.",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "E-commerce & Marketplace",
      "baseUrl": "https://{shop_domain}/wp-json/wc/v3",
      "auth": {
        "type": "oauth2",
        "scopes": [
          "read",
          "write"
        ],
        "tokenUrl": "https://{shop_domain}/wp-json/oauth/token",
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        },
        "clientIdRef": {
          "key": "WOOCOMMERCE_OAUTH_CLIENT_ID",
          "type": "platform_secret"
        },
        "tokenResponse": {
          "scopeField": "scope",
          "expiresInField": "expires_in",
          "tokenTypeField": "token_type",
          "accessTokenField": "access_token",
          "refreshTokenField": "refresh_token"
        },
        "accessTokenRef": {
          "key": "WOOCOMMERCE_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "scopeDelimiter": " ",
        "clientSecretRef": {
          "key": "WOOCOMMERCE_OAUTH_CLIENT_SECRET",
          "type": "platform_secret"
        },
        "refreshTokenRef": {
          "key": "WOOCOMMERCE_REFRESH_TOKEN",
          "type": "connector_secret"
        },
        "authorizationUrl": "https://{shop_domain}/wp-json/wc-auth/v1/authorize"
      },
      "rateLimit": {
        "requestsPerSecond": 10
      }
    },
    "actions": [
      {
        "name": "list_orders",
        "description": "List all orders with filtering and pagination support",
        "method": "GET",
        "path": "/orders"
      },
      {
        "name": "list_products",
        "description": "List all products with filtering and pagination support",
        "method": "GET",
        "path": "/products"
      },
      {
        "name": "get_customer",
        "description": "Get detailed customer information by ID",
        "method": "GET",
        "path": "/customers/{customer_id}",
        "mapping": {
          "path": {
            "customer_id": "{{ String(args.customer_id) }}"
          }
        }
      },
      {
        "name": "get_order",
        "description": "Get detailed order information by ID",
        "method": "GET",
        "path": "/orders/{order_id}",
        "mapping": {
          "path": {
            "order_id": "{{ String(args.order_id) }}"
          }
        }
      },
      {
        "name": "get_product",
        "description": "Get detailed product information by ID",
        "method": "GET",
        "path": "/products/{product_id}",
        "mapping": {
          "path": {
            "product_id": "{{ String(args.product_id) }}"
          }
        }
      },
      {
        "name": "get_category",
        "description": "Get detailed category information by ID",
        "method": "GET",
        "path": "/products/categories/{category_id}",
        "mapping": {
          "path": {
            "category_id": "{{ String(args.category_id) }}"
          }
        }
      },
      {
        "name": "list_categories",
        "description": "List all product categories with filtering and pagination",
        "method": "GET",
        "path": "/products/categories"
      },
      {
        "name": "list_customers",
        "description": "List all customers with filtering and pagination support",
        "method": "GET",
        "path": "/customers"
      }
    ]
  }
}
