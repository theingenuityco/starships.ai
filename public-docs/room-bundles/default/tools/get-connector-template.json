          },
          {
            "ref": "get_template",
            "name": "Get Template",
            "type": "connector_action",
            "parameters": {
              "args": "{{ input }}",
              "action": "admin-get-connector-template",
              "timeout": 5000,
              "connector": "starships"
            },
            "description": "Get connector template by ID via Starships connector"
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end",
