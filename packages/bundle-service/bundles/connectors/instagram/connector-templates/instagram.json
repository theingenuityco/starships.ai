        "method": "GET",
        "path": "/{instagram_account_id}/media",
        "parameters": {
          "type": "object",
          "required": [],
          "properties": {
            "after": {
              "type": "string",
              "description": "Cursor for next page of results"
            },
            "limit": {
              "type": "number",
              "default": 25,
              "description": "Number of media objects to return (max 100)"
            },
            "before": {
              "type": "string",
              "description": "Cursor for previous page of results"
            },
            "fields": {
              "type": "string",
              "description": "Comma-separated list of fields to retrieve"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "path": {
            "instagram_account_id": "{{ String(metadata.user_id) }}"
          },
          "query": {
            "after": "{{ args.after }}",
            "limit": "{{ String(args.limit || '25') }}",
            "before": "{{ args.before }}",
            "fields": "{{ String(args.fields || 'id,caption,media_type,media_url,permalink,timestamp,like_count,comments_count') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "discover-account-id",
        "description": "Discover Instagram Business Account ID(s) via /me/accounts (Facebook Graph). Returns pages with instagram_business_account field when available.",
        "method": "GET",
        "path": "/me/accounts",
        "parameters": {
          "type": "object",
          "properties": {
