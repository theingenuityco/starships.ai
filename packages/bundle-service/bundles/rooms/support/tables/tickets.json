{
  "schemaVersion": "1",
  "kind": "table",
  "exportedAt": "2026-05-28T00:00:00.000Z",
  "metadata": {
    "fromSlug": "tickets",
    "fromStarshipSlug": "starborn-support"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "table": {
      "name": "Tickets",
      "description": "Inbound customer support tickets the Support room triages and resolves.",
      "columns": [
        {
          "name": "ticket_id",
          "type": "number",
          "constraints": {
            "unique": true,
            "autoincrement": true
          },
          "description": "Internal id"
        },
        {
          "name": "external_id",
          "type": "string",
          "description": "Upstream helpdesk ticket id (e.g. Freshdesk)"
        },
        {
          "name": "customer_name",
          "type": "string",
          "constraints": {
            "required": true
          },
          "description": "Customer display name"
        },
        {
          "name": "customer_email",
          "type": "string",
          "description": "Reply-to email"
        },
        {
          "name": "subject",
          "type": "string",
          "constraints": {
            "required": true
          },
          "description": "Short subject line"
        },
        {
          "name": "message",
          "type": "text",
          "description": "Original ticket body"
        },
        {
          "name": "status",
          "type": "enum",
          "enum": {
            "options": ["NEW", "TRIAGED", "RESOLVED"]
          },
          "constraints": {
            "required": true
          },
          "description": "Lifecycle stage"
        },
        {
          "name": "priority",
          "type": "enum",
          "enum": {
            "options": ["low", "medium", "high"]
          },
          "description": "Triaged priority"
        },
        {
          "name": "category",
          "type": "enum",
          "enum": {
            "options": ["bug", "feature", "billing", "auth", "other"]
          },
          "description": "Triaged category"
        },
        {
          "name": "tags",
          "type": "string",
          "description": "Comma-separated triage tags"
        },
        {
          "name": "linked_engineering_card",
          "type": "string",
          "description": "Optional reference to an engineering pipeline card"
        },
        {
          "name": "created_at",
          "type": "datetime",
          "description": "When the ticket arrived"
        },
        {
          "name": "resolved_at",
          "type": "datetime",
          "description": "When the ticket was resolved"
        }
      ],
      "primaryKey": "ticket_id"
    },
    "rows": []
  }
}
