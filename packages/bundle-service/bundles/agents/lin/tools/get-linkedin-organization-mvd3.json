  "payload": {
    "tool": {
      "name": "Get LinkedIn Organization",
      "description": "Fetches LinkedIn organization details by vanity name (e.g., 'microsoft', 'google'). Returns organization information including ID, name, description, and other metadata.",
      "parameters": {
        "type": "object",
        "required": [
          "vanityName"
        ],
        "properties": {
          "vanityName": {
            "type": "string",
            "description": "Organization vanity name (e.g., 'microsoft', 'linkedin', 'google')"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "get_org",
            "ref": "start_to_get_org",
            "from": "start"
          },
          {
            "to": "transform_org_data",
            "ref": "get_org_to_transform",
            "from": "get_org"
          },
          {
            "to": "end",
            "ref": "transform_to_end",
            "from": "transform_org_data"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start",
            "parameters": {}
          },
          {
            "ref": "get_org",
            "name": "Get Organization by Vanity Name",
            "type": "connector_action",
            "parameters": {
              "args": "{{ input }}",
              "action": "get-organization-by-vanity",
              "timeout": 15000,
              "connector": "linkedin",
              "failOnNon2xx": true
            }
          },
          {
            "ref": "transform_org_data",
            "name": "Transform Organization Data",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const response = ctx.input?.body || {};\n  const elements = response.elements || [];\n  \n  if (elements.length === 0) {\n    throw new Error('Organization not found');\n  }\n  \n  const org = elements[0];\n  \n  // Return only essential organization data\n  return {\n    id: org.id,\n    name: org.localizedName || org.name,\n    vanityName: org.vanityName,\n    description: org.localizedDescription || org.description,\n    website: org.websiteUrl,\n    industry: org.localizedIndustry,\n    followerCount: org.followerCount,\n    staffCount: org.staffCount,\n    organizationType: org.organizationType,\n    logo: org.logoV2?.original,\n    coverPhoto: org.coverPhotoV2?.original\n  };\n}",
              "timeout": 3000
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end",
            "parameters": {
              "output": "{{ lastOutputOf('transform_org_data') }}"
            }
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
