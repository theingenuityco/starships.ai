# Sandbox image for native code execution (Backlog Execution Room).
# Same build as the runner, but the runtime stage adds git + common toolchains
# and the entrypoint runs the JobAgent (one process per workspace job).
FROM node:20-slim AS build
WORKDIR /app
ARG TARGETARCH
ARG BUF_VERSION=v1.45.0
RUN npm i -g pnpm
RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY tsconfig.json tsconfig.nodejs.json ./
COPY packages/autopilot/package.json ./packages/autopilot/package.json
COPY packages/autopilot-cli/package.json ./packages/autopilot-cli/package.json
COPY packages/connectors/package.json ./packages/connectors/package.json
COPY packages/protocol/package.json ./packages/protocol/package.json
COPY packages/autopilot-runner/package.json ./packages/autopilot-runner/package.json
RUN echo "node-linker=hoisted" >> packages/autopilot-runner/.npmrc \
  && pnpm install -w --filter @starships/autopilot --filter @starships/autopilot-cli --filter @starships/connectors --filter @starships/protocol --filter @starships/autopilot-runner --frozen-lockfile
COPY packages/autopilot/ ./packages/autopilot/
COPY packages/autopilot-cli/ ./packages/autopilot-cli/
COPY packages/connectors/ ./packages/connectors/
COPY packages/protocol/ ./packages/protocol/
COPY packages/autopilot-runner/ ./packages/autopilot-runner/
RUN pnpm -C packages/autopilot build
RUN pnpm -C packages/protocol build
RUN pnpm -C packages/connectors build
RUN pnpm -C packages/autopilot-cli build
RUN set -eux; \
  case "${TARGETARCH}" in \
    amd64) BUF_ARCH="x86_64" ;; \
    arm64) BUF_ARCH="aarch64" ;; \
    *) echo "Unsupported TARGETARCH=${TARGETARCH} (expected amd64 or arm64)"; exit 1 ;; \
  esac; \
  curl -fsSL -o /usr/local/bin/buf "https://github.com/bufbuild/buf/releases/download/${BUF_VERSION}/buf-Linux-${BUF_ARCH}"; \
  chmod +x /usr/local/bin/buf; \
  buf --version; \
  pnpm -C packages/autopilot-runner gen; \
  pnpm -C packages/autopilot-runner build

FROM node:20-slim
WORKDIR /app/packages/autopilot-runner
ENV NODE_ENV=production
# Toolchains needed to clone repos and run typical JS/TS test suites.
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable
COPY --from=build /app/packages/autopilot-runner/dist ./dist
COPY --from=build /app/packages/autopilot-runner/node_modules ./node_modules
RUN mkdir -p /app/packages/autopilot
COPY --from=build /app/packages/autopilot/package.json /app/packages/autopilot/package.json
COPY --from=build /app/packages/autopilot/dist /app/packages/autopilot/dist
COPY --from=build /app/packages/autopilot/node_modules /app/packages/autopilot/node_modules
RUN mkdir -p /app/packages/protocol
COPY --from=build /app/packages/protocol/package.json /app/packages/protocol/package.json
COPY --from=build /app/packages/protocol/dist /app/packages/protocol/dist
COPY --from=build /app/packages/protocol/node_modules /app/packages/protocol/node_modules
RUN mkdir -p /app/packages/connectors
COPY --from=build /app/packages/connectors/package.json /app/packages/connectors/package.json
COPY --from=build /app/packages/connectors/dist /app/packages/connectors/dist
COPY --from=build /app/packages/connectors/node_modules /app/packages/connectors/node_modules
RUN mkdir -p /app/packages/autopilot-cli
COPY --from=build /app/packages/autopilot-cli/package.json /app/packages/autopilot-cli/package.json
COPY --from=build /app/packages/autopilot-cli/dist /app/packages/autopilot-cli/dist
COPY --from=build /app/packages/autopilot-cli/node_modules /app/packages/autopilot-cli/node_modules
COPY --from=build /app/node_modules /app/node_modules
# Unprivileged. The launcher passes JOB_FILE + WORKSPACE_BASE_DIR and mounts a
# writable /workspace and a read-only /job/job.json.
USER 1000:1000
CMD ["node", "dist/jobAgent/JobAgent.js"]
