        "tokenUrl": "https://oauth2.googleapis.com/token",
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        },
        "clientIdRef": {
          "key": "GOOGLE_SHEETS_CLIENT_ID",
          "type": "platform_secret"
        },
        "tokenResponse": {
          "expiresInField": "expires_in",
          "tokenTypeField": "token_type",
          "accessTokenField": "access_token",
          "refreshTokenField": "refresh_token"
        },
        "accessTokenRef": {
          "key": "GOOGLE_SHEETS_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "scopeDelimiter": " ",
        "clientSecretRef": {
          "key": "GOOGLE_SHEETS_CLIENT_SECRET",
          "type": "platform_secret"
        },
        "refreshTokenRef": {
          "key": "GOOGLE_SHEETS_REFRESH_TOKEN",
          "type": "connector_secret"
        },
        "authorizationUrl": "https://accounts.google.com/o/oauth2/v2/auth",
        "extraAuthorizeParams": {
          "prompt": "consent",
          "access_type": "offline"
        }
      },
      "rateLimit": {
        "burstLimit": 60,
        "requestsPerMinute": 300
      },
      "metadataSchema": {
        "type": "object",
        "properties": {
          "defaultRange": {
            "type": "string",
            "description": "Default sheet range (e.g., 'Leads!A:H')"
          },
          "spreadsheetId": {
            "type": "string",
            "description": "Default Google Sheet ID for this connector instance"
          }
        }
      }
    },
    "actions": [
      {
        "name": "rename-sheet",
        "description": "Rename a sheet in a spreadsheet",
        "method": "POST",
        "path": "/{spreadsheetId}:batchUpdate",
        "parameters": {
          "type": "object",
          "required": [
            "spreadsheetId",
            "sheetId",
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "description": "The new title for the sheet"
            },
            "sheetId": {
              "type": "number",
              "description": "The ID of the sheet to rename"
            },
            "spreadsheetId": {
              "type": "string",
              "description": "The ID of the spreadsheet"
            }
          }
        },
        "mapping": {
          "path": {
            "spreadsheetId": "{{ String(args.spreadsheetId) }}"
          },
          "rawBody": "{{ JSON.stringify({ requests: [{ updateSheetProperties: { properties: { sheetId: Number(args.sheetId), title: String(args.title) }, fields: 'title' } }] }) }}"
        },
        "response": {
          "select": "{{ body }}"
        },
        "timeoutMs": 15000
      },
      {
        "name": "create-sheet",
        "description": "Create a new sheet in a spreadsheet",
        "method": "POST",
        "path": "/{spreadsheetId}:batchUpdate",
        "parameters": {
          "type": "object",
          "required": [
            "spreadsheetId",
            "title"
          ],
          "properties": {
            "index": {
              "type": "number",
              "description": "Position of the new sheet (optional, 0-based)"
            },
            "title": {
              "type": "string",
              "description": "Title for the new sheet"
            },
            "spreadsheetId": {
              "type": "string",
              "description": "The ID of the spreadsheet"
            }
          }
        },
        "mapping": {
          "path": {
            "spreadsheetId": "{{ String(args.spreadsheetId) }}"
          },
          "rawBody": "{{ JSON.stringify({ requests: [{ addSheet: { properties: args.index !== undefined ? { title: String(args.title), index: Number(args.index) } : { title: String(args.title) } } }] }) }}"
        },
        "timeoutMs": 15000
      },
      {
        "name": "delete-sheet",
        "description": "Delete a sheet from a spreadsheet",
        "method": "POST",
        "path": "/{spreadsheetId}:batchUpdate",
        "parameters": {
          "type": "object",
          "required": [
            "spreadsheetId",
            "sheetId"
          ],
          "properties": {
            "sheetId": {
              "type": "number",
              "description": "The ID of the sheet to delete"
            },
            "spreadsheetId": {
              "type": "string",
              "description": "The ID of the spreadsheet"
            }
          }
        },
        "mapping": {
          "body": {
            "requests": [
              {
                "deleteSheet": {
                  "sheetId": "{{ Number(args.sheetId) }}"
                }
              }
            ]
          },
          "path": {
            "spreadsheetId": "{{ String(args.spreadsheetId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "append-rows",
        "description": "Append rows to a Google Sheet",
        "method": "POST",
        "path": "/{spreadsheetId}/values/{range}:append",
        "parameters": {
          "type": "object",
          "required": [
            "spreadsheetId",
            "range",
            "values"
          ],
          "properties": {
            "range": {
              "type": "string",
              "description": "The range to append to (e.g., 'Sheet1!A:Z')"
            },
            "values": {
              "type": "array",
              "description": "Array of rows to append, where each row is an array of values"
            },
            "spreadsheetId": {
              "type": "string",
              "description": "The ID of the spreadsheet"
            }
          }
        },
        "mapping": {
          "body": {
            "values": "{{ args.values }}"
          },
          "path": {
            "range": "{{ String(args.range) }}",
            "spreadsheetId": "{{ String(args.spreadsheetId) }}"
          },
          "query": {
            "valueInputOption": "USER_ENTERED"
          }
        },
        "timeoutMs": 15000
      },
