        "mapping": {
          "body": {
            "registerUploadRequest": "{{ ({ owner: String(args.uploadOwner), recipes: ['urn:li:digitalmediaRecipe:feedshare-video'], serviceRelationships: [{ identifier: String(args.serviceRelationshipIdentifier || 'urn:li:userGeneratedContent'), relationshipType: 'OWNER' }], supportedUploadMechanism: ['SYNCHRONOUS_UPLOAD'] }) }}"
          },
          "query": {
            "action": "registerUpload"
          },
          "headers": {
