{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["**/.env.*local", ".env"],
  "globalEnv": [
    "NODE_ENV",
    "NODE_OPTIONS",
    "POSTGRES_HOST",
    "POSTGRES_PORT",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DATABASE",
    "POSTGRES_SSL",
    "STRIPE_SECRET_KEY",
    "STRIPE_PUBLISHABLE_KEY",
    "GA_MEASUREMENT_ID",
    "PUBLIC_URL",
    "CLIENT_URL",
    "SERVER_URL",
    "DOCS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "@starships/protocol#build": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**"]
    },
    "@starships/errors#build": {
      "dependsOn": ["@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**"]
    },
    "@starships/models#build": {
      "dependsOn": ["@starships/env#build", "@starships/errors#build", "@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**"]
    },
    "@starships/server#build": {
      "dependsOn": [
        "@starships/errors#build",
        "@starships/models#build",
        "@starships/protocol#build"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**"]
    },
    "@starships/env#build": {
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**"]
    },
    "@starships/agent-runtime#build": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**"]
    },
    "@starships/agent-runtime#type-check": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "@starships/agent-runtime#lint": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc.*", "eslint.config.*"],
      "outputs": []
    },
    "@starships/mcp-server#build": {
      "dependsOn": [
        "@starships/errors#build",
        "@starships/models#build",
        "@starships/protocol#build"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**"]
    },
    "@starships/mcp-server#type-check": {
      "dependsOn": [
        "@starships/errors#build",
        "@starships/models#build",
        "@starships/protocol#build"
      ],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "@starships/reverse-proxy#build": {
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**"]
    },
    "@starships/docs#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": [".next/**", "build/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@starships/models#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@starships/reverse-proxy#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@starships/server#dev": {
      "dependsOn": ["@starships/server#build"],
      "cache": false,
      "persistent": true
    },
    "@starships/docs#dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc.*", "eslint.config.*"],
      "outputs": []
    },
    "@starships/client#lint": {
      "dependsOn": ["@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc.*", "eslint.config.*"],
      "outputs": []
    },
    "@starships/server#lint": {
      "dependsOn": [
        "@starships/errors#build",
        "@starships/models#build",
        "@starships/protocol#build"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc.*", "eslint.config.*"],
      "outputs": []
    },
    "@starships/errors#lint": {
      "dependsOn": ["@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc.*", "eslint.config.*"],
      "outputs": []
    },
    "@starships/models#lint": {
      "dependsOn": ["@starships/env#build", "@starships/errors#build", "@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc.*", "eslint.config.*"],
      "outputs": []
    },
    "@starships/docs#lint": {
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc.*", "eslint.config.*"],
      "outputs": []
    },
    "@starships/env#type-check": {
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "@starships/protocol#type-check": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "@starships/models#type-check": {
      "dependsOn": ["@starships/env#build", "@starships/errors#build", "@starships/protocol#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "../../packages/env/dist/**",
        "../../packages/errors/dist/**",
        "../../packages/protocol/dist/**"
      ],
      "outputs": []
    },
    "@starships/server#type-check": {
      "dependsOn": [
        "@starships/errors#build",
        "@starships/models#build",
        "@starships/protocol#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "../../packages/errors/dist/**",
        "../../packages/models/dist/**",
        "../../packages/protocol/dist/**"
      ],
      "outputs": []
    },
    "@starships/client#type-check": {
      "dependsOn": ["@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "../../packages/protocol/dist/**"],
      "outputs": []
    },
    "@starships/errors#type-check": {
      "dependsOn": ["@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "../../packages/protocol/dist/**"],
      "outputs": []
    },
    "@starships/reverse-proxy#type-check": {
      "dependsOn": ["@starships/env#build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "../../packages/env/dist/**"],
      "outputs": []
    },
    "@starships/docs#type-check": {
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "type-check": {
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "@starships/models#test": {
      "dependsOn": ["@starships/env#build", "@starships/errors#build", "@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "**/*.test.*", "**/__tests__/**"],
      "outputs": []
    },
    "@starships/errors#test": {
      "dependsOn": ["@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "**/*.test.*", "**/__tests__/**"],
      "outputs": []
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "**/*.test.*", "**/__tests__/**"],
      "outputs": []
    },
    "clean": {
      "cache": false,
      "outputs": []
    }
  }
}
