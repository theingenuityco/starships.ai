    "actions": [
      {
        "name": "initialize-image-upload",
        "description": "Initialize image upload using the modern LinkedIn /rest/images API (LinkedIn-Version: 202511). Returns urn:li:image:... URN and uploadUrl. Use this for both member and org posts with the modern /rest/posts API.",
        "method": "POST",
        "path": "/rest/images",
        "parameters": {
          "type": "object",
          "required": [
            "owner"
          ],
          "properties": {
            "owner": {
              "type": "string",
              "description": "Owner URN (urn:li:person:... for member uploads, even when posting to an org)"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "initializeUploadRequest": "{{ ({ owner: String(args.owner) }) }}"
          },
          "query": {
            "action": "initializeUpload"
          },
          "headers": {
            "LinkedIn-Version": "202511",
            "X-Restli-Protocol-Version": "2.0.0"
          }
        }
      },
      {
        "name": "create-member-post",
        "description": "Create a new post as member (person) with optional media or article, via LinkedIn /rest/posts (LinkedIn-Version: 202511).",
        "method": "POST",
        "path": "/rest/posts",
        "parameters": {
          "type": "object",
          "required": [
            "author"
          ],
          "properties": {
            "author": {
              "type": "string",
              "description": "Author URN (person URN, e.g., urn:li:person:12345)"
            },
            "imageUrls": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Array of direct image URLs (alternative to attachmentIds)"
            },
            "commentary": {
              "type": "string",
              "description": "Text content for the post"
            },
            "visibility": {
              "enum": [
                "PUBLIC",
                "CONNECTIONS"
              ],
              "type": "string",
              "default": "PUBLIC",
              "description": "Post visibility"
            },
            "attachmentIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Array of attachment IDs from media registration (e.g., ['G0DfipyVULzvya3_5_1Q0'])"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "author": "{{ args.author }}",
            "content": "{{ (() => { const hasMedia = Array.isArray(args.attachmentIds) && args.attachmentIds.length > 0 && String(args.attachmentIds[0] || '').trim(); const hasArticle = args.content && typeof args.content === 'object'; if (hasArticle) return args.content; if (hasMedia) return { media: { id: String(args.attachmentIds[0]) } }; return undefined; })() }}",
            "commentary": "{{ args.commentary }}",
            "visibility": "{{ args.visibility || 'PUBLIC' }}",
            "distribution": {
              "targetEntities": [],
              "feedDistribution": "MAIN_FEED",
              "thirdPartyDistributionChannels": []
            },
            "lifecycleState": "PUBLISHED",
            "isReshareDisabledByAuthor": false
          },
          "headers": {
            "LinkedIn-Version": "202511",
            "X-Restli-Protocol-Version": "2.0.0"
          }
        }
      },
      {
        "name": "register-organization-image-upload",
        "description": "Register an image upload for organization posts. The upload must be registered with a member URN (uploadOwner), but the resulting attachment can be used in organization posts.",
        "method": "POST",
        "path": "/rest/assets",
        "parameters": {
          "type": "object",
          "required": [
            "uploadOwner"
          ],
          "properties": {
            "uploadOwner": {
              "type": "string",
              "description": "Member URN (urn:li:person:...) that will own the asset registration. Required for organization image posts due to LinkedIn API constraints."
            },
            "serviceRelationshipIdentifier": {
              "type": "string",
              "default": "urn:li:userGeneratedContent",
              "description": "Service relationship identifier"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "registerUploadRequest": "{{ ({ owner: String(args.uploadOwner), recipes: ['urn:li:digitalmediaRecipe:feedshare-image'], serviceRelationships: [{ identifier: String(args.serviceRelationshipIdentifier || 'urn:li:userGeneratedContent'), relationshipType: 'OWNER' }], supportedUploadMechanism: ['SYNCHRONOUS_UPLOAD'] }) }}"
          },
          "query": {
            "action": "registerUpload"
          },
          "headers": {
            "LinkedIn-Version": "202511",
            "X-Restli-Protocol-Version": "2.0.0"
          }
        }
      },
      {
        "name": "register-organization-video-upload",
        "description": "Register a video upload for organization posts. The upload must be registered with a member URN (uploadOwner), but the resulting attachment can be used in organization posts.",
        "method": "POST",
        "path": "/rest/assets",
        "parameters": {
          "type": "object",
          "required": [
            "uploadOwner"
          ],
          "properties": {
            "uploadOwner": {
              "type": "string",
