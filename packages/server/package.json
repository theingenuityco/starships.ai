{
  "name": "@starships/server",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-node-snapshot tsx watch --include ../../.env src/index.ts",
    "build": "rm -rf dist && rm -f tsconfig.tsbuildinfo && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "NODE_OPTIONS=--no-node-snapshot node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=4096' jest"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.906.0",
    "@lezer/common": "^1.2.1",
    "@lezer/json": "^1.0.3",
    "@sentry/node": "^10.27.0",
    "@starships/env": "workspace:*",
    "@starships/errors": "workspace:*",
    "@starships/models": "workspace:*",
    "@starships/protocol": "workspace:*",
    "@types/cookie-parser": "^1.4.9",
    "@types/lodash": "^4.17.20",
    "axios": "^1.15.2",
    "axios-retry": "^4.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.1.0",
    "express": "^5.2.0",
    "express-rate-limit": "^7.5.1",
    "fast-json-patch": "^3.1.1",
    "googleapis": "^161.0.0",
    "jose": "^6.0.11",
    "lodash": "^4.18.1",
    "nanoid": "^5.1.5",
    "ws": "^8.20.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^6.0.0",
    "@types/jest": "^29.5.13",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.6",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3"
  }
}
