            },
            "actorUrn": {
              "type": "string",
              "description": "Actor URN that created the like (e.g., urn:li:person:abc123 or urn:li:organization:123456). Must be the same entity that created the like. Will be URL-encoded automatically when placed in the path."
            }
          },
          "additionalProperties": false
