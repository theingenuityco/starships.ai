              "type": "string",
              "description": "Filter by state"
            },
            "per_page": {
              "type": "integer",
              "description": "Items per page"
            }
          }
        },
        "mapping": {
          "path": {
            "id": "{{ String(args.id) }}"
          },
          "query": {
            "page": "{{ String(args.page || 1) }}",
            "state": "{{ args.state || 'opened' }}",
            "per_page": "{{ String(args.per_page || 20) }}"
          }
        },
        "timeoutMs": 15000
