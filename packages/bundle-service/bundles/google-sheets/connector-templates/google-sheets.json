      {
        "name": "insert-rows",
        "description": "Insert rows at a specific position in a sheet",
        "method": "POST",
        "path": "/{spreadsheetId}:batchUpdate",
        "parameters": {
          "type": "object",
          "required": [
            "spreadsheetId",
            "sheetId",
            "index",
            "count"
          ],
          "properties": {
            "count": {
              "type": "number",
              "description": "Number of rows to insert"
            },
            "index": {
              "type": "number",
              "description": "The index where rows will be inserted (0-based)"
            },
            "sheetId": {
              "type": "number",
              "description": "The sheet ID where rows will be inserted"
            },
            "spreadsheetId": {
              "type": "string",
              "description": "The ID of the spreadsheet"
            }
          }
        },
        "mapping": {
          "body": {
            "requests": [
              {
                "insertDimension": {
                  "range": {
                    "sheetId": "{{ Number(args.sheetId) }}",
                    "endIndex": "{{ Number(args.index) + Number(args.count) }}",
                    "dimension": "ROWS",
                    "startIndex": "{{ Number(args.index) }}"
                  }
                }
              }
            ]
          },
          "path": {
            "spreadsheetId": "{{ String(args.spreadsheetId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create-spreadsheet",
        "description": "Create a new Google Spreadsheet",
        "method": "POST",
        "path": "/files",
        "baseUrlOverride": "https://www.googleapis.com/drive/v3",
        "parameters": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "The name of the new spreadsheet"
            },
            "parents": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional folder IDs where the spreadsheet should be created"
            }
          }
        },
        "mapping": {
          "body": {
            "name": "{{ String(args.name) }}",
            "parents": "{{ args.parents ? args.parents : undefined }}",
            "mimeType": "application/vnd.google-apps.spreadsheet"
          }
        },
        "response": {
          "select": "{{ body }}"
        },
        "timeoutMs": 20000
      },
      {
        "name": "delete-rows",
