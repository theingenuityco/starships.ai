            "ref": "build_widget_meta",
            "name": "Build Widget Meta",
            "type": "code",
            "parameters": {
              "code": "\n            async function main(ctx) {\n              const starshipId = ctx.env('STARSHIP_ID');\n              if (!starshipId || typeof starshipId !== 'string' || !starshipId.trim()) throw new Error('STARSHIP_ID is required');\n\n              const slug = 'starship-details';\n              const widgetType = 'StarshipDetails';\n              const props = { starshipId: String(starshipId).trim() };\n\n              return {\n                starshipId: String(starshipId).trim(),\n                slug,\n                widgetType,\n                props,\n                name: 'Starship details',\n                description: 'View and update your starship name, description, and website URL',\n              };\n            }\n          ",
              "timeout": 3000
            },
            "description": "Build deterministic slug + widget payload for this starship"
          },
          {
            "ref": "search_widgets",
            "name": "Search Widgets",
            "type": "connector_action",
            "parameters": {
              "args": {
                "slug": "{{ (lastOutputOf(\"build_widget_meta\") || {}).slug }}",
                "limit": 1,
                "starshipId": "{{ (lastOutputOf(\"build_widget_meta\") || {}).starshipId }}"
              },
              "action": "search-widgets",
              "timeout": 5000,
              "connector": "starships",
              "failOnNon2xx": true
            },
            "description": "Look up existing widget by deterministic slug"
          },
          {
            "ref": "extract_found_widget",
            "name": "Extract Found Widget",
            "type": "code",
            "parameters": {
              "code": "\n            async function main(ctx) {\n              const raw = ctx.input;\n              const hasBody = raw && typeof raw === 'object' && Object.prototype.hasOwnProperty.call(raw, 'body');\n              const payload = hasBody ? raw.body : raw;\n              const data = (payload && typeof payload === 'object' && Object.prototype.hasOwnProperty.call(payload, 'data')) ? payload.data : payload;\n              const widgets = Array.isArray(data) ? data : (data && typeof data === 'object' && Array.isArray(data.widgets)) ? data.widgets : null;\n              if (!widgets || !Array.isArray(widgets) || widgets.length === 0) return null;\n              return widgets[0];\n            }\n          ",
              "timeout": 2000
            },
            "description": "Extract first widget if it exists, else null"
          },
