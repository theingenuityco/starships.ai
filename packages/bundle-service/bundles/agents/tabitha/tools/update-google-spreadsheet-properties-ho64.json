  "payload": {
    "tool": {
      "name": "Update Google Spreadsheet Properties",
      "description": "Update Google Spreadsheet properties like title, locale, time zone, and auto-recalc settings using the Google Sheets API",
      "parameters": {
        "type": "object",
        "required": [
          "spreadsheetId"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Update the spreadsheet title (optional)"
          },
          "locale": {
            "type": "string",
            "description": "Update the locale, e.g., 'en_US', 'fr_FR' (optional)"
          },
          "timeZone": {
            "type": "string",
            "description": "Update the time zone, e.g., 'America/New_York' (optional)"
          },
          "autoRecalc": {
            "enum": [
              "RECALCULATE_ON_CHANGE",
              "RECALCULATE_ON_CHANGE_DELAYED",
              "RECALCULATE_NEVER"
            ],
            "type": "string",
            "description": "Update auto-recalculation behavior (optional)"
          },
          "spreadsheetId": {
            "type": "string",
            "description": "The ID of the spreadsheet (found in the URL)"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "update_properties",
            "ref": "e1",
            "from": "start"
          },
          {
            "to": "format_response",
            "ref": "e2",
            "from": "update_properties"
          },
          {
            "to": "end",
            "ref": "e3",
            "from": "format_response"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start",
            "parameters": {}
          },
          {
            "ref": "update_properties",
            "name": "Update Spreadsheet Properties",
            "type": "connector_action",
            "parameters": {
              "args": {
                "title": "{{ input.title ? String(input.title) : undefined }}",
                "locale": "{{ input.locale ? String(input.locale) : undefined }}",
                "timeZone": "{{ input.timeZone ? String(input.timeZone) : undefined }}",
                "autoRecalc": "{{ input.autoRecalc ? String(input.autoRecalc) : undefined }}",
                "spreadsheetId": "{{ String(input.spreadsheetId) }}"
              },
              "action": "update-spreadsheet-properties",
              "timeout": 15000,
              "connector": "google-sheets",
              "failOnNon2xx": true
            }
          },
          {
            "ref": "format_response",
            "name": "Format Response",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const resp = ctx.lastOutputOf('update_properties') || {};\n  \n  if (!resp.body) {\n    throw new Error('No response body from Google Sheets API');\n  }\n  \n  return {\n    success: true,\n    spreadsheetId: resp.body.spreadsheetId,\n    properties: resp.body.properties\n  };\n}"
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end",
            "parameters": {}
          }
        ]
      },
