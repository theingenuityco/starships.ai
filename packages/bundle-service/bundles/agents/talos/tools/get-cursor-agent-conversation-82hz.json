  },
  "payload": {
    "tool": {
      "name": "Get Cursor Agent Conversation",
      "description": "Retrieve the complete conversation history of a Cursor cloud agent, including all user prompts and assistant responses. Note: Cannot access conversations of deleted agents.",
      "parameters": {
        "type": "object",
        "required": [
          "agentId"
        ],
        "properties": {
          "agentId": {
            "type": "string",
            "description": "Unique identifier for the cloud agent (e.g., bc_abc123)"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "validate",
            "ref": "e1",
            "from": "start"
          },
          {
            "to": "get_conversation",
            "ref": "e2",
            "from": "validate"
          },
          {
            "to": "extract_body",
            "ref": "e3",
            "from": "get_conversation"
          },
          {
            "to": "end",
            "ref": "e4",
            "from": "extract_body"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start",
            "parameters": {}
          },
          {
            "ref": "validate",
            "name": "Validate Input",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const input = ctx.input || {};\n  const agentId = input.agentId;\n  if (!agentId || typeof agentId !== 'string') {\n    throw new Error('agentId is required');\n  }\n  return { id: agentId };\n}\n",
              "timeout": 3000
            }
          },
          {
            "ref": "get_conversation",
            "name": "Get Cursor Agent Conversation",
            "type": "connector_action",
            "parameters": {
              "args": "{{ lastOutputOf('validate') }}",
              "action": "get-agent-conversation",
              "timeout": 30000,
              "connector": "cursor",
              "failOnNon2xx": true
            }
          },
          {
            "ref": "extract_body",
            "name": "Extract Response Body",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const resp = ctx.input || {};\n  return resp.body ?? resp;\n}\n",
              "timeout": 3000
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end",
            "parameters": {
              "output": "{{ lastOutputOf('extract_body') }}"
            }
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
  }
