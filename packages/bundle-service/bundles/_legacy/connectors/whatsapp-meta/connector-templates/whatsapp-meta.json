{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "whatsapp-meta",
    "fromSlug": "whatsapp-meta",
    "fromId": "W2nATIXhxRdOvbPNqBxsR"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "W2nATIXhxRdOvbPNqBxsR",
      "slug": "whatsapp-meta",
      "provider": "whatsapp-meta",
      "name": "WhatsApp Business (Meta)",
      "description": "WhatsApp Business Cloud API connector for sending messages, templates, and managing conversations via Meta's official AP",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "connector",
      "baseUrl": "https://graph.facebook.com/v18.0",
      "auth": {
        "type": "api_key",
        "apiKeyRef": {
          "key": "WHATSAPP_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        }
      },
      "metadataSchema": {
        "type": "object",
        "required": [
          "phoneNumberId"
        ],
        "properties": {
          "phoneNumberId": {
            "type": "string",
            "title": "WhatsApp Phone Number ID",
            "pattern": "^[0-9]+$",
            "minLength": 10,
            "description": "Your WhatsApp Business phone number ID from Meta Business Suite (found in WhatsApp Manager > Phone Numbers)"
          }
        }
      }
    },
    "actions": [
      {
        "name": "send-message",
        "description": "Send a text or media message (image, video, document, audio) to a WhatsApp user",
        "method": "POST",
        "path": "/{phoneNumberId}/messages",
        "mapping": {
          "body": {
            "to": "{{ String(args.to) }}",
            "text": "{{ args.text }}",
            "type": "{{ String(args.type || 'text') }}",
            "audio": "{{ args.audio }}",
            "image": "{{ args.image }}",
            "video": "{{ args.video }}",
            "document": "{{ args.document }}",
            "recipient_type": "individual",
            "messaging_product": "whatsapp"
          },
          "path": {
            "phoneNumberId": "{{ String(args.phoneNumberId) }}"
          }
        }
      },
      {
        "name": "send-template",
        "description": "Send a pre-approved WhatsApp message template for notifications and business updates",
        "method": "POST",
        "path": "/{phoneNumberId}/messages",
        "mapping": {
          "body": {
            "to": "{{ String(args.to) }}",
            "type": "template",
            "template": "{{ args.template }}",
            "messaging_product": "whatsapp"
          },
          "path": {
            "phoneNumberId": "{{ String(args.phoneNumberId) }}"
          }
        }
      },
      {
        "name": "get-media",
        "description": "Retrieve media URL and metadata by media ID from WhatsApp",
        "method": "GET",
        "path": "/{mediaId}",
        "mapping": {
          "path": {
            "mediaId": "{{ String(args.mediaId) }}"
          }
        }
      },
      {
        "name": "mark-read",
        "description": "Mark an incoming WhatsApp message as read to improve customer experience",
        "method": "POST",
        "path": "/{phoneNumberId}/messages",
        "mapping": {
          "body": {
            "status": "read",
            "message_id": "{{ String(args.messageId) }}",
            "messaging_product": "whatsapp"
          },
          "path": {
            "phoneNumberId": "{{ String(args.phoneNumberId) }}"
          }
        }
      }
    ]
  }
}
