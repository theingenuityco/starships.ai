{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "slack",
    "fromSlug": "slack-2",
    "fromId": "vX1OW27rtW3rQyrz6cHen"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "vX1OW27rtW3rQyrz6cHen",
      "slug": "slack-2",
      "provider": "slack",
      "name": "Slack",
      "description": "Connect to Slack's Web API to send messages, manage conversations, list channels and users, and automate workspace inter",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "connector",
      "baseUrl": "https://slack.com/api",
      "auth": {
        "type": "oauth2",
        "scopes": [
          "chat:write",
          "channels:read",
          "users:read",
          "conversations:read",
          "groups:read",
          "im:read"
        ],
        "tokenUrl": "https://slack.com/api/oauth.v2.access",
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        },
        "clientIdRef": {
          "key": "SLACK_CLIENT_ID",
          "type": "platform_secret"
        },
        "tokenResponse": {
          "scopeField": "scope",
          "expiresInField": "expires_in",
          "tokenTypeField": "token_type",
          "accessTokenField": "access_token",
          "refreshTokenField": "refresh_token"
        },
        "accessTokenRef": {
          "key": "SLACK_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "scopeDelimiter": " ",
        "clientSecretRef": {
          "key": "SLACK_CLIENT_SECRET",
          "type": "platform_secret"
        },
        "refreshTokenRef": {
          "key": "SLACK_REFRESH_TOKEN",
          "type": "connector_secret"
        },
        "authorizationUrl": "https://slack.com/oauth_authorize",
        "extraAuthorizeParams": {}
      },
      "rateLimit": {
        "burstLimit": 10,
        "requestsPerMinute": 60
      },
      "metadataSchema": {
        "type": "object",
        "required": [],
        "properties": {
          "team_id": {
            "type": "string",
            "description": "Optional Slack team/workspace ID."
          },
          "workspace_name": {
            "type": "string",
            "description": "Optional workspace name for reference."
          }
        },
        "additionalProperties": false
      }
    },
    "actions": [
      {
        "name": "channels-list",
        "description": "List all public channels in the workspace",
        "method": "GET",
        "path": "/channels.list",
        "parameters": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "number",
              "description": "Maximum number of channels to return"
            },
            "cursor": {
              "type": "string",
              "description": "Pagination cursor"
            }
          }
        },
        "mapping": {
          "query": {
            "limit": "{{ String(args.limit || 100) }}",
            "cursor": "{{ String(args.cursor || '') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "auth-test",
        "description": "Test the Slack API authentication and get authenticated user/team information",
        "method": "GET",
        "path": "/auth.test",
        "timeoutMs": 15000
      },
      {
        "name": "chat-post-message",
        "description": "Send a message to a channel, group, or direct message",
        "method": "POST",
        "path": "/chat.postMessage",
        "requestStyle": "json",
        "parameters": {
          "type": "object",
          "required": [
            "channel",
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "description": "Message text to send"
            },
            "blocks": {
              "type": "array",
              "description": "Optional rich formatting with Block Kit"
            },
            "channel": {
              "type": "string",
              "description": "Channel ID, channel name, or user ID"
            },
            "thread_ts": {
              "type": "string",
              "description": "Optional thread timestamp to reply in thread"
            }
          }
        },
        "mapping": {
          "body": {
            "text": "{{ String(args.text) }}",
            "blocks": "{{ args.blocks || undefined }}",
            "channel": "{{ String(args.channel) }}",
            "thread_ts": "{{ String(args.thread_ts || '') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "conversations-history",
        "description": "Fetch message history for a conversation (channel, group, or DM)",
        "method": "GET",
        "path": "/conversations.history",
        "parameters": {
          "type": "object",
          "required": [
            "channel"
          ],
          "properties": {
            "limit": {
              "type": "number",
              "description": "Number of messages to return (1-100)"
            },
            "cursor": {
              "type": "string",
              "description": "Pagination cursor"
            },
            "channel": {
              "type": "string",
              "description": "Conversation ID to fetch history from"
            }
          }
        },
        "mapping": {
          "query": {
            "limit": "{{ String(args.limit || 50) }}",
            "cursor": "{{ String(args.cursor || '') }}",
            "channel": "{{ String(args.channel) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "users-info",
        "description": "Get detailed information about a specific user",
        "method": "GET",
        "path": "/users.info",
        "parameters": {
          "type": "object",
          "required": [
            "user"
          ],
          "properties": {
            "user": {
              "type": "string",
              "description": "User ID to get information for"
            }
          }
        },
        "mapping": {
          "query": {
            "user": "{{ String(args.user) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "conversations-list",
        "description": "List all conversations (channels, groups, DMs) in the workspace",
        "method": "GET",
        "path": "/conversations.list",
        "parameters": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "number",
              "description": "Maximum number of conversations to return (1-1000)"
            },
            "types": {
              "type": "string",
              "description": "Comma-separated types: public_channel,private_channel,mpim,im"
            },
            "cursor": {
              "type": "string",
              "description": "Pagination cursor for next set of results"
            }
          }
        },
        "mapping": {
          "query": {
            "limit": "{{ String(args.limit || 100) }}",
            "types": "{{ String(args.types || 'public_channel,private_channel,mpim,im') }}",
            "cursor": "{{ String(args.cursor || '') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "users-list",
        "description": "List all users in the workspace",
        "method": "GET",
        "path": "/users.list",
        "parameters": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "number",
              "description": "Maximum number of users to return (1-1000)"
            },
            "cursor": {
              "type": "string",
              "description": "Pagination cursor"
            }
          }
        },
        "mapping": {
          "query": {
            "limit": "{{ String(args.limit || 100) }}",
            "cursor": "{{ String(args.cursor || '') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "channels-info",
        "description": "Get detailed information about a specific channel",
        "method": "GET",
        "path": "/channels.info",
        "parameters": {
          "type": "object",
          "required": [
            "channel"
          ],
          "properties": {
            "channel": {
              "type": "string",
              "description": "Channel ID to get information for"
            }
          }
        },
        "mapping": {
          "query": {
            "channel": "{{ String(args.channel) }}"
          }
        },
        "timeoutMs": 15000
      }
    ]
  }
}
