          "type": "connector_secret"
        },
        "scopeDelimiter": ",",
        "clientSecretRef": {
          "key": "INSTAGRAM_CLIENT_SECRET",
          "type": "platform_secret"
        },
        "authorizationUrl": "https://api.instagram.com/oauth/authorize"
      },
      "variables": [],
