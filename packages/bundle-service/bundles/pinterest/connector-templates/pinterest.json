            },
            "title": {
              "type": "string",
              "description": "Updated Pin title"
            },
            "altText": {
              "type": "string",
              "description": "Updated alt text for accessibility"
            },
            "boardId": {
              "type": "string",
              "description": "Move Pin to a different board"
            },
            "description": {
              "type": "string",
