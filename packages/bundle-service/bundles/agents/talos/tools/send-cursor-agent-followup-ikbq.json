  "payload": {
    "tool": {
      "name": "Send Cursor Agent Followup",
      "description": "Add follow-up instructions to an existing Cursor cloud agent. If the agent is stopped, it will resume running.",
      "parameters": {
        "type": "object",
        "required": [
          "agentId",
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "description": "The follow-up instruction text for the agent"
          },
          "agentId": {
            "type": "string",
            "description": "Unique identifier for the cloud agent (e.g., bc_abc123)"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "add_followup",
            "ref": "start_to_add_followup",
            "from": "start"
          },
          {
            "to": "end",
            "ref": "add_followup_to_end",
            "from": "add_followup"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start",
            "parameters": {}
          },
          {
            "ref": "add_followup",
            "name": "Add Followup to Agent",
            "type": "connector_action",
            "parameters": {
              "args": "{{ ({ id: (input.agentId || ''), prompt: { text: (input.prompt || '') } }) }}",
              "action": "add-followup",
              "timeout": 30000,
              "connector": "cursor",
              "failOnNon2xx": true
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end",
            "parameters": {
              "output": "{{ ((lastOutputOf('add_followup') || {}).body ?? lastOutputOf('add_followup')) }}"
            }
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
  }
