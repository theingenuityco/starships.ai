{
  "schemaVersion": "1",
  "kind": "tool",
  "exportedAt": "2026-05-11T21:17:34.347Z",
  "metadata": {
    "fromSlug": "find-and-replace-in-google-sheet-kz5i"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "tool": {
      "name": "Find and Replace in Google Sheet",
      "description": "Find and replace text values in a Google Sheet using the Google Sheets API",
      "parameters": {
        "type": "object",
        "required": [
          "spreadsheetId",
          "find",
          "replacement"
        ],
        "properties": {
          "find": {
            "type": "string",
            "description": "Text to find"
          },
          "sheetId": {
            "type": "number",
            "description": "Optional sheet ID to limit search to specific sheet (if not provided, searches entire spreadsheet)"
          },
          "replacement": {
            "type": "string",
            "description": "Text to replace with"
          },
          "spreadsheetId": {
            "type": "string",
            "description": "The ID of the spreadsheet (found in the URL)"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "find_replace",
            "ref": "e1",
            "from": "start"
          },
          {
            "to": "format_response",
            "ref": "e2",
            "from": "find_replace"
          },
          {
            "to": "end",
            "ref": "e3",
            "from": "format_response"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start",
            "parameters": {}
          },
          {
            "ref": "find_replace",
            "name": "Find and Replace",
            "type": "connector_action",
            "parameters": {
              "args": {
                "find": "{{ String(input.find) }}",
                "sheetId": "{{ input.sheetId !== undefined ? Number(input.sheetId) : undefined }}",
                "replacement": "{{ String(input.replacement) }}",
                "spreadsheetId": "{{ String(input.spreadsheetId) }}"
              },
              "action": "find-replace",
              "timeout": 15000,
              "connector": "google-sheets",
              "failOnNon2xx": true
            }
          },
          {
            "ref": "format_response",
            "name": "Format Response",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const resp = ctx.lastOutputOf('find_replace') || {};\n  \n  if (!resp.body) {\n    throw new Error('No response body from Google Sheets API');\n  }\n  \n  const reply = resp.body?.replies?.[0]?.findReplace;\n  \n  return {\n    success: true,\n    occurrencesChanged: reply?.occurrencesChanged || 0,\n    rowsChanged: reply?.rowsChanged || 0,\n    sheetsChanged: reply?.sheetsChanged || 0,\n    valuesChanged: reply?.valuesChanged || 0\n  };\n}"
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end",
            "parameters": {}
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
  }
}
