            "value": "{{ args.value }}",
            "org_id": "{{ args.org_id }}",
            "currency": "{{ args.currency }}",
            "owner_id": "{{ args.owner_id }}",
            "stage_id": "{{ args.stage_id }}",
            "person_id": "{{ args.person_id }}",
            "pipeline_id": "{{ args.pipeline_id }}"
