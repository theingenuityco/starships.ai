  "payload": {
    "tool": {
      "name": "Create Google Drive Folder",
      "description": "Creates a new folder in Google Drive with optional parent folder and description",
      "parameters": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Folder name"
          },
          "description": {
            "type": "string",
            "description": "Optional folder description"
          },
          "parentFolderId": {
            "type": "string",
            "description": "Optional parent folder ID to create the folder inside"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "create_folder",
            "ref": "edge_start_build",
            "from": "start"
          },
          {
            "to": "format_response",
            "ref": "edge_create_format",
            "from": "create_folder"
          },
          {
            "to": "end",
            "ref": "edge_format_end",
            "from": "format_response"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start"
          },
          {
            "ref": "create_folder",
            "name": "Create Folder",
            "type": "connector_action",
            "parameters": {
              "args": "{{ { name: ctx.input.name, parents: ctx.input.parentFolderId ? [ctx.input.parentFolderId] : undefined } }}",
              "action": "create-folder",
              "timeout": 15000,
              "connector": "google_drive"
            }
          },
          {
            "ref": "format_response",
            "name": "Format Response",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const response = ctx.lastOutputOf('create_folder');\n  const body = response.body;\n  return {\n    id: body.id,\n    name: body.name,\n    mimeType: body.mimeType,\n    webViewLink: body.webViewLink\n  };\n}",
              "timeout": 3000
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end"
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
