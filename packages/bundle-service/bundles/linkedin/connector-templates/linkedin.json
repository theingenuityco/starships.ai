          "properties": {
            "text": {
              "type": "string",
              "description": "Comment text content"
            },
            "actor": {
              "type": "string",
              "description": "Actor URN creating the comment (e.g., urn:li:person:abc123 or urn:li:organization:123456)"
            },
            "object": {
              "type": "string",
              "description": "Object URN - typically the activity URN associated with the post (e.g., urn:li:activity:123456)"
            },
            "postUrn": {
              "type": "string",
              "description": "Post URN to comment on (e.g., urn:li:ugcPost:123456 or urn:li:share:123456). Will be URL-encoded automatically when placed in the path."
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "body": {
            "actor": "{{ String(args.actor) }}",
            "object": "{{ String(args.object) }}",
            "message": "{{ ({ text: String(args.text) }) }}"
          },
          "path": {
            "postUrn": "{{ String(args.postUrn) }}"
          },
          "headers": {
            "LinkedIn-Version": "202511",
            "X-Restli-Protocol-Version": "2.0.0"
          }
        }
      },
