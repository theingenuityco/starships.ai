{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "snapchat",
    "fromSlug": "snapchat",
    "fromId": "O6B-iTLDOQrRgthcyhLGj"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "O6B-iTLDOQrRgthcyhLGj",
      "slug": "snapchat",
      "provider": "snapchat",
      "name": "Snapchat Marketing",
      "description": "Snapchat Marketing API connector with OAuth 2.0 authentication. Supports ad creative management, media upload, campaign ",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "social",
      "baseUrl": "https://adsapi.snapchat.com/v1",
      "auth": {
        "type": "oauth2",
        "scopes": [
          "snapchat-marketing-api"
        ],
        "tokenUrl": "https://accounts.snapchat.com/login/oauth2/access_token",
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        },
        "clientIdRef": {
          "key": "SNAPCHAT_OAUTH_CLIENT_ID",
          "type": "platform_secret"
        },
        "tokenResponse": {
          "expiresInField": "expires_in",
          "tokenTypeField": "token_type",
          "accessTokenField": "access_token",
          "refreshTokenField": "refresh_token"
        },
        "accessTokenRef": {
          "key": "SNAPCHAT_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "scopeDelimiter": " ",
        "clientSecretRef": {
          "key": "SNAPCHAT_OAUTH_CLIENT_SECRET",
          "type": "platform_secret"
        },
        "refreshTokenRef": {
          "key": "SNAPCHAT_REFRESH_TOKEN",
          "type": "connector_secret"
        },
        "authorizationUrl": "https://accounts.snapchat.com/login/oauth2/authorize"
      },
      "rateLimit": {
        "burstLimit": 30,
        "requestsPerMinute": 180
      },
      "metadataSchema": {
        "type": "object",
        "required": [],
        "properties": {
          "ad_account_id": {
            "type": "string",
            "description": "Snapchat Ad Account ID for API operations"
          },
          "organization_id": {
            "type": "string",
            "description": "Snapchat Organization ID"
          }
        },
        "additionalProperties": false
      }
    },
    "actions": [
      {
        "name": "create-creative",
        "description": "Create a new Snap Ad creative with media, brand name, and headline",
        "method": "POST",
        "path": "/adaccounts/{ad_account_id}/creatives",
        "mapping": {
          "body": {
            "creatives": [
              {
                "name": "{{ String(args.name) }}",
                "type": "{{ String(args.type || 'SNAP_AD') }}",
                "headline": "{{ String(args.headline) }}",
                "shareable": "{{ Boolean(args.shareable !== false) }}",
                "brand_name": "{{ String(args.brandName) }}",
                "ad_account_id": "{{ String(args.adAccountId) }}",
                "top_snap_media_id": "{{ String(args.mediaId) }}"
              }
            ]
          },
          "path": {
            "ad_account_id": "{{ String(args.adAccountId) }}"
          }
        },
        "timeoutMs": 20000
      },
      {
        "name": "upload-media",
        "description": "Upload media file (image/video) to Snapchat for use in creatives",
        "method": "POST",
        "path": "/media/{media_id}/upload",
        "mapping": {
          "path": {
            "media_id": "{{ String(args.mediaId) }}"
          }
        },
        "timeoutMs": 60000
      },
      {
        "name": "delete-creative",
        "description": "Delete a creative by ID from the ad account",
        "method": "DELETE",
        "path": "/creatives/{creative_id}",
        "mapping": {
          "path": {
            "creative_id": "{{ String(args.creativeId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-creative",
        "description": "Get details of a specific creative by ID",
        "method": "GET",
        "path": "/creatives/{creative_id}",
        "mapping": {
          "path": {
            "creative_id": "{{ String(args.creativeId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list-creatives",
        "description": "List all creatives for an ad account",
        "method": "GET",
        "path": "/adaccounts/{ad_account_id}/creatives",
        "mapping": {
          "path": {
            "ad_account_id": "{{ String(args.adAccountId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-media",
        "description": "Get media details by media ID",
        "method": "GET",
        "path": "/media/{media_id}",
        "mapping": {
          "path": {
            "media_id": "{{ String(args.mediaId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-organizations",
        "description": "Get all organizations associated with the authenticated account",
        "method": "GET",
        "path": "/me/organizations",
        "timeoutMs": 15000
      },
      {
        "name": "get-ad-accounts",
        "description": "Get all ad accounts for an organization",
        "method": "GET",
        "path": "/organizations/{organization_id}/adaccounts",
        "mapping": {
          "path": {
            "organization_id": "{{ String(args.organizationId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-ad-account",
        "description": "Get details of a specific ad account by ID",
        "method": "GET",
        "path": "/adaccounts/{ad_account_id}",
        "mapping": {
          "path": {
            "ad_account_id": "{{ String(args.adAccountId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create-campaign",
        "description": "Create a new advertising campaign",
        "method": "POST",
        "path": "/adaccounts/{ad_account_id}/campaigns",
        "mapping": {
          "body": {
            "campaigns": [
              {
                "name": "{{ String(args.name) }}",
                "status": "{{ String(args.status || 'PAUSED') }}",
                "ad_account_id": "{{ String(args.adAccountId) }}",
                "daily_budget_micro": "{{ Number(args.dailyBudgetMicro) }}"
              }
            ]
          },
          "path": {
            "ad_account_id": "{{ String(args.adAccountId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-campaign",
        "description": "Get details of a specific campaign by ID",
        "method": "GET",
        "path": "/campaigns/{campaign_id}",
        "mapping": {
          "path": {
            "campaign_id": "{{ String(args.campaignId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list-campaigns",
        "description": "List all campaigns for an ad account",
        "method": "GET",
        "path": "/adaccounts/{ad_account_id}/campaigns",
        "mapping": {
          "path": {
            "ad_account_id": "{{ String(args.adAccountId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-campaign-stats",
        "description": "Get performance statistics for a campaign",
        "method": "GET",
        "path": "/campaigns/{campaign_id}/stats",
        "mapping": {
          "path": {
            "campaign_id": "{{ String(args.campaignId) }}"
          },
          "query": {
            "end_time": "{{ String(args.endTime) }}",
            "start_time": "{{ String(args.startTime) }}",
            "granularity": "{{ String(args.granularity || 'DAY') }}"
          }
        },
        "timeoutMs": 20000
      },
      {
        "name": "get-creative-stats",
        "description": "Get performance statistics for a creative",
        "method": "GET",
        "path": "/creatives/{creative_id}/stats",
        "mapping": {
          "path": {
            "creative_id": "{{ String(args.creativeId) }}"
          },
          "query": {
            "end_time": "{{ String(args.endTime) }}",
            "start_time": "{{ String(args.startTime) }}",
            "granularity": "{{ String(args.granularity || 'DAY') }}"
          }
        },
        "timeoutMs": 20000
      },
      {
        "name": "get-ad-account-stats",
        "description": "Get performance statistics for an ad account",
        "method": "GET",
        "path": "/adaccounts/{ad_account_id}/stats",
        "mapping": {
          "path": {
            "ad_account_id": "{{ String(args.adAccountId) }}"
          },
          "query": {
            "end_time": "{{ String(args.endTime) }}",
            "start_time": "{{ String(args.startTime) }}",
            "granularity": "{{ String(args.granularity || 'DAY') }}"
          }
        },
        "timeoutMs": 20000
      }
    ]
  }
}
