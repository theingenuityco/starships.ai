    "actions": [
      {
        "name": "list_issues",
        "description": "List issues in a repository",
        "method": "GET",
        "path": "/repositories/{workspace}/{repo_slug}/issues",
        "parameters": {
          "type": "object",
          "required": [
            "workspace",
            "repo_slug"
          ],
          "properties": {
            "page": {
              "type": "integer",
              "description": "Page number"
            },
            "state": {
              "enum": [
                "new",
                "on hold",
                "resolved",
                "duplicate",
                "wontfix"
              ],
              "type": "string",
              "description": "Filter by issue state"
            },
            "pagelen": {
              "type": "integer",
              "description": "Number of results per page"
            },
            "repo_slug": {
              "type": "string",
              "description": "Repository slug"
            },
            "workspace": {
              "type": "string",
              "description": "Workspace identifier"
            }
          }
        },
        "mapping": {
          "path": {
            "repo_slug": "{{ String(args.repo_slug) }}",
            "workspace": "{{ String(args.workspace || metadata.workspace) }}"
          },
          "query": {
            "page": "{{ String(args.page || 1) }}",
            "state": "{{ String(args.state || 'new') }}",
            "pagelen": "{{ String(args.pagelen || 10) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_workspace",
        "description": "Get workspace information",
        "method": "GET",
        "path": "/workspaces/{workspace}",
        "parameters": {
          "type": "object",
          "required": [
            "workspace"
          ],
          "properties": {
            "workspace": {
              "type": "string",
              "description": "Workspace identifier"
            }
          }
        },
        "mapping": {
          "path": {
            "workspace": "{{ String(args.workspace || metadata.workspace) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create_issue",
        "description": "Create a new issue in a repository",
        "method": "POST",
        "path": "/repositories/{workspace}/{repo_slug}/issues",
        "parameters": {
          "type": "object",
          "required": [
            "workspace",
            "repo_slug",
            "title"
          ],
          "properties": {
            "state": {
              "type": "string",
              "description": "Issue state"
            },
            "title": {
              "type": "string",
              "description": "Issue title"
            },
            "content": {
              "type": "string",
              "description": "Issue description"
            },
            "priority": {
              "enum": [
                "trivial",
                "minor",
                "major",
                "critical"
              ],
              "type": "string",
              "description": "Issue priority"
            },
            "repo_slug": {
              "type": "string",
              "description": "Repository slug"
            },
            "workspace": {
              "type": "string",
              "description": "Workspace identifier"
            }
          }
        },
        "mapping": {
          "body": {
            "state": "{{ String(args.state || 'new') }}",
            "title": "{{ String(args.title) }}",
            "content": "{{ String(args.content || '') }}",
            "priority": "{{ String(args.priority || 'major') }}"
          },
          "path": {
            "repo_slug": "{{ String(args.repo_slug) }}",
            "workspace": "{{ String(args.workspace || metadata.workspace) }}"
          }
        },
        "timeoutMs": 15000
