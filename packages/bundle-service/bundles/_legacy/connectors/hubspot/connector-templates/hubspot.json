            },
            "closedate": {
              "type": "string",
              "description": "Expected close date (ISO 8601 format)"
            },
            "dealstage": {
              "type": "string",
              "description": "Deal pipeline stage"
            }
          }
        },
        "mapping": {
          "body": {
            "properties": {
              "amount": "{{ String(args.amount) }}",
              "dealname": "{{ String(args.dealname) }}",
              "closedate": "{{ String(args.closedate) }}",
              "dealstage": "{{ String(args.dealstage) }}"
