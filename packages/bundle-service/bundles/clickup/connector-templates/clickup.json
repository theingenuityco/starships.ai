{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "clickup",
    "fromSlug": "clickup",
    "fromId": "dlIOGdxcAPemMRNcnbvxp"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "dlIOGdxcAPemMRNcnbvxp",
      "slug": "clickup",
      "provider": "clickup",
      "name": "ClickUp",
      "description": "ClickUp is a comprehensive project management and collaboration platform. This connector enables integration with ClickU",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "connector",
      "baseUrl": "https://api.clickup.com/api/v2",
      "auth": {
        "type": "oauth2",
        "scopes": [
          "task:read",
          "task:write",
          "list:read",
          "list:write",
          "space:read",
          "space:write",
          "team:read",
          "comment:read",
          "comment:write",
          "time_entry:read",
          "time_entry:write"
        ],
        "tokenUrl": "https://api.clickup.com/api/oauth/token",
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        },
        "clientIdRef": {
          "key": "CLICKUP_OAUTH_CLIENT_ID",
          "type": "platform_secret"
        },
        "tokenResponse": {
          "expiresInField": "expires_in",
          "accessTokenField": "access_token",
          "refreshTokenField": "refresh_token"
        },
        "accessTokenRef": {
          "key": "CLICKUP_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "scopeDelimiter": " ",
        "clientSecretRef": {
          "key": "CLICKUP_OAUTH_CLIENT_SECRET",
          "type": "platform_secret"
        },
        "refreshTokenRef": {
          "key": "CLICKUP_REFRESH_TOKEN",
          "type": "connector_secret"
        },
        "authorizationUrl": "https://app.clickup.com/api/oauth/authorize"
      },
      "rateLimit": {
        "burstLimit": 10,
        "requestsPerMinute": 120
      },
      "metadataSchema": {
        "type": "object",
        "required": [],
        "properties": {
          "workspace_id": {
            "type": "string",
            "description": "Default workspace ID for connector operations (optional)"
          }
        },
        "additionalProperties": false
      }
    },
    "actions": [
      {
        "name": "get_me",
        "description": "Get the current authenticated user's information",
        "method": "GET",
        "path": "/user",
        "timeoutMs": 15000
      },
      {
        "name": "delete_task",
        "description": "Delete a task",
        "method": "DELETE",
        "path": "/task/{task_id}",
        "mapping": {
          "path": {
            "task_id": "{{ String(args.task_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "add_task_comment",
        "description": "Add a comment to a task",
        "method": "POST",
        "path": "/task/{task_id}/comment",
        "mapping": {
          "body": {
            "notify_all": "{{ Boolean(args.notify_all || false) }}",
            "comment_text": "{{ String(args.comment_text) }}"
          },
          "path": {
            "task_id": "{{ String(args.task_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_task_comments",
        "description": "Get all comments on a task",
        "method": "GET",
        "path": "/task/{task_id}/comment",
        "mapping": {
          "path": {
            "task_id": "{{ String(args.task_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "add_task_to_list",
        "description": "Add an existing task to another list (requires Tasks in Multiple Lists ClickApp)",
        "method": "POST",
        "path": "/list/{list_id}/task/{task_id}",
        "mapping": {
          "path": {
            "list_id": "{{ String(args.list_id) }}",
            "task_id": "{{ String(args.task_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_custom_fields",
        "description": "Get custom fields for a list",
        "method": "GET",
        "path": "/list/{list_id}/custom_field",
        "mapping": {
          "path": {
            "list_id": "{{ String(args.list_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "update_task",
        "description": "Update an existing task",
        "method": "PUT",
        "path": "/task/{task_id}",
        "mapping": {
          "body": {
            "name": "{{ String(args.name || undefined) }}",
            "status": "{{ String(args.status || undefined) }}",
            "due_date": "{{ args.due_date || undefined }}",
            "priority": "{{ args.priority || undefined }}",
            "assignees": "{{ args.assignees || undefined }}",
            "description": "{{ String(args.description || undefined) }}",
            "time_estimate": "{{ args.time_estimate || undefined }}"
          },
          "path": {
            "task_id": "{{ String(args.task_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_task",
        "description": "Get a specific task by ID",
        "method": "GET",
        "path": "/task/{task_id}",
        "mapping": {
          "path": {
            "task_id": "{{ String(args.task_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create_task",
        "description": "Create a new task in a list",
        "method": "POST",
        "path": "/list/{list_id}/task",
        "mapping": {
          "body": {
            "name": "{{ String(args.name) }}",
            "tags": "{{ args.tags || [] }}",
            "points": "{{ args.points || null }}",
            "status": "{{ String(args.status || 'to do') }}",
            "due_date": "{{ args.due_date || null }}",
            "priority": "{{ args.priority || null }}",
            "assignees": "{{ args.assignees || [] }}",
            "start_date": "{{ args.start_date || null }}",
            "description": "{{ String(args.description || '') }}",
            "time_estimate": "{{ args.time_estimate || null }}"
          },
          "path": {
            "list_id": "{{ String(args.list_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_tasks",
        "description": "Get all tasks in a list with optional filtering",
        "method": "GET",
        "path": "/list/{list_id}/task",
        "mapping": {
          "path": {
            "list_id": "{{ String(args.list_id) }}"
          },
          "query": {
            "page": "{{ String(args.page || 0) }}",
            "reverse": "{{ String(args.reverse || false) }}",
            "archived": "{{ String(args.archived || false) }}",
            "order_by": "{{ String(args.order_by || 'created') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_folders",
        "description": "Get all folders in a space",
        "method": "GET",
        "path": "/space/{space_id}/folder",
        "mapping": {
          "path": {
            "space_id": "{{ String(args.space_id) }}"
          },
          "query": {
            "archived": "{{ String(args.archived || false) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_space",
        "description": "Get a specific space by ID",
        "method": "GET",
        "path": "/space/{space_id}",
        "mapping": {
          "path": {
            "space_id": "{{ String(args.space_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_folder",
        "description": "Get a specific folder by ID",
        "method": "GET",
        "path": "/folder/{folder_id}",
        "mapping": {
          "path": {
            "folder_id": "{{ String(args.folder_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_workspaces",
        "description": "Get all workspaces (teams) accessible to the authenticated user",
        "method": "GET",
        "path": "/team",
        "timeoutMs": 15000
      },
      {
        "name": "get_workspace",
        "description": "Get a specific workspace by ID",
        "method": "GET",
        "path": "/team/{team_id}",
        "mapping": {
          "path": {
            "team_id": "{{ String(args.team_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_spaces",
        "description": "Get all spaces in a workspace",
        "method": "GET",
        "path": "/team/{team_id}/space",
        "mapping": {
          "path": {
            "team_id": "{{ String(args.team_id) }}"
          },
          "query": {
            "archived": "{{ String(args.archived || false) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_lists",
        "description": "Get all lists in a folder",
        "method": "GET",
        "path": "/folder/{folder_id}/list",
        "mapping": {
          "path": {
            "folder_id": "{{ String(args.folder_id) }}"
          },
          "query": {
            "archived": "{{ String(args.archived || false) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_list",
        "description": "Get a specific list by ID",
        "method": "GET",
        "path": "/list/{list_id}",
        "mapping": {
          "path": {
            "list_id": "{{ String(args.list_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_time_entries",
        "description": "Get time entries for a task",
        "method": "GET",
        "path": "/task/{task_id}/time_entries",
        "mapping": {
          "path": {
            "task_id": "{{ String(args.task_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create_time_entry",
        "description": "Create a time entry for a task",
        "method": "POST",
        "path": "/task/{task_id}/time_entries",
        "mapping": {
          "body": {
            "time": "{{ String(args.time) }}",
            "start": "{{ args.start || null }}",
            "billable": "{{ Boolean(args.billable || false) }}",
            "description": "{{ String(args.description || '') }}"
          },
          "path": {
            "task_id": "{{ String(args.task_id) }}"
          }
        },
        "timeoutMs": 15000
      }
    ]
  }
}
