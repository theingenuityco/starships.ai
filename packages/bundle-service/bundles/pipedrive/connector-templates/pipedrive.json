    "actions": [
      {
        "name": "list-persons",
        "description": "Retrieves all persons with optional filtering by owner, organization, or update time",
        "method": "GET",
        "path": "/persons",
        "parameters": {
          "type": "object",
          "properties": {
            "org_id": {
              "type": "integer",
              "description": "Filter by organization ID"
            },
            "owner_id": {
              "type": "integer",
              "description": "Filter by owner user ID"
            },
            "filter_id": {
              "type": "integer",
              "description": "Use a saved filter"
            }
          }
        },
        "mapping": {
          "query": {
            "org_id": "{{ args.org_id }}",
            "owner_id": "{{ args.owner_id }}",
            "filter_id": "{{ args.filter_id }}"
          }
        },
        "timeoutMs": 15000
      },
