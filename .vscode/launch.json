{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Express Server",
      "type": "node",
      "request": "attach",
      "port": 9230,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/packages/server/**/*.js"],
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
    },
    {
      "name": "Attach to Next.js Server (legacy)",
      "type": "node",
      "request": "attach",
      "port": 9231,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/packages/client/**/*.js"],
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
    },
    {
      "name": "Debug Browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3002",
      "webRoot": "${workspaceFolder}/packages/landing",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./*": "${workspaceFolder}/packages/client/*",
        "webpack:///packages/client/*": "${workspaceFolder}/packages/client/*",
        "webpack:///*": "${workspaceFolder}/*"
      }
    },
    {
      "name": "Launch Express Server with Debug",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/server/node_modules/tsx/dist/cli.mjs",
      "args": ["watch", "src/index.ts"],
      "cwd": "${workspaceFolder}/packages/server",
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**", "**/tsx/**"],
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/server/**",
        "${workspaceFolder}/packages/models/**",
        "${workspaceFolder}/packages/protocol/**",
        "${workspaceFolder}/packages/errors/**",
        "${workspaceFolder}/packages/autopilot/**",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "Launch Landing with Debug",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/landing/node_modules/next/dist/bin/next",
      "args": ["dev", "-p", "3002"],
      "cwd": "${workspaceFolder}/packages/landing",
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/landing/**",
        "${workspaceFolder}/packages/models/**",
        "${workspaceFolder}/packages/protocol/**",
        "${workspaceFolder}/packages/errors/**",
        "!**/node_modules/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Launch Backend Services",
      "configurations": ["Launch Express Server with Debug"],
      "presentation": {
        "hidden": false,
        "group": "backend",
        "order": 1
      },
      "stopAll": true
    },
    {
      "name": "Launch Full Stack",
      "configurations": [
        "Launch Express Server with Debug",
        "Launch Landing with Debug",
        "Debug Browser"
      ],
      "presentation": {
        "hidden": false,
        "group": "starships",
        "order": 2
      },
      "stopAll": true
    },
    {
      "name": "Attach to Running Services",
      "configurations": ["Attach to Express Server", "Attach to Next.js Server (legacy)"],
      "presentation": {
        "hidden": false,
        "group": "debug",
        "order": 3
      }
    }
  ]
}
