{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "monday",
    "fromSlug": "monday",
    "fromId": "Qbl-dHNcdBrnHJWq31niJ"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "Qbl-dHNcdBrnHJWq31niJ",
      "slug": "monday",
      "provider": "monday",
      "name": "Monday.com",
      "description": "Connect to Monday.com Work OS platform to manage boards, items, groups, and automate workflows. Supports OAuth2 authenti",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "connector",
      "baseUrl": "https://api.monday.com",
      "auth": {
        "type": "oauth2",
        "scopes": [
          "boards:read",
          "boards:write",
          "items:read",
          "items:write",
          "users:read"
        ],
        "tokenUrl": "https://auth.monday.com/oauth2/token",
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        },
        "clientIdRef": {
          "key": "MONDAY_OAUTH_CLIENT_ID",
          "type": "platform_secret"
        },
        "accessTokenRef": {
          "key": "MONDAY_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "scopeDelimiter": " ",
        "clientSecretRef": {
          "key": "MONDAY_OAUTH_CLIENT_SECRET",
          "type": "platform_secret"
        },
        "refreshTokenRef": {
          "key": "MONDAY_REFRESH_TOKEN",
          "type": "connector_secret"
        },
        "authorizationUrl": "https://auth.monday.com/oauth2/authorize"
      },
      "rateLimit": {
        "burstLimit": 10,
        "requestsPerMinute": 60
      },
      "metadataSchema": {
        "type": "object",
        "required": [],
        "properties": {
          "workspace": {
            "type": "string",
            "description": "Optional workspace identifier"
          }
        },
        "additionalProperties": false
      }
    },
    "actions": [
      {
        "name": "get-current-user",
        "description": "Get the current authenticated user's profile information",
        "method": "POST",
        "path": "/v2",
        "mapping": {
          "body": {
            "query": "query { me { id name email } }"
          }
        },
        "response": {
          "select": "{{ body.data.me }}"
        },
        "timeoutMs": 15000
      },
      {
        "name": "create-item",
        "description": "Create a new item on a board",
        "method": "POST",
        "path": "/v2",
        "parameters": {
          "type": "object",
          "required": [
            "boardId",
            "itemName"
          ],
          "properties": {
            "boardId": {
              "type": "string",
              "description": "The ID of the board where the item will be created"
            },
            "groupId": {
              "type": "string",
              "description": "Optional group ID where the item will be placed"
            },
            "itemName": {
              "type": "string",
              "description": "The name of the new item"
            },
            "columnValues": {
              "type": "object",
              "description": "Optional column values as a JSON object"
            }
          }
        },
        "mapping": {
          "body": {
            "query": "mutation { create_item (board_id: {{ args.boardId }}, item_name: \"{{ String(args.itemName) }}\", group_id: \"{{ String(args.groupId || '') }}\", column_values: \"{{ JSON.stringify(args.columnValues || {}) }}\") { id name } }"
          }
        },
        "response": {
          "select": "{{ body.data.create_item }}"
        },
        "timeoutMs": 15000
      },
      {
        "name": "update-item",
        "description": "Update an existing item's column values",
        "method": "POST",
        "path": "/v2",
        "parameters": {
          "type": "object",
          "required": [
            "boardId",
            "itemId"
          ],
          "properties": {
            "itemId": {
              "type": "string",
              "description": "The ID of the item to update"
            },
            "boardId": {
              "type": "string",
              "description": "The ID of the board containing the item"
            },
            "columnValues": {
              "type": "object",
              "description": "Column values to update as a JSON object"
            }
          }
        },
        "mapping": {
          "body": {
            "query": "mutation { update_item_column_value (board_id: {{ args.boardId }}, item_id: {{ args.itemId }}, column_id: \"status\", value: \"{{ JSON.stringify(args.columnValues || {}) }}\") { id } }"
          }
        },
        "response": {
          "select": "{{ body.data.update_item_column_value }}"
        },
        "timeoutMs": 15000
      },
      {
        "name": "delete-item",
        "description": "Delete an item from a board",
        "method": "POST",
        "path": "/v2",
        "parameters": {
          "type": "object",
          "required": [
            "itemId"
          ],
          "properties": {
            "itemId": {
              "type": "string",
              "description": "The ID of the item to delete"
            }
          }
        },
        "mapping": {
          "body": {
            "query": "mutation { delete_item (item_id: {{ args.itemId }}) { id } }"
          }
        },
        "response": {
          "select": "{{ body.data.delete_item }}"
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-item-updates",
        "description": "Get updates and comments on a specific item",
        "method": "POST",
        "path": "/v2",
        "parameters": {
          "type": "object",
          "required": [
            "itemId"
          ],
          "properties": {
            "limit": {
              "type": "number",
              "description": "Maximum number of updates to return (default: 25)"
            },
            "itemId": {
              "type": "string",
              "description": "The ID of the item to get updates for"
            }
          }
        },
        "mapping": {
          "body": {
            "query": "query { items (ids: {{ args.itemId }}) { updates (limit: {{ args.limit || 25 }}) { id body created_at creator { id name } } } }"
          }
        },
        "response": {
          "select": "{{ body.data.items[0].updates }}"
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-board",
        "description": "Get details of a specific board including items and groups",
        "method": "POST",
        "path": "/v2",
        "parameters": {
          "type": "object",
          "required": [
            "boardId"
          ],
          "properties": {
            "boardId": {
              "type": "string",
              "description": "The ID of the board to retrieve"
            }
          }
        },
        "mapping": {
          "body": {
            "query": "query { boards (ids: {{ args.boardId }}) { id name description owner { id name } items_page { items { id name } } groups { id title } } }"
          }
        },
        "response": {
          "select": "{{ body.data.boards[0] }}"
        },
        "timeoutMs": 15000
      },
      {
        "name": "add-item-update",
        "description": "Add a comment or update to an item",
        "method": "POST",
        "path": "/v2",
        "parameters": {
          "type": "object",
          "required": [
            "itemId",
            "body"
          ],
          "properties": {
            "body": {
              "type": "string",
              "description": "The update/comment text"
            },
            "itemId": {
              "type": "string",
              "description": "The ID of the item to add an update to"
            }
          }
        },
        "mapping": {
          "body": {
            "query": "mutation { create_update (item_id: {{ args.itemId }}, body: \"{{ String(args.body) }}\") { id body } }"
          }
        },
        "response": {
          "select": "{{ body.data.create_update }}"
        },
        "timeoutMs": 15000
      },
      {
        "name": "list-boards",
        "description": "List all boards accessible to the current user",
        "method": "POST",
        "path": "/v2",
        "parameters": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "number",
              "description": "Maximum number of boards to return (default: 25)"
            }
          }
        },
        "mapping": {
          "body": {
            "query": "query { boards (limit: {{ args.limit || 25 }}) { id name description owner { id name } } }"
          }
        },
        "response": {
          "select": "{{ body.data.boards }}"
        },
        "timeoutMs": 15000
      }
    ]
  }
}
