{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "NODE_ENV",
    "NEO4J_URI",
    "NEO4J_USERNAME",
    "NEO4J_PASSWORD",
    "STRIPE_SECRET_KEY",
    "STRIPE_PUBLISHABLE_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "@starships/protocol#build": {
      "dependsOn": ["@starships/autopilot#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**"]
    },
    "@starships/errors#build": {
      "dependsOn": ["@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.local"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc.*", "eslint.config.*"],
      "outputs": []
    },
    "@starships/client#lint": {
      "dependsOn": ["@starships/env#build", "@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc.*", "eslint.config.*"],
      "outputs": []
    },
    "@starships/server#lint": {
      "dependsOn": [
        "@starships/env#build",
        "@starships/errors#build",
        "@starships/models#build",
        "@starships/protocol#build"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc.*", "eslint.config.*"],
      "outputs": []
    },
    "@starships/errors#lint": {
      "dependsOn": ["@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc.*", "eslint.config.*"],
      "outputs": []
    },
    "@starships/protocol#type-check": {
      "dependsOn": ["@starships/autopilot#build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "@starships/env#type-check": {
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "@starships/models#type-check": {
      "dependsOn": ["@starships/errors#build", "@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "@starships/server#type-check": {
      "dependsOn": [
        "@starships/env#build",
        "@starships/errors#build",
        "@starships/models#build",
        "@starships/protocol#build"
      ],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "@starships/client#type-check": {
      "dependsOn": ["@starships/env#build", "@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "@starships/errors#type-check": {
      "dependsOn": ["@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "type-check": {
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "@starships/models#test": {
      "dependsOn": [
        "@starships/autopilot#build",
        "@starships/errors#build",
        "@starships/protocol#build"
      ],
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "**/*.test.*", "**/__tests__/**"],
      "outputs": []
    },
    "@starships/errors#test": {
      "dependsOn": ["@starships/protocol#build"],
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "**/*.test.*", "**/__tests__/**"],
      "outputs": []
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "**/*.test.*", "**/__tests__/**"],
      "outputs": []
    },
    "clean": {
      "cache": false,
      "outputs": []
    }
  }
}
