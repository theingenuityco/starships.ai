{
  "extends": "../../tsconfig.nodejs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "isolatedModules": true,
    "preserveSymlinks": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
