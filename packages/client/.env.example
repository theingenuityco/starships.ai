# Starships AI Client Environment Variables

# Backend API URL 
# Leave empty for development (uses Next.js proxy)
# NEXT_PUBLIC_API_URL=
# For production, set to your backend URL:
# NEXT_PUBLIC_API_URL=https://api.starships.ai 

# Kinde Authentication Configuration
# Get these values from your Kinde dashboard: https://app.kinde.com

# Your Kinde client ID
KINDE_CLIENT_ID=your_kinde_client_id

# Your Kinde client secret  
KINDE_CLIENT_SECRET=your_kinde_client_secret

# Your Kinde domain (e.g., https://your-subdomain.kinde.com)
KINDE_ISSUER_URL=https://your_subdomain.kinde.com

# The URL of your application
KINDE_SITE_URL=http://localhost:3000

# Where to redirect after successful login
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000

# Where to redirect after logout
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000

# Enable debug mode for development (optional)
KINDE_DEBUG_MODE=true 