{
  "schemaVersion": "1",
  "kind": "tool",
  "exportedAt": "2026-05-11T21:17:34.347Z",
  "metadata": {
    "fromSlug": "batch-update-rows-in-google-sheet-2kcq"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "tool": {
      "name": "Batch Update Rows in Google Sheet",
      "description": "Update multiple ranges in a Google Spreadsheet in a single request using the Google Sheets API",
      "parameters": {
        "type": "object",
        "required": [
          "spreadsheetId",
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "description": "Array of value range objects to update (e.g., [{ range: 'Sheet1!A1:B2', values: [[1,2],[3,4]] }])"
          },
          "spreadsheetId": {
            "type": "string",
            "description": "The ID of the spreadsheet (found in the URL)"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "batch_update",
            "ref": "e1",
            "from": "start"
          },
          {
            "to": "format_response",
            "ref": "e2",
            "from": "batch_update"
          },
          {
            "to": "end",
            "ref": "e3",
            "from": "format_response"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start",
            "parameters": {}
          },
          {
            "ref": "batch_update",
            "name": "Batch Update",
            "type": "connector_action",
            "parameters": {
              "args": {
                "data": "{{ input.data }}",
                "spreadsheetId": "{{ String(input.spreadsheetId) }}"
              },
              "action": "batch-update",
              "timeout": 15000,
              "connector": "google-sheets",
              "failOnNon2xx": true
            }
          },
          {
            "ref": "format_response",
            "name": "Format Response",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const resp = ctx.lastOutputOf('batch_update') || {};\n  \n  if (!resp.body) {\n    throw new Error('No response body from Google Sheets API');\n  }\n  \n  return {\n    success: true,\n    spreadsheetId: resp.body.spreadsheetId,\n    totalUpdatedRows: resp.body.totalUpdatedRows,\n    totalUpdatedColumns: resp.body.totalUpdatedColumns,\n    totalUpdatedCells: resp.body.totalUpdatedCells,\n    responses: resp.body.responses || []\n  };\n}"
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end",
            "parameters": {}
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
  }
}
