      {
        "name": "create_event",
        "description": "Create a new calendar event",
        "method": "POST",
        "path": "/me/events",
        "parameters": {
          "type": "object",
          "required": [
            "subject",
            "start_time",
            "end_time"
          ],
          "properties": {
            "subject": {
              "type": "string",
              "description": "Event subject"
            },
            "end_time": {
              "type": "string",
              "description": "End time in ISO 8601 format"
            },
            "attendees": {
              "type": "array",
              "description": "Array of attendee email addresses"
            },
            "start_time": {
              "type": "string",
              "description": "Start time in ISO 8601 format"
            },
            "description": {
              "type": "string",
              "description": "Event description"
            }
          }
        },
        "mapping": {
          "body": {
            "end": {
              "dateTime": "{{ String(args.end_time) }}",
              "timeZone": "UTC"
            },
            "start": {
              "dateTime": "{{ String(args.start_time) }}",
              "timeZone": "UTC"
            },
            "subject": "{{ String(args.subject) }}",
            "attendees": "{{ args.attendees }}",
