      {
        "name": "get-social-actions",
        "description": "Batch retrieve engagement summaries (like and comment counts) for multiple posts in a single request. Returns aggregated metrics without full comment/like details.",
        "method": "GET",
        "path": "/rest/socialActions",
        "parameters": {
          "type": "object",
          "required": [
            "postUrns"
          ],
          "properties": {
            "postUrns": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Array of post URNs (e.g., ['urn:li:ugcPost:123', 'urn:li:share:456']). Maximum recommended: 100 URNs per request."
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "query": {
