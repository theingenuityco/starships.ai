  "payload": {
    "tool": {
      "name": "Clear Range in Google Sheet",
      "description": "Clear a range in a Google Sheet using the Google Sheets API",
      "parameters": {
        "type": "object",
        "required": [
          "spreadsheetId",
          "range"
        ],
        "properties": {
          "range": {
            "type": "string",
            "description": "The range to clear (e.g., 'Sheet1!A1:Z100')"
          },
          "spreadsheetId": {
            "type": "string",
            "description": "The ID of the spreadsheet (found in the URL)"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "clear_range",
            "ref": "e1",
            "from": "start"
          },
          {
            "to": "format_response",
            "ref": "e2",
            "from": "clear_range"
          },
          {
            "to": "end",
            "ref": "e3",
            "from": "format_response"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start",
            "parameters": {}
          },
          {
            "ref": "clear_range",
            "name": "Clear Range",
            "type": "connector_action",
            "parameters": {
              "args": {
                "range": "{{ String(input.range) }}",
                "spreadsheetId": "{{ String(input.spreadsheetId) }}"
              },
              "action": "clear-range",
              "timeout": 15000,
              "connector": "google-sheets",
              "failOnNon2xx": true
            }
          },
          {
            "ref": "format_response",
            "name": "Format Response",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const resp = ctx.lastOutputOf('clear_range') || {};\n  \n  if (!resp.body) {\n    throw new Error('No response body from Google Sheets API');\n  }\n  \n  return {\n    success: true,\n    spreadsheetId: resp.body.spreadsheetId,\n    clearedRange: resp.body.clearedRange\n  };\n}"
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end",
            "parameters": {}
          }
        ]
