{
  "schemaVersion": "1",
  "kind": "table",
  "exportedAt": "2026-05-26T00:00:00.000Z",
  "metadata": {
    "fromSlug": "tracking",
    "fromStarshipSlug": "starborn-eng"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "table": {
      "name": "Tracking",
      "description": "Tracks each change through the pipeline: issue -> spec -> branch -> PR -> status.",
      "columns": [
        {
          "name": "tracking_id",
          "type": "number",
          "constraints": {
            "unique": true,
            "autoincrement": true
          },
          "description": "Internal id"
        },
        {
          "name": "issue_ref",
          "type": "string",
          "description": "Source issue reference"
        },
        {
          "name": "title",
          "type": "string",
          "constraints": {
            "required": true
          },
          "description": "Change title"
        },
        {
          "name": "repo",
          "type": "string",
          "description": "owner/repo"
        },
        {
          "name": "status",
          "type": "enum",
          "enum": {
            "options": [
              "backlog",
              "scoped",
              "building",
              "in_review",
              "merged",
              "blocked"
            ]
          },
          "constraints": {
            "required": true
          },
          "description": "Pipeline status"
        },
        {
          "name": "spec_doc_slug",
          "type": "string",
          "description": "Slug of the spec doc"
        },
        {
          "name": "branch",
          "type": "string",
          "description": "Working branch"
        },
        {
          "name": "pr_number",
          "type": "number",
          "description": "Pull request number"
        },
        {
          "name": "pr_url",
          "type": "string",
          "description": "Pull request URL"
        },
        {
          "name": "notes",
          "type": "string",
          "description": "Notes"
        },
        {
          "name": "updated_at",
          "type": "datetime",
          "description": "Last update"
        }
      ],
      "primaryKey": "tracking_id"
    },
    "rows": []
  }
}
