          },
          "headers": {
            "LinkedIn-Version": "202511",
            "X-Restli-Protocol-Version": "2.0.0"
          }
        }
      },
      {
        "name": "get-post-analytics",
        "description": "Retrieve analytics for a specific MEMBER post (individual user posts only, NOT organization posts). Supports both modern share URNs (urn:li:share:ID) and legacy UGC post URNs (urn:li:ugcPost:ID). Returns metrics including impressions, members reached, reshares, reactions, and comments.\n\n**Important: MEMBER POSTS ONLY**\n- This endpoint uses the Member Post Analytics API (/rest/memberCreatorPostAnalytics)\n- Only works for posts created by individual members (users)\n- Does NOT work for organization/company page posts\n- For organization post analytics, use get-organization-share-statistics instead\n\n**Requirements:**\n- The authenticated member must own the post\n- Required OAuth scope: r_member_postAnalytics\n- Post analytics typically have a 365-day retention period\n\n**Supported URN Formats:**\n- Modern: urn:li:share:7413389093902106624 (member post)\n- Legacy: urn:li:ugcPost:7413389093902106624 (member UGC post)\n\n**Troubleshooting:**\n- 500 errors typically indicate you don't own the post\n- This endpoint will NOT work for organization posts - use get-organization-share-statistics for those\n- Very old posts (>365 days) may not have analytics available",
        "method": "GET",
        "path": "/rest/memberCreatorPostAnalytics",
        "parameters": {
          "type": "object",
          "required": [
            "postUrn",
            "queryType"
          ],
          "properties": {
            "postUrn": {
              "type": "string",
              "description": "The LinkedIn post URN in plain format (e.g., 'urn:li:share:7413389093902106624' or 'urn:li:ugcPost:7413389093902106624'). The connector will automatically transform this to LinkedIn's REST.li entity parameter format. You must have ownership or admin access to this post to retrieve analytics."
            },
            "queryType": {
              "enum": [
                "IMPRESSION",
                "MEMBERS_REACHED",
                "RESHARE",
                "REACTION",
                "COMMENT"
              ],
              "type": "string",
              "description": "Metric type to retrieve (IMPRESSION, MEMBERS_REACHED, RESHARE, REACTION, or COMMENT)"
            },
            "aggregation": {
              "enum": [
                "DAILY",
                "TOTAL"
              ],
              "type": "string",
              "default": "TOTAL",
              "description": "Aggregation type (DAILY or TOTAL)"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "query": {
            "q": "entity",
            "entity": {
              "value": "{{ args.postUrn.includes('share:') ? '(share:' + encodeURIComponent(args.postUrn) + ')' : '(ugc:' + encodeURIComponent(args.postUrn) + ')' }}",
              "encoding": "none"
            },
            "queryType": "{{ args.queryType }}",
            "aggregation": "{{ args.aggregation || 'TOTAL' }}"
          },
          "headers": {
            "Linkedin-Version": "202511",
            "X-Restli-Protocol-Version": "2.0.0"
          }
        },
        "response": {
          "select": "{{ body.elements }}"
        }
      },
      {
        "name": "get-aggregated-post-analytics",
        "description": "Get aggregated post analytics for authenticated member",
        "method": "GET",
        "path": "/rest/memberCreatorPostAnalytics",
        "parameters": {
          "type": "object",
          "required": [
            "queryType"
          ],
          "properties": {
            "queryType": {
              "enum": [
                "IMPRESSION",
                "MEMBERS_REACHED",
                "RESHARE",
                "REACTION",
                "COMMENT"
              ],
              "type": "string",
              "description": "Metric type"
            },
            "aggregation": {
              "enum": [
                "DAILY",
                "TOTAL"
              ],
              "type": "string",
              "default": "TOTAL",
              "description": "Aggregation type"
            },
            "dateRangeEnd": {
              "type": "object",
              "properties": {
                "day": {
                  "type": "number"
                },
                "year": {
                  "type": "number"
                },
                "month": {
                  "type": "number"
                }
              },
              "description": "End date (year, month, day)"
            },
            "dateRangeStart": {
              "type": "object",
              "properties": {
                "day": {
                  "type": "number"
                },
                "year": {
                  "type": "number"
                },
                "month": {
                  "type": "number"
                }
              },
              "description": "Start date (year, month, day)"
            }
          },
          "additionalProperties": false
        },
        "mapping": {
          "query": {
            "q": "me",
            "dateRange": "{{ args.dateRangeStart ? '(start:(day:' + args.dateRangeStart.day + ',month:' + args.dateRangeStart.month + ',year:' + args.dateRangeStart.year + ')' + (args.dateRangeEnd ? ',end:(day:' + args.dateRangeEnd.day + ',month:' + args.dateRangeEnd.month + ',year:' + args.dateRangeEnd.year + ')' : '') + ')' : '' }}",
            "queryType": "{{ args.queryType }}",
            "aggregation": "{{ args.aggregation || 'TOTAL' }}"
          },
          "headers": {
            "LinkedIn-Version": "202511",
            "X-Restli-Protocol-Version": "2.0.0"
          },
          "queryEncoding": "none"
        }
      },
