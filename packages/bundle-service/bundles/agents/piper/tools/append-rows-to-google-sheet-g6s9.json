  "payload": {
    "tool": {
      "name": "Append Rows to Google Sheet",
      "description": "Append rows to a Google Sheet range using the Google Sheets API",
      "parameters": {
        "type": "object",
        "required": [
          "spreadsheetId",
          "range",
          "values"
        ],
        "properties": {
          "range": {
            "type": "string",
            "description": "The range to append to (e.g., 'Sheet1!A:Z')"
          },
          "values": {
            "type": "array",
            "description": "Array of rows to append, where each row is an array of values"
          },
          "spreadsheetId": {
            "type": "string",
            "description": "The ID of the spreadsheet (found in the URL)"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "append_rows",
            "ref": "e1",
            "from": "start"
          },
          {
            "to": "format_response",
            "ref": "e2",
            "from": "append_rows"
          },
          {
            "to": "end",
            "ref": "e3",
            "from": "format_response"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start",
            "parameters": {}
          },
          {
            "ref": "append_rows",
            "name": "Append Rows",
            "type": "connector_action",
            "parameters": {
              "args": {
                "range": "{{ String(input.range) }}",
                "values": "{{ input.values }}",
                "spreadsheetId": "{{ String(input.spreadsheetId) }}"
              },
              "action": "append-rows",
              "timeout": 15000,
              "connector": "google-sheets",
              "failOnNon2xx": true
            }
          },
          {
            "ref": "format_response",
            "name": "Format Response",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const resp = ctx.lastOutputOf('append_rows') || {};\n  \n  if (!resp.body) {\n    throw new Error('No response body from Google Sheets API');\n  }\n  \n  return {\n    success: true,\n    spreadsheetId: resp.body.spreadsheetId,\n    tableRange: resp.body.tableRange,\n    updates: resp.body.updates\n  };\n}"
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end",
            "parameters": {}
          }
        ]
      },
