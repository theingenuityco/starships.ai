{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "buffer",
    "fromSlug": "buffer",
    "fromId": "wSaxZ8hbRyqLr-wtuB9gF"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "wSaxZ8hbRyqLr-wtuB9gF",
      "slug": "buffer",
      "provider": "buffer",
      "name": "Buffer",
      "description": "Social media scheduling and publishing platform for managing posts across multiple networks.",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "connector",
      "baseUrl": "https://api.bufferapp.com/1",
      "auth": {
        "type": "oauth2",
        "scopes": [
          "posts:read",
          "posts:write",
          "profiles:read",
          "analytics:read"
        ],
        "tokenUrl": "https://api.bufferapp.com/1/oauth2/token.json",
        "injection": {
          "style": "query",
          "queryParamName": "access_token"
        },
        "clientIdRef": {
          "key": "BUFFER_OAUTH_CLIENT_ID",
          "type": "platform_secret"
        },
        "accessTokenRef": {
          "key": "BUFFER_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "scopeDelimiter": " ",
        "clientSecretRef": {
          "key": "BUFFER_OAUTH_CLIENT_SECRET",
          "type": "platform_secret"
        },
        "refreshTokenRef": {
          "key": "BUFFER_REFRESH_TOKEN",
          "type": "connector_secret"
        },
        "authorizationUrl": "https://bufferapp.com/oauth2/authorize"
      },
      "rateLimit": {
        "requestsPerMinute": 100
      }
    },
    "actions": [
      {
        "name": "list_profiles",
        "description": "Get all social media profiles connected to this Buffer account",
        "method": "GET",
        "path": "/profiles.json",
        "timeoutMs": 15000
      },
      {
        "name": "get_profile",
        "description": "Get details for a specific social media profile",
        "method": "GET",
        "path": "/profiles/{id}.json",
        "mapping": {
          "path": {
            "id": "{{ String(args.id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create_post",
        "description": "Create and schedule a new social media post",
        "method": "POST",
        "path": "/updates/create.json",
        "mapping": {
          "query": {
            "text": "{{ String(args.text) }}",
            "media": "{{ args.media || '' }}",
            "profile_ids": "{{ String(args.profile_ids) }}",
            "scheduled_at": "{{ String(args.scheduled_at) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_team_members",
        "description": "Get all team members with access to this Buffer account",
        "method": "GET",
        "path": "/team/members.json",
        "timeoutMs": 15000
      },
      {
        "name": "delete_post",
        "description": "Delete a scheduled post",
        "method": "POST",
        "path": "/updates/{id}/destroy.json",
        "mapping": {
          "path": {
            "id": "{{ String(args.id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "update_post",
        "description": "Update an existing scheduled post",
        "method": "POST",
        "path": "/updates/{id}/update.json",
        "mapping": {
          "path": {
            "id": "{{ String(args.id) }}"
          },
          "query": {
            "text": "{{ String(args.text) }}",
            "scheduled_at": "{{ String(args.scheduled_at) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_post",
        "description": "Get details for a specific post",
        "method": "GET",
        "path": "/updates/{id}.json",
        "mapping": {
          "path": {
            "id": "{{ String(args.id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list_posts",
        "description": "Get all posts for a specific profile",
        "method": "GET",
        "path": "/profiles/{id}/updates/pending.json",
        "mapping": {
          "path": {
            "id": "{{ String(args.profile_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_analytics",
        "description": "Get analytics and engagement metrics for a post",
        "method": "GET",
        "path": "/updates/{id}/interactions.json",
        "mapping": {
          "path": {
            "id": "{{ String(args.id) }}"
          }
        },
        "timeoutMs": 15000
      }
    ]
  }
}
