{
  "schemaVersion": "1",
  "kind": "tool",
  "exportedAt": "2026-05-11T21:17:34.347Z",
  "metadata": {
    "fromSlug": "update-rows-in-google-sheet-xhsx"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "tool": {
      "name": "Update Rows in Google Sheet",
      "description": "Update rows in a Google Sheet range using the Google Sheets API",
      "parameters": {
        "type": "object",
        "required": [
          "spreadsheetId",
          "range",
          "values"
        ],
        "properties": {
          "range": {
            "type": "string",
            "description": "The range to update (e.g., 'Sheet1!A1:Z100')"
          },
          "values": {
            "type": "array",
            "description": "Array of rows to write, where each row is an array of values"
          },
          "spreadsheetId": {
            "type": "string",
            "description": "The ID of the spreadsheet (found in the URL)"
          }
        }
      },
      "blueprint": {
        "edges": [
          {
            "to": "update_rows",
            "ref": "e1",
            "from": "start"
          },
          {
            "to": "format_response",
            "ref": "e2",
            "from": "update_rows"
          },
          {
            "to": "end",
            "ref": "e3",
            "from": "format_response"
          }
        ],
        "nodes": [
          {
            "ref": "start",
            "name": "Start",
            "type": "start",
            "parameters": {}
          },
          {
            "ref": "update_rows",
            "name": "Update Rows",
            "type": "connector_action",
            "parameters": {
              "args": {
                "range": "{{ String(input.range) }}",
                "values": "{{ input.values }}",
                "spreadsheetId": "{{ String(input.spreadsheetId) }}"
              },
              "action": "update-rows",
              "timeout": 15000,
              "connector": "google-sheets",
              "failOnNon2xx": true
            }
          },
          {
            "ref": "format_response",
            "name": "Format Response",
            "type": "code",
            "parameters": {
              "code": "async function main(ctx) {\n  const resp = ctx.lastOutputOf('update_rows') || {};\n  \n  if (!resp.body) {\n    throw new Error('No response body from Google Sheets API');\n  }\n  \n  return {\n    success: true,\n    spreadsheetId: resp.body.spreadsheetId,\n    updatedRange: resp.body.updatedRange,\n    updatedRows: resp.body.updatedRows,\n    updatedColumns: resp.body.updatedColumns,\n    updatedCells: resp.body.updatedCells\n  };\n}"
            }
          },
          {
            "ref": "end",
            "name": "End",
            "type": "end",
            "parameters": {}
          }
        ]
      },
      "transforms": null,
      "mutations": null,
      "condition": null,
      "isEnabled": true,
      "status": "active"
    }
  }
