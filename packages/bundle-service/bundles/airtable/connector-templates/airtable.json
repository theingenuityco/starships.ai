{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "airtable",
    "fromSlug": "airtable",
    "fromId": "jhWYgYUwmsJ3uS-53vl7g"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "jhWYgYUwmsJ3uS-53vl7g",
      "slug": "airtable",
      "provider": "airtable",
      "name": "Airtable",
      "description": "Airtable connector for managing bases, tables, records, and fields. Integrate with Airtable's REST API to create, read, ",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "connector",
      "baseUrl": "https://api.airtable.com/v0",
      "auth": {
        "type": "api_key",
        "apiKeyRef": {
          "key": "AIRTABLE_API_KEY",
          "type": "connector_secret"
        },
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        }
      },
      "rateLimit": {
        "tier": "standard",
        "burstLimit": 30,
        "requestsPerMinute": 300
      },
      "metadataSchema": {
        "type": "object",
        "required": [],
        "properties": {},
        "additionalProperties": false
      }
    },
    "actions": [
      {
        "name": "update-record",
        "description": "Update a record by ID",
        "method": "PATCH",
        "path": "/{baseId}/{tableIdOrName}/{recordId}",
        "mapping": {
          "body": {
            "fields": "{{ args.fields }}"
          },
          "path": {
            "baseId": "{{ String(args.baseId) }}",
            "recordId": "{{ String(args.recordId) }}",
            "tableIdOrName": "{{ String(args.tableIdOrName) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "delete-record",
        "description": "Delete a record by ID",
        "method": "DELETE",
        "path": "/{baseId}/{tableIdOrName}/{recordId}",
        "mapping": {
          "path": {
            "baseId": "{{ String(args.baseId) }}",
            "recordId": "{{ String(args.recordId) }}",
            "tableIdOrName": "{{ String(args.tableIdOrName) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create-record",
        "description": "Create a new record in a table",
        "method": "POST",
        "path": "/{baseId}/{tableIdOrName}",
        "mapping": {
          "body": {
            "records": "{{ args.records }}"
          },
          "path": {
            "baseId": "{{ String(args.baseId) }}",
            "tableIdOrName": "{{ String(args.tableIdOrName) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-record",
        "description": "Get a single record by ID",
        "method": "GET",
        "path": "/{baseId}/{tableIdOrName}/{recordId}",
        "mapping": {
          "path": {
            "baseId": "{{ String(args.baseId) }}",
            "recordId": "{{ String(args.recordId) }}",
            "tableIdOrName": "{{ String(args.tableIdOrName) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-base-schema",
        "description": "Get the schema of tables in a base",
        "method": "GET",
        "path": "/meta/bases/{baseId}/tables",
        "mapping": {
          "path": {
            "baseId": "{{ String(args.baseId) }}"
          },
          "query": {
            "include": "{{ args.include }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "batch-delete-records",
        "description": "Delete multiple records from a table",
        "method": "DELETE",
        "path": "/{baseId}/{tableIdOrName}",
        "mapping": {
          "path": {
            "baseId": "{{ String(args.baseId) }}",
            "tableIdOrName": "{{ String(args.tableIdOrName) }}"
          },
          "query": {
            "records": "{{ args.recordIds }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "batch-update-records",
        "description": "Update multiple records in a table",
        "method": "PATCH",
        "path": "/{baseId}/{tableIdOrName}",
        "mapping": {
          "body": {
            "records": "{{ args.records }}"
          },
          "path": {
            "baseId": "{{ String(args.baseId) }}",
            "tableIdOrName": "{{ String(args.tableIdOrName) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list-records",
        "description": "List records from a table",
        "method": "GET",
        "path": "/{baseId}/{tableIdOrName}",
        "mapping": {
          "path": {
            "baseId": "{{ String(args.baseId) }}",
            "tableIdOrName": "{{ String(args.tableIdOrName) }}"
          },
          "query": {
            "sort": "{{ args.sort }}",
            "fields": "{{ args.fields }}",
            "offset": "{{ String(args.offset) }}",
            "pageSize": "{{ String(args.pageSize || 100) }}",
            "filterByFormula": "{{ String(args.filterByFormula) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create-base",
        "description": "Create a new base with tables and fields",
        "method": "POST",
        "path": "/meta/bases",
        "mapping": {
          "body": {
            "name": "{{ String(args.name) }}",
            "tables": "{{ args.tables }}",
            "workspaceId": "{{ String(args.workspaceId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list-bases",
        "description": "List all bases in a workspace",
        "method": "GET",
        "path": "/meta/bases",
        "timeoutMs": 15000
      }
    ]
  }
}
