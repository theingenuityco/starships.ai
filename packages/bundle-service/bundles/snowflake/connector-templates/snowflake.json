{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "snowflake",
    "fromSlug": "snowflake",
    "fromId": "jv1gJ8bpsAy5b4WKHzDNJ"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "jv1gJ8bpsAy5b4WKHzDNJ",
      "slug": "snowflake",
      "provider": "snowflake",
      "name": "Snowflake",
      "description": "Cloud data warehouse platform for querying, managing, and analyzing data at scale.",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "connector",
      "baseUrl": "https://{{ metadata.account_id }}.snowflakecomputing.com/api/v2",
      "auth": {
        "type": "api_key",
        "apiKeyRef": {
          "key": "SNOWFLAKE_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "injection": {
          "style": "header",
          "headerName": "Authorization",
          "tokenPrefix": "Bearer"
        }
      },
      "rateLimit": {
        "burstLimit": 10,
        "requestsPerMinute": 120
      },
      "metadataSchema": {
        "type": "object",
        "required": [
          "account_id"
        ],
        "properties": {
          "account_id": {
            "type": "string",
            "description": "Snowflake account identifier (org-account format)"
          }
        }
      }
    },
    "actions": [
      {
        "name": "suspend_warehouse",
        "description": "Suspend a compute warehouse",
        "method": "POST",
        "path": "/warehouses/{warehouse_name}/suspend",
        "mapping": {
          "path": {
            "warehouse_name": "{{ String(args.warehouse_name) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_query_result",
        "description": "Retrieve results from a previously executed query",
        "method": "GET",
        "path": "/statements/{statement_handle}",
        "mapping": {
          "path": {
            "statement_handle": "{{ String(args.statement_handle) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list_stages",
        "description": "List data stages for file uploads",
        "method": "GET",
        "path": "/databases/{database_name}/schemas/{schema_name}/stages",
        "mapping": {
          "path": {
            "schema_name": "{{ String(args.schema_name) }}",
            "database_name": "{{ String(args.database_name) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_account_usage",
        "description": "Get account usage metrics and statistics",
        "method": "GET",
        "path": "/organization/accounts/usage",
        "timeoutMs": 15000
      },
      {
        "name": "list_schemas",
        "description": "List schemas in a database",
        "method": "GET",
        "path": "/databases/{database_name}/schemas",
        "mapping": {
          "path": {
            "database_name": "{{ String(args.database_name) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "execute_query",
        "description": "Execute a SQL query and return results",
        "method": "POST",
        "path": "/statements",
        "mapping": {
          "body": {
            "statement": "{{ String(args.statement) }}"
          }
        },
        "timeoutMs": 30000
      },
      {
        "name": "list_databases",
        "description": "List all databases in the account",
        "method": "GET",
        "path": "/databases",
        "timeoutMs": 15000
      },
      {
        "name": "create_warehouse",
        "description": "Create a new compute warehouse",
        "method": "POST",
        "path": "/warehouses",
        "mapping": {
          "body": {
            "name": "{{ String(args.name) }}",
            "warehouse_size": "{{ String(args.warehouse_size || 'XSMALL') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list_tables",
        "description": "List tables in a schema",
        "method": "GET",
        "path": "/databases/{database_name}/schemas/{schema_name}/tables",
        "mapping": {
          "path": {
            "schema_name": "{{ String(args.schema_name) }}",
            "database_name": "{{ String(args.database_name) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "describe_table",
        "description": "Get table structure and column information",
        "method": "GET",
        "path": "/databases/{database_name}/schemas/{schema_name}/tables/{table_name}",
        "mapping": {
          "path": {
            "table_name": "{{ String(args.table_name) }}",
            "schema_name": "{{ String(args.schema_name) }}",
            "database_name": "{{ String(args.database_name) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list_warehouses",
        "description": "List all compute warehouses",
        "method": "GET",
        "path": "/warehouses",
        "timeoutMs": 15000
      }
    ]
  }
}
