# Copy this file to .env and fill values
DISCORD_BOT_TOKEN=
OPEN_WEBUI_BASE_URL=
PORT=4000

# Client-Server Communication
CLIENT_URL=http://localhost:3000

# --- Deployment ----
# Bearer token that GitHub Actions will send with /redeploy webhook
REDEPLOY_SECRET=[REDEPLOY-SECRET]

# OpenAI Configuration
OPENAI_API_KEY=sk-...

# Anthropic Configuration  
ANTHROPIC_API_KEY=sk-ant-...

# LLM Provider Defaults
DEFAULT_LLM_PROVIDER=openai
DEFAULT_CHAT_MODEL=gpt-4


# Neo4j Configuration
NEO4J_URI=[NEO4J-LOCAL-URL]
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=[DEFAULT-PASSWORD]
NEO4J_DATABASE=neo4j

LOG_LEVEL=info

# Kinde Authentication Configuration (used by both server and client)
# Get these values from your Kinde dashboard: https://app.kinde.com
KINDE_CLIENT_ID=your_kinde_client_id
KINDE_CLIENT_SECRET=your_kinde_client_secret
KINDE_ISSUER_URL=https://your_subdomain.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_DEBUG_MODE=true

# Auth Testing Backdoor (for testing without OAuth setup)
# WARNING: Only enable for testing purposes, never in production!
ENABLE_AUTH_TESTING_BACKDOOR=false

# Client-specific Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ENABLE_AUTH_TESTING_BACKDOOR=false

# MCP Agent Executor Configuration
ENABLE_STREAMING_MCP=true              # Enable streaming for MCP tools (default: true)
MCP_EXECUTOR_TIMEOUT=300000            # Overall timeout in ms (default: 5 minutes)
MCP_EXECUTOR_DEBUG=false               # Enable verbose debugging (default: false in production)
MCP_PROGRESS_UPDATES=true              # Show progress during tool execution (default: true)
MCP_CHUNK_SIZE=20                      # Characters per chunk for streaming (default: 20)
MCP_STREAM_DELAY=10                    # Delay between chunks in ms (default: 10)
MCP_SHOW_TOOL_CALLS=false              # Show detailed tool call logs (default: false)

# ============================================
# Stripe Configuration
# ============================================
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Will be set after creating webhook endpoint in Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs - will be populated by setup script
STRIPE_PRICE_CRUISER_MONTHLY=
STRIPE_PRICE_CRUISER_YEARLY=
STRIPE_PRICE_DRAUGHT_MONTHLY=
STRIPE_PRICE_DRAUGHT_YEARLY=