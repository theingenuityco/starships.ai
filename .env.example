# Server and Client Ports
SERVER_PORT=4000
CLIENT_PORT=3000
DOCS_PORT=3001
PROXY_PORT=8080

# URLs
PUBLIC_URL=http://localhost:${PROXY_PORT}
CLIENT_URL=http://localhost:${CLIENT_PORT}
SERVER_URL=http://localhost:${SERVER_PORT}
DOCS_URL=http://localhost:${DOCS_PORT}

# Autopilot Runner Configuration
# Set runner mode to remote so Autopilot uses the HTTP runner service
AUTOPILOT_RUNNER=remote
# Default local runner port (used if RUNNER_URL is not provided)
RUNNER_PORT=50051
# Explicit URL for the runner service
RUNNER_URL=http://localhost:${RUNNER_PORT}
# Optional: bearer token for runner auth (leave empty if auth disabled)
# RUNNER_AUTH_TOKEN=

# OpenAI Configuration
OPENAI_API_KEY=sk-...

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter Configuration
OPENROUTER_API_KEY=sk-or-v1-...

# LLM Provider Defaults
DEFAULT_LLM_PROVIDER=openai
DEFAULT_CHAT_MODEL=gpt-4o


# PostgreSQL Configuration - Works with simple docker run postgres
# To run PostgreSQL: docker run -d --name postgres -p 5432:5432 -e POSTGRES_PASSWORD=password postgres:15
POSTGRES_HOST=localhost  # Required
POSTGRES_PORT=5432  # Required
POSTGRES_USER=postgres  # Required
POSTGRES_PASSWORD=password  # Required
POSTGRES_DATABASE=starships  # Required
POSTGRES_SSL=false  # Optional: set to true for production
# Optional override for fat-container deployments where PostgreSQL runs in the
# same pod as the main application. When set (e.g. "localhost"), the main
# server can connect directly to the in-pod Postgres while external workers
# still use POSTGRES_HOST which should point at the Service DNS.
# POSTGRES_INTERNAL_HOST=localhost

LOG_LEVEL=info

# ============================================
# Redis / Queueing Configuration
# ============================================
# For local development with dockerized Redis:
#   docker run -d --name starships-redis -p 6379:6379 redis:7-alpine
#
# Scheduler and worker processes will use these values to connect.
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional database index (0 by default)
# REDIS_DB=0
# Optional password (if your Redis instance requires auth)
# REDIS_PASSWORD=

# JWT Authentication Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-32-characters-long

# LinkedIn OAuth Configuration (optional, required for LinkedIn connector)
# Create an app at https://www.linkedin.com/developers/apps and copy these values.
LINKEDIN_CLIENT_ID=your-linkedin-app-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-app-client-secret
# Redirect URL is derived from PUBLIC_URL:
#   ${PUBLIC_URL}/api/v1/connectors/linkedin/oauth/callback

# Google Drive OAuth Configuration (optional, required for Google Drive connector)
# Create OAuth credentials in Google Cloud Console (Web application) and copy these values.
GOOGLE_DRIVE_CLIENT_ID=your-google-drive-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-drive-client-secret
# Redirect URL is derived from PUBLIC_URL:
#   ${PUBLIC_URL}/api/v1/connectors/google_drive/oauth/callback

# Discord Bot OAuth Configuration (optional, required for Discord connector)
# Create an application and bot at https://discord.com/developers/applications and copy these values.
DISCORD_CLIENT_ID=your-discord-app-client-id
DISCORD_CLIENT_SECRET=your-discord-app-client-secret
# Bot token for the Discord application (never expose in UI or logs)
DISCORD_BOT_TOKEN=your-discord-bot-token
# Redirect URL is derived from PUBLIC_URL:
#   ${PUBLIC_URL}/api/v1/connectors/discord/oauth/callback

# GitHub OAuth Configuration (optional, used for GitHub login)
# Create an OAuth App at https://github.com/settings/developers and copy these values.
GH_OAUTH_CLIENT_ID=your-github-oauth-client-id
GH_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret
# These must match the callback URLs configured in the GitHub OAuth app settings.
# For local development, you might use:
#   ${PUBLIC_URL}/api/v1/auth/github/callback
#   ${PUBLIC_URL}/api/v1/connectors/github/oauth/callback

# GitHub App Configuration (used for GitHub connector)
# Reuse the GitHub App you created for runners, or create a new one.
GITHUB_APP_ID=your-github-app-id
# Base64-encoded GitHub App private key (same format as github-runners lambda)
GITHUB_APP_PRIVATE_KEY_BASE64=your-github-app-private-key-base64

# Environment Variables Encryption Key
# Used to encrypt/decrypt environment variables stored in the database
# Generate a secure random key: openssl rand -hex 32
ENCRYPTION_KEY=your-secure-encryption-key-64-hex-characters-long-example-key

# Google Analytics Configuration
# Get your Measurement ID from Google Analytics dashboard
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Userback Configuration
# Get your access token from https://userback.io
USERBACK_TOKEN=

# ============================================
# Stripe Configuration
# ============================================
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Will be set after creating webhook endpoint in Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# Email Configuration (AWS SES)
# ============================================
# For local development, get these credentials from your team lead
# In production, these are handled by OIDC role authentication
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=ap-south-1
EMAIL_FROM_ADDRESS=noreply@starships.ai
EMAIL_FROM_NAME=Starships.ai

# ============================================
# AWS S3 Configuration (File Attachments)
# ============================================
# Uses the same AWS credentials as SES above
AWS_S3_BUCKET=starships-dev-attachments
AWS_S3_REGION=ap-south-1

# ============================================
# Sentry Configuration
# ============================================
# Get your DSN from https://sentry.io/settings/projects/
# Client DSN - Used for Next.js server, edge, and client-side error tracking (runtime variable)
SENTRY_DSN_CLIENT=https://your-client-dsn@sentry.io/project-id
# Server DSN - Used for Express backend error tracking (runtime variable)
SENTRY_DSN_SERVER=https://your-server-dsn@sentry.io/project-id