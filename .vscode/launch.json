{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Reverse Proxy",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/packages/reverse-proxy/**/*.js"],
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
    },
    {
      "name": "Attach to Express Server",
      "type": "node",
      "request": "attach",
      "port": 9230,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/packages/server/**/*.js"],
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
    },
    {
      "name": "Attach to Next.js Server",
      "type": "node",
      "request": "attach",
      "port": 9231,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/packages/client/**/*.js"],
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
    },
    {
      "name": "Debug Browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}/packages/client",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./*": "${workspaceFolder}/packages/client/*",
        "webpack:///packages/client/*": "${workspaceFolder}/packages/client/*",
        "webpack:///*": "${workspaceFolder}/*"
      }
    },
    {
      "name": "Launch Reverse Proxy with Debug",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/packages/reverse-proxy",
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMaps": true,
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
    },
    {
      "name": "Launch Express Server with Debug",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/packages/server",
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMaps": true,
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
    },
    {
      "name": "Launch Next.js with Debug",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/client/node_modules/next/dist/bin/next",
      "args": ["dev", "-p", "3000"],
      "cwd": "${workspaceFolder}/packages/client",
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/client/**",
        "${workspaceFolder}/packages/models/**",
        "${workspaceFolder}/packages/protocol/**",
        "${workspaceFolder}/packages/errors/**",
        "!**/node_modules/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Launch Backend Services",
      "configurations": ["Launch Reverse Proxy with Debug", "Launch Express Server with Debug"],
      "presentation": {
        "hidden": false,
        "group": "backend",
        "order": 1
      },
      "stopAll": true
    },
    {
      "name": "Launch Full Stack",
      "configurations": [
        "Launch Reverse Proxy with Debug",
        "Launch Express Server with Debug",
        "Launch Next.js with Debug",
        "Debug Browser"
      ],
      "presentation": {
        "hidden": false,
        "group": "starships",
        "order": 2
      },
      "stopAll": true
    },
    {
      "name": "Attach to Running Services",
      "configurations": ["Attach to Reverse Proxy", "Attach to Express Server", "Attach to Next.js Server"],
      "presentation": {
        "hidden": false,
        "group": "debug",
        "order": 3
      }
    }
  ]
}
