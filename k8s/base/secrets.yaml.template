# Template for Kubernetes secrets
# DO NOT commit actual secrets to version control!
# Copy this file to secrets.yaml and fill in your actual values

apiVersion: v1
kind: Secret
metadata:
  name: starships-secrets
  namespace: starships-ai
type: Opaque
stringData:
  # Neo4j Configuration
  NEO4J_PASSWORD: "your-neo4j-password"
  # For external Neo4j (e.g., Neo4j Aura), uncomment and set:
  # NEO4J_EXTERNAL_URI: "neo4j+s://xxxxx.databases.neo4j.io"
  
  # API Keys
  OPENAI_API_KEY: "your-openai-api-key"
  ANTHROPIC_API_KEY: "your-anthropic-api-key"
  
  # Stripe Configuration
  STRIPE_SECRET_KEY: "your-stripe-secret-key"
  STRIPE_WEBHOOK_SECRET: "your-stripe-webhook-secret"
  STRIPE_PORTAL_ENDPOINT: "your-stripe-portal-endpoint"

---
# Secret for pulling images from GitHub Container Registry
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull-secret
  namespace: starships-ai
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: |
    {
      "auths": {
        "ghcr.io": {
          "username": "YOUR_GITHUB_USERNAME",
          "password": "YOUR_GITHUB_PAT",
          "auth": "BASE64_ENCODED_USERNAME:PAT"
        }
      }
    }