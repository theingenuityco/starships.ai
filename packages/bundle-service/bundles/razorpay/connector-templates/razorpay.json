  "payload": {
    "connectorTemplate": {
      "id": "9gbeR0QtMmEHhVRBsruHP",
      "slug": "razorpay",
      "provider": "razorpay",
      "name": "Razorpay",
      "description": "Razorpay payment gateway connector for processing payments, managing invoices, customers, and settlements.",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "connector",
      "baseUrl": "https://api.razorpay.com/v1",
      "auth": {
        "type": "basic",
        "passwordRef": {
          "key": "RAZORPAY_KEY_SECRET",
          "type": "connector_secret"
        },
        "usernameRef": {
          "key": "RAZORPAY_KEY_ID",
          "type": "connector_secret"
        }
      },
      "rateLimit": {
        "requestsPerMinute": 6000
      },
      "metadataSchema": {
        "type": "object",
        "required": [],
        "properties": {},
        "additionalProperties": false
      }
    },
    "actions": [
      {
        "name": "create_customer",
        "description": "Creates a new customer",
        "method": "POST",
        "path": "/customers",
        "parameters": {
          "type": "object",
          "required": [
            "email"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "Customer name"
            },
            "email": {
              "type": "string",
              "description": "Customer email address"
            },
            "gstin": {
              "type": "string",
              "description": "Customer GSTIN (for India)"
            },
            "notes": {
              "type": "object",
              "description": "Key-value pairs for additional information"
            },
            "contact": {
              "type": "string",
              "description": "Customer contact number"
            }
          }
        },
        "mapping": {
          "body": {
            "name": "{{ String(args.name || '') }}",
            "email": "{{ String(args.email) }}",
            "gstin": "{{ String(args.gstin || '') }}",
            "notes": "{{ args.notes || {} }}",
            "contact": "{{ String(args.contact || '') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list_settlements",
        "description": "Retrieves all settlements made to your bank account with optional filtering and pagination",
        "method": "GET",
        "path": "/settlements",
        "parameters": {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer",
              "description": "The page number of settlements to retrieve"
            },
            "count": {
              "type": "integer",
              "description": "Number of settlements to retrieve per page"
            }
          }
        },
        "mapping": {
          "query": {
            "page": "{{ String(args.page || 1) }}",
            "count": "{{ String(args.count || 10) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list_invoices",
        "description": "Retrieves a list of all invoices with optional filtering and pagination",
        "method": "GET",
        "path": "/invoices",
        "parameters": {
          "type": "object",
          "properties": {
            "to": {
              "type": "string",
              "description": "End date for filtering invoices (YYYY-MM-DD)"
            },
            "from": {
              "type": "string",
              "description": "Start date for filtering invoices (YYYY-MM-DD)"
            },
            "skip": {
              "type": "integer",
              "description": "Number of invoices to skip from the beginning"
            },
            "count": {
              "type": "integer",
              "description": "Number of invoices to retrieve per page"
            }
          }
        },
        "mapping": {
          "query": {
            "to": "{{ String(args.to || '') }}",
            "from": "{{ String(args.from || '') }}",
            "skip": "{{ String(args.skip || 0) }}",
            "count": "{{ String(args.count || 10) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create_invoice",
        "description": "Creates a new invoice",
        "method": "POST",
        "path": "/invoices",
        "parameters": {
          "type": "object",
          "required": [
            "amount",
            "currency"
          ],
          "properties": {
            "notes": {
              "type": "object",
              "description": "Key-value pairs for additional information"
            },
            "amount": {
              "type": "integer",
              "description": "Invoice amount in smallest currency unit"
            },
            "currency": {
              "type": "string",
              "description": "The currency of the invoice"
            },
            "expire_by": {
              "type": "integer",
              "description": "Timestamp after which the invoice will expire"
            },
            "customer_id": {
              "type": "string",
              "description": "The customer ID associated with the invoice"
            },
            "description": {
              "type": "string",
              "description": "Invoice description"
            }
          }
        },
        "mapping": {
          "body": {
            "notes": "{{ args.notes || {} }}",
            "amount": "{{ Number(args.amount) }}",
            "currency": "{{ String(args.currency || 'INR') }}",
            "expire_by": "{{ args.expire_by ? Number(args.expire_by) : undefined }}",
            "customer_id": "{{ String(args.customer_id || '') }}",
            "description": "{{ String(args.description || '') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list_customers",
        "description": "Retrieves a list of all customers with optional filtering and pagination",
        "method": "GET",
        "path": "/customers",
        "parameters": {
          "type": "object",
          "properties": {
            "skip": {
              "type": "integer",
              "description": "Number of customers to skip from the beginning"
            },
            "count": {
              "type": "integer",
              "description": "Number of customers to retrieve per page"
            }
          }
        },
        "mapping": {
          "query": {
            "skip": "{{ String(args.skip || 0) }}",
            "count": "{{ String(args.count || 10) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "capture_payment",
        "description": "Captures an authorized payment to complete the transaction",
        "method": "POST",
        "path": "/payments/{payment_id}/capture",
        "parameters": {
          "type": "object",
          "required": [
            "payment_id",
            "amount"
          ],
          "properties": {
            "amount": {
              "type": "integer",
              "description": "The amount to capture in smallest currency unit (e.g., paisa for INR)"
            },
            "currency": {
              "type": "string",
              "description": "The currency of the amount"
            },
            "payment_id": {
              "type": "string",
              "description": "The unique identifier of the payment to capture"
            }
          }
        },
        "mapping": {
          "body": {
            "amount": "{{ Number(args.amount) }}",
            "currency": "{{ String(args.currency || 'INR') }}"
          },
          "path": {
            "payment_id": "{{ String(args.payment_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_payment",
        "description": "Retrieves details of a specific payment by ID",
        "method": "GET",
        "path": "/payments/{payment_id}",
        "parameters": {
          "type": "object",
          "required": [
            "payment_id"
          ],
          "properties": {
            "payment_id": {
              "type": "string",
              "description": "The unique identifier of the payment"
            }
          }
        },
        "mapping": {
          "path": {
            "payment_id": "{{ String(args.payment_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list_payments",
        "description": "Retrieves a list of all payments made through your Razorpay account with optional filtering and pagination",
        "method": "GET",
        "path": "/payments",
        "parameters": {
          "type": "object",
          "properties": {
            "to": {
              "type": "string",
              "description": "End date for filtering payments (YYYY-MM-DD)"
            },
            "from": {
              "type": "string",
              "description": "Start date for filtering payments (YYYY-MM-DD)"
            },
            "skip": {
              "type": "integer",
              "description": "Number of payments to skip from the beginning"
            },
            "sort": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string",
              "description": "Sort order"
            },
            "count": {
              "type": "integer",
              "description": "Number of payments to retrieve per page"
            },
            "field": {
              "type": "string",
              "description": "Field to sort payments by (e.g., 'created_at')"
            }
          }
        },
        "mapping": {
          "query": {
            "to": "{{ String(args.to || '') }}",
            "from": "{{ String(args.from || '') }}",
            "skip": "{{ String(args.skip || 0) }}",
            "sort": "{{ String(args.sort || 'desc') }}",
            "count": "{{ String(args.count || 10) }}",
            "field": "{{ String(args.field || '') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "refund_payment",
        "description": "Refunds a captured payment",
        "method": "POST",
        "path": "/payments/{payment_id}/refund",
        "parameters": {
          "type": "object",
          "required": [
            "payment_id"
          ],
          "properties": {
            "notes": {
              "type": "object",
              "description": "Key-value pairs for additional information"
            },
            "amount": {
              "type": "integer",
              "description": "Optional refund amount in smallest currency unit. If omitted, full refund is processed"
            },
            "payment_id": {
              "type": "string",
              "description": "The unique identifier of the payment to refund"
            }
          }
        },
        "mapping": {
          "body": {
            "notes": "{{ args.notes || {} }}",
            "amount": "{{ args.amount ? Number(args.amount) : undefined }}"
          },
          "path": {
            "payment_id": "{{ String(args.payment_id) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get_settlement",
        "description": "Retrieves details of a specific settlement by ID",
        "method": "GET",
        "path": "/settlements/{settlement_id}",
        "parameters": {
          "type": "object",
          "required": [
            "settlement_id"
          ],
          "properties": {
            "settlement_id": {
              "type": "string",
              "description": "The unique identifier of the settlement"
            }
          }
        },
        "mapping": {
          "path": {
            "settlement_id": "{{ String(args.settlement_id) }}"
          }
        },
        "timeoutMs": 15000
      }
    ]
  }
}
