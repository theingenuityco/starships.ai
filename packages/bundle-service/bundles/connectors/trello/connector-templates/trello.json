{
  "schemaVersion": "1",
  "kind": "connector_template",
  "exportedAt": "2026-05-13T06:46:43.660Z",
  "metadata": {
    "fromProvider": "trello",
    "fromSlug": "trello",
    "fromId": "4KiVGYntgtxaAG2sSUQHO"
  },
  "source": {
    "app": "starships.ai",
    "version": "0.0.0"
  },
  "payload": {
    "connectorTemplate": {
      "id": "4KiVGYntgtxaAG2sSUQHO",
      "slug": "trello",
      "provider": "trello",
      "name": "Trello",
      "description": "Trello project management connector for managing boards, lists, cards, and members via OAuth2 authentication.",
      "isEnabled": true,
      "version": "1.0.0",
      "category": "project-management",
      "baseUrl": "https://api.trello.com/1",
      "auth": {
        "type": "oauth2",
        "scopes": [
          "read",
          "write"
        ],
        "tokenUrl": "https://api.trello.com/1/oauth/token",
        "injection": {
          "style": "query",
          "queryParamName": "token"
        },
        "clientIdRef": {
          "key": "TRELLO_OAUTH_CLIENT_ID",
          "type": "platform_secret"
        },
        "accessTokenRef": {
          "key": "TRELLO_ACCESS_TOKEN",
          "type": "connector_secret"
        },
        "scopeDelimiter": " ",
        "clientSecretRef": {
          "key": "TRELLO_OAUTH_CLIENT_SECRET",
          "type": "platform_secret"
        },
        "authorizationUrl": "https://trello.com/app-key/authorize"
      },
      "rateLimit": {
        "burstLimit": 10,
        "requestsPerMinute": 300
      }
    },
    "actions": [
      {
        "name": "list-card-members",
        "description": "Get members assigned to a card",
        "method": "GET",
        "path": "/cards/{cardId}/members",
        "parameters": {
          "type": "object",
          "required": [
            "cardId"
          ],
          "properties": {
            "cardId": {
              "type": "string",
              "description": "The ID of the card"
            }
          }
        },
        "mapping": {
          "path": {
            "cardId": "{{ String(args.cardId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list-boards",
        "description": "List all boards for the current member",
        "method": "GET",
        "path": "/members/me/boards",
        "parameters": {
          "type": "object",
          "properties": {
            "filter": {
              "type": "string",
              "default": "open",
              "description": "Filter boards (open, closed, all)"
            }
          }
        },
        "mapping": {
          "query": {
            "filter": "{{ String(args.filter || 'open') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-board",
        "description": "Get a specific board by ID",
        "method": "GET",
        "path": "/boards/{boardId}",
        "parameters": {
          "type": "object",
          "required": [
            "boardId"
          ],
          "properties": {
            "boardId": {
              "type": "string",
              "description": "The ID of the board"
            }
          }
        },
        "mapping": {
          "path": {
            "boardId": "{{ String(args.boardId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "list-board-lists",
        "description": "Get all lists on a board",
        "method": "GET",
        "path": "/boards/{boardId}/lists",
        "parameters": {
          "type": "object",
          "required": [
            "boardId"
          ],
          "properties": {
            "filter": {
              "type": "string",
              "default": "open",
              "description": "Filter lists (open, closed, all)"
            },
            "boardId": {
              "type": "string",
              "description": "The ID of the board"
            }
          }
        },
        "mapping": {
          "path": {
            "boardId": "{{ String(args.boardId) }}"
          },
          "query": {
            "filter": "{{ String(args.filter || 'open') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "update-card",
        "description": "Update a card",
        "method": "PUT",
        "path": "/cards/{cardId}",
        "parameters": {
          "type": "object",
          "required": [
            "cardId"
          ],
          "properties": {
            "due": {
              "type": "string",
              "description": "Due date for the card"
            },
            "desc": {
              "type": "string",
              "description": "The description of the card"
            },
            "name": {
              "type": "string",
              "description": "The name of the card"
            },
            "cardId": {
              "type": "string",
              "description": "The ID of the card"
            },
            "idList": {
              "type": "string",
              "description": "The ID of the list to move the card to"
            }
          }
        },
        "mapping": {
          "body": {
            "due": "{{ args.due ? String(args.due) : null }}",
            "desc": "{{ args.desc ? String(args.desc) : null }}",
            "name": "{{ args.name ? String(args.name) : null }}",
            "idList": "{{ args.idList ? String(args.idList) : null }}"
          },
          "path": {
            "cardId": "{{ String(args.cardId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-card",
        "description": "Get a specific card by ID",
        "method": "GET",
        "path": "/cards/{cardId}",
        "parameters": {
          "type": "object",
          "required": [
            "cardId"
          ],
          "properties": {
            "cardId": {
              "type": "string",
              "description": "The ID of the card"
            }
          }
        },
        "mapping": {
          "path": {
            "cardId": "{{ String(args.cardId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "create-card",
        "description": "Create a new card on a list",
        "method": "POST",
        "path": "/cards",
        "parameters": {
          "type": "object",
          "required": [
            "idList",
            "name"
          ],
          "properties": {
            "due": {
              "type": "string",
              "description": "Due date for the card (ISO 8601)"
            },
            "desc": {
              "type": "string",
              "description": "The description of the card"
            },
            "name": {
              "type": "string",
              "description": "The name of the card"
            },
            "idList": {
              "type": "string",
              "description": "The ID of the list where the card will be created"
            }
          }
        },
        "mapping": {
          "body": {
            "due": "{{ args.due ? String(args.due) : null }}",
            "desc": "{{ String(args.desc || '') }}",
            "name": "{{ String(args.name) }}",
            "idList": "{{ String(args.idList) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "get-member",
        "description": "Get the current authenticated member's information",
        "method": "GET",
        "path": "/members/me",
        "timeoutMs": 15000
      },
      {
        "name": "list-board-cards",
        "description": "Get all cards on a board",
        "method": "GET",
        "path": "/boards/{boardId}/cards",
        "parameters": {
          "type": "object",
          "required": [
            "boardId"
          ],
          "properties": {
            "filter": {
              "type": "string",
              "default": "open",
              "description": "Filter cards (open, closed, all)"
            },
            "boardId": {
              "type": "string",
              "description": "The ID of the board"
            }
          }
        },
        "mapping": {
          "path": {
            "boardId": "{{ String(args.boardId) }}"
          },
          "query": {
            "filter": "{{ String(args.filter || 'open') }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "add-card-member",
        "description": "Add a member to a card",
        "method": "POST",
        "path": "/cards/{cardId}/idMembers",
        "parameters": {
          "type": "object",
          "required": [
            "cardId",
            "idMember"
          ],
          "properties": {
            "cardId": {
              "type": "string",
              "description": "The ID of the card"
            },
            "idMember": {
              "type": "string",
              "description": "The ID of the member to add"
            }
          }
        },
        "mapping": {
          "body": {
            "idMember": "{{ String(args.idMember) }}"
          },
          "path": {
            "cardId": "{{ String(args.cardId) }}"
          }
        },
        "timeoutMs": 15000
      },
      {
        "name": "delete-card",
        "description": "Delete a card",
        "method": "DELETE",
        "path": "/cards/{cardId}",
        "parameters": {
          "type": "object",
          "required": [
            "cardId"
          ],
          "properties": {
            "cardId": {
              "type": "string",
              "description": "The ID of the card to delete"
            }
          }
        },
        "mapping": {
          "path": {
            "cardId": "{{ String(args.cardId) }}"
          }
        },
        "timeoutMs": 15000
      }
    ]
  }
}
